From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] msync from the kernel without an MMU, when configured

UCLIBC_HAS_NOMMU_MSYNC: a no-MMU kernel that implements msync for shared
mappings, as the C33's does, gets the out-of-line cancellation-point
wrapper instead of the generic inline no-op.  Off by default; other
no-MMU configurations keep their behavior.

diff --git a/extra/Configs/Config.in.arch b/extra/Configs/Config.in.arch
index a5fd190..0662b67 100644
--- a/extra/Configs/Config.in.arch
+++ b/extra/Configs/Config.in.arch
@@ -106,6 +106,13 @@ config ARCH_USE_MMU
 
 	  If you're unsure, answer Y.
 
+config UCLIBC_HAS_NOMMU_MSYNC
+	bool "msync without an MMU"
+	depends on !ARCH_USE_MMU
+	help
+	  Use the kernel's msync for shared mappings instead of the no-MMU
+	  inline no-op.  Answer Y only if the kernel implements it.
+
 config UCLIBC_HAS_FLOATS
 	bool "Enable floating point number support"
 	default y
diff --git a/include/sys/mman.h b/include/sys/mman.h
index f7f911e..1f10be1 100644
--- a/include/sys/mman.h
+++ b/include/sys/mman.h
@@ -86,7 +86,7 @@ libc_hidden_proto(munmap)
    (and sets errno).  */
 extern int mprotect (void *__addr, size_t __len, int __prot) __THROW;
 
-#ifdef __ARCH_USE_MMU__
+#if defined __ARCH_USE_MMU__ || defined __UCLIBC_HAS_NOMMU_MSYNC__
 
 /* Synchronize the region starting at ADDR and extending LEN bytes with the
    file it maps.  Filesystem operations on a file being mapped are
