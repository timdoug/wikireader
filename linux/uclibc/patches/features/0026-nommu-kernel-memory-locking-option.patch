From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] memory locking from the kernel without an MMU, when configured

UCLIBC_HAS_NOMMU_MLOCK: a no-MMU kernel that implements locking
validation, limits, per-mm accounting and future mappings, as the C33's
does, gets the real locking syscalls instead of header no-ops, and
MEMLOCK/MEMLOCK_RANGE are advertised when realtime support is enabled.
The MMU memory-protection capability stays withheld.  Off by default;
other no-MMU configurations keep their behavior.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/extra/Configs/Config.in.arch b/extra/Configs/Config.in.arch
index 0662b67..1f81111 100644
--- a/extra/Configs/Config.in.arch
+++ b/extra/Configs/Config.in.arch
@@ -113,6 +113,14 @@ config UCLIBC_HAS_NOMMU_MSYNC
 	  Use the kernel's msync for shared mappings instead of the no-MMU
 	  inline no-op.  Answer Y only if the kernel implements it.
 
+config UCLIBC_HAS_NOMMU_MLOCK
+	bool "Memory locking without an MMU"
+	depends on !ARCH_USE_MMU
+	help
+	  Use the kernel's mlock, munlock, mlockall and munlockall instead of
+	  the no-MMU inline no-ops.  Answer Y only if the kernel implements
+	  them.
+
 config UCLIBC_HAS_FLOATS
 	bool "Enable floating point number support"
 	default y
diff --git a/include/sys/mman.h b/include/sys/mman.h
index 1f10be1..41f28dd 100644
--- a/include/sys/mman.h
+++ b/include/sys/mman.h
@@ -117,7 +117,7 @@ extern int posix_madvise (void *__addr, size_t __len, int __advice) __THROW;
 
 
 #if defined __UCLIBC_HAS_REALTIME__
-# ifdef __ARCH_USE_MMU__
+# if defined __ARCH_USE_MMU__ || defined __UCLIBC_HAS_NOMMU_MLOCK__
 
 /* Guarantee all whole pages mapped by the range [ADDR,ADDR+LEN) to
    be memory resident.  */
diff --git a/libc/sysdeps/linux/common/bits/uClibc_posix_opt.h b/libc/sysdeps/linux/common/bits/uClibc_posix_opt.h
index 6ec7da3..6d5b670 100644
--- a/libc/sysdeps/linux/common/bits/uClibc_posix_opt.h
+++ b/libc/sysdeps/linux/common/bits/uClibc_posix_opt.h
@@ -105,8 +105,12 @@
 #endif
 
 #ifndef __ARCH_USE_MMU__
-# undef _POSIX_MEMLOCK
-# undef _POSIX_MEMLOCK_RANGE
+# if defined __UCLIBC_HAS_NOMMU_MLOCK__ && defined __UCLIBC_HAS_REALTIME__
+/* C33 provides no-MMU memory-lock validation and accounting. */
+# else
+#  undef _POSIX_MEMLOCK
+#  undef _POSIX_MEMLOCK_RANGE
+# endif
 # undef _POSIX_MEMORY_PROTECTION
 #endif
 
diff --git a/libc/sysdeps/linux/common/mlock.c b/libc/sysdeps/linux/common/mlock.c
index 7102e1e..12b5200 100644
--- a/libc/sysdeps/linux/common/mlock.c
+++ b/libc/sysdeps/linux/common/mlock.c
@@ -8,6 +8,6 @@
 
 #include <sys/syscall.h>
 #include <sys/mman.h>
-#if defined __ARCH_USE_MMU__ && defined __NR_mlock
+#if (defined __ARCH_USE_MMU__ || defined __UCLIBC_HAS_NOMMU_MLOCK__) && defined __NR_mlock
 _syscall2(int, mlock, const void *, addr, size_t, len)
 #endif
diff --git a/libc/sysdeps/linux/common/mlockall.c b/libc/sysdeps/linux/common/mlockall.c
index 5512c68..433e976 100644
--- a/libc/sysdeps/linux/common/mlockall.c
+++ b/libc/sysdeps/linux/common/mlockall.c
@@ -8,6 +8,6 @@
 
 #include <sys/syscall.h>
 #include <sys/mman.h>
-#if defined __ARCH_USE_MMU__ && defined __NR_mlockall
+#if (defined __ARCH_USE_MMU__ || defined __UCLIBC_HAS_NOMMU_MLOCK__) && defined __NR_mlockall
 _syscall1(int, mlockall, int, flags)
 #endif
diff --git a/libc/sysdeps/linux/common/munlock.c b/libc/sysdeps/linux/common/munlock.c
index 41a738e..1c6e418 100644
--- a/libc/sysdeps/linux/common/munlock.c
+++ b/libc/sysdeps/linux/common/munlock.c
@@ -8,6 +8,6 @@
 
 #include <sys/syscall.h>
 #include <sys/mman.h>
-#if defined __ARCH_USE_MMU__ && defined __NR_munlock
+#if (defined __ARCH_USE_MMU__ || defined __UCLIBC_HAS_NOMMU_MLOCK__) && defined __NR_munlock
 _syscall2(int, munlock, const void *, addr, size_t, len)
 #endif
diff --git a/libc/sysdeps/linux/common/munlockall.c b/libc/sysdeps/linux/common/munlockall.c
index d8891d8..b1be231 100644
--- a/libc/sysdeps/linux/common/munlockall.c
+++ b/libc/sysdeps/linux/common/munlockall.c
@@ -8,7 +8,7 @@
 
 #include <sys/syscall.h>
 
-#if defined __NR_munlockall && defined __ARCH_USE_MMU__
+#if defined __NR_munlockall && (defined __ARCH_USE_MMU__ || defined __UCLIBC_HAS_NOMMU_MLOCK__)
 #include <sys/mman.h>
 
 _syscall0(int, munlockall)
