From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] c33: FDPIC shared objects with initial-exec TLS in libc

libc's shared objects are FDPIC, and its own thread-local variables use
the initial-exec model, as libc is always loaded with the program.

Signed-off-by: Tim Douglas <me@timdoug.com>

--- a/Rules.mak
+++ b/Rules.mak
@@ -436,6 +436,7 @@
 endif
 
 ifeq ($(TARGET_ARCH),c33)
+	PICFLAG := -mfdpic -fPIC -ftls-model=initial-exec
 	CPU_CFLAGS-y += -mc33pe -mfdpic -mlong-calls
 	CPU_LDFLAGS-y += -mc33pe -mfdpic -mlong-calls
 endif
