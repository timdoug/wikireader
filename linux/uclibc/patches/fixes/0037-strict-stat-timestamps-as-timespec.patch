From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] stat: give strict-standard struct stat timespec timestamps

Under -std=c99 or c11, with neither __USE_MISC nor __USE_XOPEN2K8,
common-generic's struct stat and struct stat64 spelled the timestamps as
int seconds and unsigned int nanoseconds instead of struct timespec.  With
64-bit time on a 32-bit machine that is 12 bytes smaller (104 against 116
on the C33) and every later member is misplaced, so stat() wrote past a
strictly compiled caller's structure: FreeType's FT_Stream_Open, built with
-std=c99, failed its stack protector check.  The fields are now laid out
as struct timespec is, __time_t and unsigned long int, as the common
header and glibc spell them.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/libc/sysdeps/linux/common-generic/bits/stat.h b/libc/sysdeps/linux/common-generic/bits/stat.h
index 045c0f4..7406bc4 100644
--- a/libc/sysdeps/linux/common-generic/bits/stat.h
+++ b/libc/sysdeps/linux/common-generic/bits/stat.h
@@ -61,12 +61,14 @@ struct stat
 # define st_mtime st_mtim.tv_sec
 # define st_ctime st_ctim.tv_sec
 #else
-    int st_atime;				/* Time of last access. */
-    unsigned int st_atime_nsec;
-    int st_mtime;				/* Time of last modification. */
-    unsigned int st_mtime_nsec;
-    int st_ctime;				/* Time of last status change. */
-    unsigned int st_ctime_nsec;
+    /* As struct timespec: with 64-bit time on a 32-bit machine, int
+       seconds made the structure smaller than the one libc fills.  */
+    __time_t st_atime;				/* Time of last access. */
+    unsigned long int st_atime_nsec;
+    __time_t st_mtime;				/* Time of last modification. */
+    unsigned long int st_mtime_nsec;
+    __time_t st_ctime;				/* Time of last status change. */
+    unsigned long int st_ctime_nsec;
 #endif
     unsigned int __uclibc_unused4;
     unsigned int __uclibc_unused5;
@@ -99,12 +101,14 @@ struct stat64
     struct timespec st_mtim; 			/* Time of last modification.  */
     struct timespec st_ctim; 			/* Time of last status change.  */
 # else
-    int st_atime;				/* Time of last access. */
-    unsigned int st_atime_nsec;
-    int st_mtime;				/* Time of last modification. */
-    unsigned int st_mtime_nsec;
-    int st_ctime;				/* Time of last status change. */
-    unsigned int st_ctime_nsec;
+    /* As struct timespec: with 64-bit time on a 32-bit machine, int
+       seconds made the structure smaller than the one libc fills.  */
+    __time_t st_atime;				/* Time of last access. */
+    unsigned long int st_atime_nsec;
+    __time_t st_mtime;				/* Time of last modification. */
+    unsigned long int st_mtime_nsec;
+    __time_t st_ctime;				/* Time of last status change. */
+    unsigned long int st_ctime_nsec;
 # endif
     unsigned int __uclibc_unused4;
     unsigned int __uclibc_unused5;
