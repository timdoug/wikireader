From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] nptl: convert time64 timer outputs to public itimerspec

The kernel uses 64-bit nanosecond fields while libc uses long. Passing
a public output buffer directly corrupts both its contents and adjacent
memory on 32-bit targets. Use kernel-layout temporaries and convert only
after successful syscalls, including the optional timer_settime output.
The conversion is __its_from_its64() in internal/time64_helpers.h.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/include/internal/time64_helpers.h b/include/internal/time64_helpers.h
index e2ed0f3..d09072b 100644
--- a/include/internal/time64_helpers.h
+++ b/include/internal/time64_helpers.h
@@ -32,5 +32,15 @@ struct __its64_struct {
                                                      .value_tv_sec = ((struct itimerspec *)(__its))->it_value.tv_sec, \
                                                      .value_tv_nsec = ((struct itimerspec *)(__its))->it_value.tv_nsec}) : NULL)
 
+/* Copy a kernel time64 itimerspec out to the caller's.  */
+static inline void __its_from_its64(struct itimerspec *__its,
+                                    const struct __its64_struct *__k)
+{
+    __its->it_interval.tv_sec = __k->interval_tv_sec;
+    __its->it_interval.tv_nsec = __k->interval_tv_nsec;
+    __its->it_value.tv_sec = __k->value_tv_sec;
+    __its->it_value.tv_nsec = __k->value_tv_nsec;
+}
+
 
 #endif /* _TIME64_HELPERS_H */
diff --git a/libpthread/nptl/sysdeps/unix/sysv/linux/timer_gettime.c b/libpthread/nptl/sysdeps/unix/sysv/linux/timer_gettime.c
index fccda69..f7f3228 100644
--- a/libpthread/nptl/sysdeps/unix/sysv/linux/timer_gettime.c
+++ b/libpthread/nptl/sysdeps/unix/sysv/linux/timer_gettime.c
@@ -23,6 +23,10 @@
 #include <bits/kernel-features.h>
 #include "kernel-posix-timers.h"
 
+#if defined(__UCLIBC_USE_TIME64__)
+#include "internal/time64_helpers.h"
+#endif
+
 
 #if defined(__NR_timer_gettime) || defined(__NR_timer_gettime64)
 # ifndef __ASSUME_POSIX_TIMERS
@@ -49,9 +53,13 @@ timer_gettime (
     {
       struct timer *kt = (struct timer *) timerid;
 
-      /* Delete the kernel timer object.  */
+      /* Query the kernel timer object.  */
 # if defined(__UCLIBC_USE_TIME64__) && defined(__NR_timer_gettime64)
-      int res = INLINE_SYSCALL (timer_gettime64, 2, kt->ktimerid, value);
+      struct __its64_struct kvalue;
+      int res = INLINE_SYSCALL (timer_gettime64, 2, kt->ktimerid,
+                                value ? &kvalue : NULL);
+      if (res == 0 && value)
+        __its_from_its64 (value, &kvalue);
 # else
       int res = INLINE_SYSCALL (timer_gettime, 2, kt->ktimerid, value);
 # endif
diff --git a/libpthread/nptl/sysdeps/unix/sysv/linux/timer_settime.c b/libpthread/nptl/sysdeps/unix/sysv/linux/timer_settime.c
index fca839d..7d86e17 100644
--- a/libpthread/nptl/sysdeps/unix/sysv/linux/timer_settime.c
+++ b/libpthread/nptl/sysdeps/unix/sysv/linux/timer_settime.c
@@ -56,10 +56,13 @@ timer_settime (
     {
       struct timer *kt = (struct timer *) timerid;
 
-      /* Delete the kernel timer object.  */
+      /* Set the kernel timer object.  */
 # if defined(__UCLIBC_USE_TIME64__) && defined(__NR_timer_settime64)
+      struct __its64_struct kold;
       int res = INLINE_SYSCALL (timer_settime64, 4, kt->ktimerid, flags,
-				TO_ITS64_P(value), ovalue);
+                                TO_ITS64_P(value), ovalue ? &kold : NULL);
+      if (res == 0 && ovalue)
+        __its_from_its64 (ovalue, &kold);
 # else
       int res = INLINE_SYSCALL (timer_settime, 4, kt->ktimerid, flags,
 				value, ovalue);
