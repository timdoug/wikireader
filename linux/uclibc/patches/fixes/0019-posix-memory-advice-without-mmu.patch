From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] expose POSIX memory advice on no-MMU systems

Advanced realtime builds advertise _POSIX_ADVISORY_INFO, so their POSIX
memory-advice declarations, constants and implementation must also exist
without an MMU. The kernel validates ordinary hints against resident VMAs.
For no-MMU DONTNEED, use NORMAL to validate without discarding contents;
the existing MMU behavior remains unchanged.

diff --git a/libc/sysdeps/linux/common/bits/mman-linux.h b/libc/sysdeps/linux/common/bits/mman-linux.h
--- a/libc/sysdeps/linux/common/bits/mman-linux.h
+++ b/libc/sysdeps/linux/common/bits/mman-linux.h
@@ -96,7 +96,9 @@
 #  define MADV_HWPOISON	 100	/* Poison a page for testing.  */
 # endif
 
-/* The POSIX people had to invent similar names for the same things.  */
+#endif /* __ARCH_USE_MMU__ */
+
+/* POSIX advice is also available for resident no-MMU mappings.  */
 # ifdef __USE_XOPEN2K
 #  define POSIX_MADV_NORMAL	0 /* No further special treatment.  */
 #  define POSIX_MADV_RANDOM	1 /* Expect random page references.  */
@@ -104,7 +106,6 @@
 #  define POSIX_MADV_WILLNEED	3 /* Will need these pages.  */
 #  define POSIX_MADV_DONTNEED	4 /* Don't need these pages.  */
 # endif
-#endif
 
 /* Flags for `mlockall'.  */
 #ifndef MCL_CURRENT
diff --git a/include/sys/mman.h b/include/sys/mman.h
--- a/include/sys/mman.h
+++ b/include/sys/mman.h
@@ -109,11 +109,11 @@
    for the region starting at ADDR and extending LEN bytes.  */
 extern int madvise (void *__addr, size_t __len, int __advice) __THROW;
 #endif
+#endif /* __ARCH_USE_MMU__ */
 #if defined __USE_XOPEN2K && defined __UCLIBC_HAS_ADVANCED_REALTIME__
 /* This is the POSIX name for this function.  */
 extern int posix_madvise (void *__addr, size_t __len, int __advice) __THROW;
 #endif
-#endif /* __ARCH_USE_MMU__ */
 
 
 #if defined __UCLIBC_HAS_REALTIME__
diff --git a/libc/sysdeps/linux/common/posix_madvise.c b/libc/sysdeps/linux/common/posix_madvise.c
--- a/libc/sysdeps/linux/common/posix_madvise.c
+++ b/libc/sysdeps/linux/common/posix_madvise.c
@@ -3,7 +3,6 @@
 #include <sys/mman.h>
 #include <sys/syscall.h>
 
-#ifdef __ARCH_USE_MMU__
 #if defined __NR_madvise && defined __USE_XOPEN2K && defined __UCLIBC_HAS_ADVANCED_REALTIME__
 int posix_madvise(void *addr, size_t len, int advice)
 {
@@ -14,8 +13,14 @@
 	 * disk, if this would be necessary.  The POSIX behaviour does not
 	 * allow this.  There is no functionality mapping for the POSIX
 	 * behaviour so far so we ignore that advice for now. */
-	if (advice == POSIX_MADV_DONTNEED)
+	if (advice == POSIX_MADV_DONTNEED) {
+#ifdef __ARCH_USE_MMU__
 		return 0;
+#else
+		/* No paging action is needed, but validate the mapped range. */
+		advice = POSIX_MADV_NORMAL;
+#endif
+	}
 
 	/* this part might use madvise function */
 	INTERNAL_SYSCALL_DECL (err);
@@ -23,4 +28,3 @@
 	return INTERNAL_SYSCALL_ERRNO (result, err);
 }
 #endif
-#endif
