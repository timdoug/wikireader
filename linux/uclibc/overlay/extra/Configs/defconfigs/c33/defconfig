TARGET_c33=y
# FDPIC ELF: executables and shared libraries whose text is shared between
# processes, loaded by ld-uClibc.so (see ldso/ldso/c33).
UCLIBC_FORMAT_FDPIC_ELF=y
HAVE_SHARED=y
# Libraries are in /lib and /usr/lib; there is no ld.so.cache to read.
# LDSO_CACHE_SUPPORT is not set
# Packages can keep private libraries beside their executable using $ORIGIN.
LDSO_RUNPATH=y
# Preserve relative paths in RPATH and LD_LIBRARY_PATH.
# LDSO_SAFE_RUNPATH is not set
# The GNU hash's Bloom filter rejects most modules without comparing a
# name: ld.so looks up hundreds of symbols at every exec.
LDSO_GNU_HASH_SUPPORT=y
# Keep optimization, with DWARF for host-side crash diagnostics. DODEBUG
# would change optimization and runtime behavior as well.
UCLIBC_EXTRA_CFLAGS="-g"
# Buildroot strips debug sections on the card; the sysroot keeps symbols.
# DOSTRIP is not set
# No FPU: floating point is libgcc's soft-float routines. C33 is left out
# of -msoft-float in Rules.mak, as nios2 and bfin are; its compiler has only
# the one float ABI and no such option.
# UCLIBC_HAS_FPU is not set
DO_C99_MATH=y
UCLIBC_HAS_THREADS_NATIVE=y
PTHREADS_STACK_DEFAULT_SIZE=65536
UCLIBC_HAS_IPV6=y
# libstdc++ and many packages need the wide-character functions.
UCLIBC_HAS_WCHAR=y
UCLIBC_HAS_SSP=y
# Without an MMU the canary only catches bugs, and reading /dev/urandom in
# every program would wait for the random pool at boot and cost each exec.
SSP_QUICK_CANARY=y
# What Buildroot's own uClibc-ng configuration offers packages, less
# networking and the context functions, which have no C33 implementation.
UCLIBC_SUSV2_LEGACY=y
UCLIBC_SUSV3_LEGACY=y
UCLIBC_SUSV4_LEGACY=y
DO_XSI_MATH=y
UCLIBC_HAS_FOPEN_EXCLUSIVE_MODE=y
UCLIBC_HAS_FTW=y
UCLIBC_HAS_NFTW=y
UCLIBC_HAS_GETPT=y
UCLIBC_HAS_GLIBC_CUSTOM_STREAMS=y
UCLIBC_HAS_GNU_GLOB=y
UCLIBC_HAS_HEXADECIMAL_FLOATS=y
UCLIBC_HAS_LIBINTL=y
UCLIBC_HAS_LIBNSL_STUB=y
UCLIBC_HAS_LIBRESOLV_STUB=y
UCLIBC_HAS_LIBUTIL=y
UCLIBC_HAS_OBSOLETE_BSD_SIGNAL=y
UCLIBC_HAS_PRINTF_M_SPEC=y
UCLIBC_HAS_PROGRAM_INVOCATION_NAME=y
UCLIBC_HAS_SHA256_CRYPT_IMPL=y
UCLIBC_HAS_SHA512_CRYPT_IMPL=y
UCLIBC_HAS_UTMP=y
UCLIBC_HAS_UTMPX=y
UCLIBC_HAS_WORDEXP=y
