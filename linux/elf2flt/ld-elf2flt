#!/usr/bin/env python3
"""ld for c33-linux-uclibc: the real linker, plus bFLT output on -elf2flt.

This follows the command-line contract of uClinux's elf2flt ld wrapper, which
Buildroot and other no-MMU build systems rely on: "-elf2flt" or
"-elf2flt=OPTIONS" links with the flat layout into OUTPUT.gdb, then converts
that to a bFLT OUTPUT.  The options understood are elf2flt's "-s STACK" and
"--shared-text", which fails the link if any relocation is left in the text,
so that the kernel can share it between processes.  Other final links get
the same layout, which -msep-data needs for __dp, and stay ELF; all of them
keep their relocations (--emit-relocs), so any can be converted later.
Without an MMU neither an executable stack nor a writable, executable
segment means anything, so the linker's warnings about both are turned off.

It is installed as both <prefix>/bin/c33-linux-uclibc-ld and
<prefix>/c33-linux-uclibc/bin/ld; the real linkers sit beside it as *.real.
"""

import os
import subprocess
import sys

TARGET = "c33-linux-uclibc"


def tooldir(self_path):
    here = os.path.dirname(os.path.abspath(self_path))
    if os.path.basename(self_path).startswith(TARGET + "-"):
        return os.path.join(os.path.dirname(here), TARGET)
    return os.path.dirname(here)


def main():
    self_path = sys.argv[0]
    real = os.path.join(os.path.dirname(os.path.abspath(self_path)),
                        os.path.basename(self_path) + ".real")
    tool = tooldir(self_path)
    script = os.path.join(tool, "lib", "elf2flt.ld")
    converter = os.path.join(tool, "lib", "make-flat.py")

    args = []
    flat = None
    output = "a.out"
    partial = False
    has_script = False
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "-elf2flt" or arg.startswith("-elf2flt="):
            flat = arg[len("-elf2flt="):].split() if "=" in arg else []
            i += 1
            continue
        if arg in ("-o", "--output") and i + 1 < len(argv):
            output = argv[i + 1]
            i += 2
            continue
        if arg.startswith("--output="):
            output = arg[len("--output="):]
        elif arg.startswith("-o") and len(arg) > 2 and not arg.startswith("-oformat"):
            output = arg[2:]
        else:
            if arg in ("-r", "-Ur", "-i", "--relocatable"):
                partial = True
            if arg in ("-T", "--script") or arg.startswith("--script=") or \
                    (arg.startswith("-T") and not arg.startswith("-Tt") and
                     not arg.startswith("-Td") and not arg.startswith("-Tb")):
                has_script = True
            args.append(arg)
        i += 1

    if partial:
        os.execv(real, [real] + sys.argv[1:])
    if not has_script:
        args = ["-T", script] + args
    args = ["--emit-relocs", "-z", "noexecstack", "--no-warn-rwx-segments"] + args

    if flat is None:
        os.execv(real, [real] + args + ["-o", output])

    options = []
    j = 0
    while j < len(flat):
        opt = flat[j]
        if opt == "-s" and j + 1 < len(flat):
            options += ["--stack", flat[j + 1]]
            j += 2
            continue
        if opt.startswith("-s"):
            options += ["--stack", opt[2:]]
        elif opt == "--shared-text":
            options.append(opt)
        else:
            sys.exit(f"{os.path.basename(self_path)}: unsupported -elf2flt "
                     f"option {opt}")
        j += 1

    gdb = output + ".gdb"
    status = subprocess.call([real] + args + ["-o", gdb])
    if status:
        sys.exit(status)
    status = subprocess.call([sys.executable, converter, "--quiet"] + options +
                             [gdb, output])
    if status:
        sys.exit(status)
    os.chmod(output, 0o755)


if __name__ == "__main__":
    main()
