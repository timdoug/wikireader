From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] ldso: GNU hash buckets without a divide

A lookup takes its bucket as the hash modulo the bucket count, which a
CPU without a divide instruction does in software, a thousand cycles on
the C33.  With GNU_HASH_RECIPROCAL, each module keeps (2^32-1)/count and
the remainder comes from a multiply.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/ldso/dynlink.c b/ldso/dynlink.c
index dc25b62..95f6ec9 100644
--- a/ldso/dynlink.c
+++ b/ldso/dynlink.c
@@ -81,6 +81,9 @@ struct dso {
 	Sym *syms;
 	Elf_Symndx *hashtab;
 	uint32_t *ghashtab;
+#if GNU_HASH_RECIPROCAL
+	uint32_t ghash_recip;
+#endif
 	int16_t *versym;
 	char *strings;
 	struct dso *syms_next, *lazy_next;
@@ -285,11 +288,25 @@ static Sym *sysv_lookup(const char *s, uint32_t h, struct dso *dso)
 	return 0;
 }
 
+#if GNU_HASH_RECIPROCAL
+/* N % D without a divide, which costs a thousand cycles in software: with
+ * M = (2^32-1)/D, the high word of N*M is N/D or a little less. */
+static uint32_t mod_by_recip(uint32_t n, uint32_t d, uint32_t m)
+{
+	uint32_t r = n - (uint32_t)((uint64_t)n * m >> 32) * d;
+	while (r >= d) r -= d;
+	return r;
+}
+#define GNU_BUCKET(h, nb, dso) mod_by_recip(h, nb, (dso)->ghash_recip)
+#else
+#define GNU_BUCKET(h, nb, dso) ((h) % (nb))
+#endif
+
 static Sym *gnu_lookup(uint32_t h1, uint32_t *hashtab, struct dso *dso, const char *s)
 {
 	uint32_t nbuckets = hashtab[0];
 	uint32_t *buckets = hashtab + 4 + hashtab[2]*(sizeof(size_t)/4);
-	uint32_t i = buckets[h1 % nbuckets];
+	uint32_t i = buckets[GNU_BUCKET(h1, nbuckets, dso)];
 
 	if (!i) return 0;
 
@@ -1061,8 +1078,12 @@ static void decode_dyn(struct dso *p)
 		p->rpath_orig = p->strings + dyn[DT_RUNPATH];
 	if (dyn[0]&(1<<DT_PLTGOT))
 		p->got = laddr(p, dyn[DT_PLTGOT]);
-	if (search_vec(p->dynv, dyn, DT_GNU_HASH))
+	if (search_vec(p->dynv, dyn, DT_GNU_HASH)) {
 		p->ghashtab = laddr(p, *dyn);
+#if GNU_HASH_RECIPROCAL
+		p->ghash_recip = 0xffffffffu / p->ghashtab[0];
+#endif
+	}
 	if (search_vec(p->dynv, dyn, DT_VERSYM))
 		p->versym = laddr(p, *dyn);
 }
