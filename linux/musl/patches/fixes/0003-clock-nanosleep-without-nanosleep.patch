From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] clock_nanosleep: no SYS_nanosleep on time64-only kernels

A kernel built with 64-bit time only, as new 32-bit ports are, has no
nanosleep; clock_nanosleep's time32 fallback would not compile.  Use it
only where the call exists, and clock_nanosleep otherwise.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/src/time/clock_nanosleep.c b/src/time/clock_nanosleep.c
index e195499..be2b614 100644
--- a/src/time/clock_nanosleep.c
+++ b/src/time/clock_nanosleep.c
@@ -19,9 +19,11 @@ int __clock_nanosleep(clockid_t clk, int flags, const struct timespec *req, stru
 		return -r;
 	long long extra = s - CLAMP(s);
 	long ts32[2] = { CLAMP(s), ns };
+#ifdef SYS_nanosleep
 	if (clk == CLOCK_REALTIME && !flags)
 		r = __syscall_cp(SYS_nanosleep, &ts32, &ts32);
 	else
+#endif
 		r = __syscall_cp(SYS_clock_nanosleep, clk, flags, &ts32, &ts32);
 	if (r==-EINTR && rem && !(flags & TIMER_ABSTIME)) {
 		rem->tv_sec = ts32[0] + extra;
@@ -29,8 +31,10 @@ int __clock_nanosleep(clockid_t clk, int flags, const struct timespec *req, stru
 	}
 	return -r;
 #else
+#ifdef SYS_nanosleep
 	if (clk == CLOCK_REALTIME && !flags)
 		return -__syscall_cp(SYS_nanosleep, req, rem);
+#endif
 	return -__syscall_cp(SYS_clock_nanosleep, clk, flags, req, rem);
 #endif
 }
