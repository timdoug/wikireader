From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] wordexp: run the shell through posix_spawn

wordexp forked to run the shell, so it failed with WRDE_NOSPACE wherever
fork cannot work, on every input.  popen and system already run the shell
through posix_spawn; wordexp now does too, with file actions putting the
pipe on standard output and, without WRDE_SHOWERR, /dev/null on standard
error, as the child did by hand.  posix_spawn blocks signals and resets
handlers around the exec itself.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/src/misc/wordexp.c b/src/misc/wordexp.c
--- a/src/misc/wordexp.c
+++ b/src/misc/wordexp.c
@@ -1,5 +1,6 @@
 #include <wordexp.h>
 #include <unistd.h>
+#include <spawn.h>
 #include <stdio.h>
 #include <string.h>
 #include <limits.h>
@@ -36,7 +37,6 @@
 	char **wv = 0;
 	int p[2];
 	pid_t pid;
-	sigset_t set;
 
 	if (flags & WRDE_REUSE) wordfree(we);
 
@@ -101,25 +101,23 @@
 		null = open("/dev/null", O_WRONLY|O_CLOEXEC);
 		if (null < 0) goto nospace;
 	}
-	__block_all_sigs(&set);
-	pid = fork();
-	__restore_sigs(&set);
-	if (pid < 0) {
+	/* The shell runs through posix_spawn, as for popen and system,
+	 * which also works where fork cannot. */
+	posix_spawn_file_actions_t fa;
+	char *argv[] = { "sh", "-c",
+		"eval \"set --;printf %s\\\\\\\\0 x $1\"",
+		"sh", (char *)s, 0 };
+	int e = posix_spawn_file_actions_init(&fa);
+	if (!e) e = posix_spawn_file_actions_adddup2(&fa, p[1], 1);
+	if (!e && null >= 0) e = posix_spawn_file_actions_adddup2(&fa, null, 2);
+	if (!e) e = posix_spawn(&pid, "/bin/sh", &fa, 0, argv, __environ);
+	posix_spawn_file_actions_destroy(&fa);
+	if (e) {
 		close(p[0]);
 		close(p[1]);
-		close(null);
+		if (null >= 0) close(null);
 		goto nospace;
 	}
-	if (!pid) {
-		if (p[1] == 1) fcntl(1, F_SETFD, 0);
-		else dup2(p[1], 1);
-		if (null == 2) fcntl(2, F_SETFD, 0);
-		else dup2(null, 2);
-		execl("/bin/sh", "sh", "-c",
-			"eval \"set --;printf %s\\\\\\\\0 x $1\"",
-			"sh", s, (char *)0);
-		_exit(1);
-	}
 	close(p[1]);
 	close(null);
 	
