From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] stdarg.h: C23's va_start with one argument

C23 makes va_start's second argument optional, and GCC 15 on compiles C
as C23 by default; its own stdarg.h maps va_start(...) to
__builtin_c23_va_start in C23 and C++26.  musl's stdarg.h, which takes
the place of the compiler's, kept only the two-argument macro, so
va_start(ap) does not compile (GCC's execute test pr117432).  Use the
builtin where the compiler has it, and the two-argument form elsewhere.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/include/stdarg.h b/include/stdarg.h
index 3256f80..f87e39f 100644
--- a/include/stdarg.h
+++ b/include/stdarg.h
@@ -9,7 +9,17 @@ extern "C" {
 
 #include <bits/alltypes.h>
 
+#if (defined __STDC_VERSION__ && __STDC_VERSION__ > 201710L) \
+    || (defined __cplusplus && __cplusplus >= 202400L)
+#ifdef __has_builtin
+#if __has_builtin(__builtin_c23_va_start)
+#define va_start(...)   __builtin_c23_va_start(__VA_ARGS__)
+#endif
+#endif
+#endif
+#ifndef va_start
 #define va_start(v,l)   __builtin_va_start(v,l)
+#endif
 #define va_end(v)       __builtin_va_end(v)
 #define va_arg(v,l)     __builtin_va_arg(v,l)
 #define va_copy(d,s)    __builtin_va_copy(d,s)
