diff --git a/drivers/video/backlight/Kconfig b/drivers/video/backlight/Kconfig
index d9374d208..93294e832 100644
--- a/drivers/video/backlight/Kconfig
+++ b/drivers/video/backlight/Kconfig
@@ -90,6 +90,15 @@ config LCD_PLATFORM
 	  This driver provides a platform-device registered LCD power
 	  control interface.
 
+config LCD_WIKIREADER
+	tristate "WikiReader panel contrast"
+	depends on C33 || COMPILE_TEST
+	depends on PWM
+	help
+	  Contrast control for the Openmoko WikiReader panel, whose bias is
+	  a PWM from the S1C33E07 timer block.  Exposes the firmware's 12-bit
+	  contrast number through /sys/class/lcd/wikireader/contrast.
+
 config LCD_HP700
 	tristate "HP Jornada 700 series LCD Driver"
 	depends on SA1100_JORNADA720_SSP && !PREEMPTION
