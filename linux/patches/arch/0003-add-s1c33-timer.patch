From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] clocksource: build the S1C33 timer driver

Kconfig and Makefile entries for the Epson S1C33E07's timers as clock
source and clock event device.  The driver's source is in the port's
overlay.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/drivers/clocksource/Kconfig b/drivers/clocksource/Kconfig
index d9c76dd44..e61f1dd92 100644
--- a/drivers/clocksource/Kconfig
+++ b/drivers/clocksource/Kconfig
@@ -824,4 +824,14 @@ choice
 
 endchoice
 
+config TIMER_S1C33
+	bool "Epson S1C33 16-bit timer block"
+	depends on C33 || COMPILE_TEST
+	select REGMAP_MMIO
+	help
+	  Enables the six-channel 16-bit timer block of the Epson S1C33E07.
+	  Two channels are cascaded into a free-running 32-bit clocksource and
+	  scheduler clock; a third provides the clock event.  The block's
+	  other channels go to child devices, such as the PWM.
+
 endmenu
diff --git a/drivers/clocksource/Makefile b/drivers/clocksource/Makefile
index b46376af6..f50da9a4e 100644
--- a/drivers/clocksource/Makefile
+++ b/drivers/clocksource/Makefile
@@ -96,3 +96,4 @@ obj-$(CONFIG_EP93XX_TIMER)		+= timer-ep93xx.o
 obj-$(CONFIG_RALINK_TIMER)		+= timer-ralink.o
 obj-$(CONFIG_NXP_STM_TIMER)		+= timer-nxp-stm.o
 obj-$(CONFIG_RTK_SYSTIMER)		+= timer-realtek.o
+obj-$(CONFIG_TIMER_S1C33)		+= timer-s1c33.o
