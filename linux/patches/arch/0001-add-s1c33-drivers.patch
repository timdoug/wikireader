From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] drivers: build the S1C33 serial port and WikiReader touchscreen

Kconfig and Makefile entries for the Epson S1C33's serial port and for
the WikiReader's resistive touchscreen, which is attached to a UART and
reports through the input layer by way of serdev.  The drivers' sources
are in the port's overlay.

Signed-off-by: Tim Douglas <me@timdoug.com>

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -10,1 +10,12 @@
+config TOUCHSCREEN_WIKIREADER
+	bool "Openmoko WikiReader touchscreen"
+	depends on (C33_WIKIREADER && SERIAL_S1C33) || (COMPILE_TEST && TTY)
+	select SERIAL_DEV_BUS
+	select SERIAL_DEV_CTRL_TTYPORT
+	help
+	  Enable the UART-attached resistive touchscreen found in the
+	  Openmoko WikiReader. The driver reports absolute coordinates and
+	  contact state through the standard Linux input event interface.
+	  Its serial transport is managed by the kernel serdev bus.
+
 config TOUCHSCREEN_88PM860X
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -10,1 +10,2 @@
+obj-$(CONFIG_TOUCHSCREEN_WIKIREADER)	+= wikireader-touch.o
 obj-$(CONFIG_TOUCHSCREEN_88PM860X)	+= 88pm860x-ts.o
diff --git a/drivers/tty/serial/Kconfig b/drivers/tty/serial/Kconfig
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -14,1 +14,23 @@
+config SERIAL_S1C33
+	bool "Epson S1C33 serial port support"
+	depends on (C33 || COMPILE_TEST) && TTY
+	select SERIAL_CORE
+	help
+	  Enable the asynchronous serial controller found in Epson S1C33
+	  microcontrollers.
+	  The driver uses serial_core and supports tty-backed serdev clients
+	  as well as ordinary terminal devices.
+
+config SERIAL_S1C33_CONSOLE
+	bool "Console on an Epson S1C33 serial port"
+	depends on SERIAL_S1C33=y
+	select SERIAL_CORE_CONSOLE
+	select SERIAL_EARLYCON
+	help
+	  Enable an S1C33 serial port as the system console. The console device
+	  is selected with a kernel command line option such as ttyEP0, and
+	  earlycon=s1c33,mmio,<address> reports before the driver has probed.
+	  Early kernel messages can therefore be observed before userspace
+	  starts on boards with a connected serial adapter.
+
 source "drivers/tty/serial/8250/Kconfig"
diff --git a/drivers/tty/serial/Makefile b/drivers/tty/serial/Makefile
--- a/drivers/tty/serial/Makefile
+++ b/drivers/tty/serial/Makefile
@@ -38,1 +38,2 @@
+obj-$(CONFIG_SERIAL_S1C33)		+= s1c33-uart.o
 obj-$(CONFIG_SERIAL_ALTERA_JTAGUART)	+= altera_jtaguart.o
