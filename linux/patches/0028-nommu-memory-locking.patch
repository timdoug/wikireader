--- /dev/null
+++ b/include/linux/nommu_mlock.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_NOMMU_MLOCK_H
+#define _LINUX_NOMMU_MLOCK_H
+#include <linux/mm_types.h>
+#ifdef CONFIG_NOMMU_MLOCK
+int nommu_mlock_check(struct mm_struct *mm, unsigned long len, vm_flags_t flags);
+int nommu_mlock_range(struct mm_struct *mm, unsigned long start, unsigned long end);
+void nommu_munlock_range(struct mm_struct *mm, unsigned long start, unsigned long end);
+bool nommu_mlock_intersects(struct mm_struct *mm, unsigned long start, unsigned long end);
+void nommu_munlock_all(struct mm_struct *mm);
+#else
+static inline int nommu_mlock_check(struct mm_struct *mm, unsigned long len, vm_flags_t flags) { return 0; }
+static inline int nommu_mlock_range(struct mm_struct *mm, unsigned long start, unsigned long end) { return 0; }
+static inline void nommu_munlock_range(struct mm_struct *mm, unsigned long start, unsigned long end) { }
+static inline bool nommu_mlock_intersects(struct mm_struct *mm, unsigned long start, unsigned long end) { return false; }
+static inline void nommu_munlock_all(struct mm_struct *mm) { }
+#endif
+#endif
