diff --git a/mm/nommu_mlock.c b/mm/nommu_mlock.c
new file mode 100644
--- /dev/null
+++ b/mm/nommu_mlock.c
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* NOMMU RAM is resident already. Track the process's locking contract,
+ * without splitting direct/file mappings or changing physical page refs.
+ * One lazy bitmap covers the low-RAM PFN span (1 KiB on a 32 MiB C33).
+ * All access is serialized by mmap_lock; clear/unmap never allocate. */
+#include <linux/bitmap.h>
+#include <linux/capability.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/nommu_mlock.h>
+#include <linux/sched/signal.h>
+#include <linux/syscalls.h>
+
+static bool ram_range(unsigned long start, unsigned long end,
+		      unsigned long *first, unsigned long *count)
+{
+	unsigned long lo, hi;
+	if (end <= start)
+		return false;
+	lo = max(__pa(start) >> PAGE_SHIFT, min_low_pfn);
+	hi = min((__pa(end - 1) >> PAGE_SHIFT) + 1, max_low_pfn);
+	if (hi <= lo)
+		return false;
+	*first = lo - min_low_pfn;
+	*count = hi - lo;
+	return true;
+}
+
+static unsigned long already_locked(struct mm_struct *mm,
+				    unsigned long first, unsigned long count)
+{
+	unsigned long bit, total = 0, end = first + count;
+	if (mm->nommu_locks)
+		for (bit = find_next_bit(mm->nommu_locks, end, first);
+		     bit < end; bit = find_next_bit(mm->nommu_locks, end, bit + 1))
+			++total;
+	return total;
+}
+
+int nommu_mlock_range(struct mm_struct *mm, unsigned long start, unsigned long end)
+{
+	unsigned long first, count, added, limit = rlimit(RLIMIT_MEMLOCK) >> PAGE_SHIFT;
+	mmap_assert_write_locked(mm);
+	if (!ram_range(start, end, &first, &count))
+		return 0;
+	added = count - already_locked(mm, first, count);
+	if (!capable(CAP_IPC_LOCK) &&
+	    (mm->locked_vm > limit || added > limit - mm->locked_vm))
+		return -ENOMEM;
+	if (!mm->nommu_locks) {
+		mm->nommu_locks = bitmap_zalloc(max_low_pfn - min_low_pfn, GFP_KERNEL);
+		if (!mm->nommu_locks)
+			return -ENOMEM;
+	}
+	bitmap_set(mm->nommu_locks, first, count);
+	mm->locked_vm += added;
+	return 0;
+}
+
+void nommu_munlock_range(struct mm_struct *mm, unsigned long start, unsigned long end)
+{
+	unsigned long first, count;
+	mmap_assert_write_locked(mm);
+	if (mm->nommu_locks && ram_range(start, end, &first, &count)) {
+		mm->locked_vm -= already_locked(mm, first, count);
+		bitmap_clear(mm->nommu_locks, first, count);
+	}
+}
+
+bool nommu_mlock_intersects(struct mm_struct *mm, unsigned long start, unsigned long end)
+{
+	unsigned long first, count;
+	mmap_assert_locked(mm);
+	return mm->nommu_locks && ram_range(start, end, &first, &count) &&
+		find_next_bit(mm->nommu_locks, first + count, first) < first + count;
+}
+
+void nommu_munlock_all(struct mm_struct *mm)
+{
+	mmap_assert_write_locked(mm);
+	bitmap_free(mm->nommu_locks);
+	mm->nommu_locks = NULL;
+	mm->locked_vm = 0;
+	mm->def_flags &= ~VM_LOCKED_MASK;
+}
+
+int nommu_mlock_check(struct mm_struct *mm, unsigned long len, vm_flags_t flags)
+{
+	/* Before the address is known, reject requests larger than the entire
+	 * limit. The exact union with existing locks is checked at commit. */
+	if ((flags & VM_LOCKED) && !capable(CAP_IPC_LOCK) &&
+	    (len >> PAGE_SHIFT) > (rlimit(RLIMIT_MEMLOCK) >> PAGE_SHIFT))
+		return -EAGAIN;
+	return 0;
+}
+
+static bool permitted(void)
+{
+	return rlimit(RLIMIT_MEMLOCK) != 0 || capable(CAP_IPC_LOCK);
+}
+
+static int checked_range(struct mm_struct *mm, unsigned long *start,
+			 size_t len, unsigned long *end)
+{
+	struct vm_area_struct *vma;
+	unsigned long cursor, offset = offset_in_page(*start);
+	if (len > ULONG_MAX - offset ||
+	    len + offset > ULONG_MAX - (PAGE_SIZE - 1))
+		return -EINVAL;
+	len = PAGE_ALIGN(len + offset);
+	*start &= PAGE_MASK;
+	*end = *start + len;
+	if (*end < *start)
+		return -EINVAL;
+	for (cursor = *start; cursor < *end; cursor = vma->vm_end) {
+		vma = find_vma(mm, cursor);
+		if (!vma || cursor < vma->vm_start || cursor >= vma->vm_end)
+			return -ENOMEM;
+	}
+	return 0;
+}
+
+static int lock_range(unsigned long start, size_t len, bool lock)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long end;
+	int ret;
+	if (lock && !permitted())
+		return -EPERM;
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+	ret = checked_range(mm, &start, len, &end);
+	if (!ret) {
+		if (lock)
+			ret = nommu_mlock_range(mm, start, end);
+		else
+			nommu_munlock_range(mm, start, end);
+	}
+	mmap_write_unlock(mm);
+	return ret;
+}
+
+SYSCALL_DEFINE2(mlock, unsigned long, start, size_t, len)
+{
+	return lock_range(start, len, true);
+}
+
+SYSCALL_DEFINE3(mlock2, unsigned long, start, size_t, len, int, flags)
+{
+	if (flags & ~MLOCK_ONFAULT)
+		return -EINVAL;
+	/* There are no demand faults on NOMMU; all mapped RAM is resident. */
+	return lock_range(start, len, true);
+}
+
+SYSCALL_DEFINE2(munlock, unsigned long, start, size_t, len)
+{
+	return lock_range(start, len, false);
+}
+
+SYSCALL_DEFINE1(mlockall, int, flags)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	unsigned long *locks = NULL, count = 0;
+	VMA_ITERATOR(vmi, mm, 0);
+	int ret = 0;
+	if (!flags || (flags & ~(MCL_CURRENT | MCL_FUTURE | MCL_ONFAULT)) ||
+	    flags == MCL_ONFAULT)
+		return -EINVAL;
+	if (!permitted())
+		return -EPERM;
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+	if (flags & MCL_CURRENT) {
+		locks = bitmap_zalloc(max_low_pfn - min_low_pfn, GFP_KERNEL);
+		if (!locks) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		for_each_vma(vmi, vma) {
+			unsigned long first, pages;
+			if (ram_range(vma->vm_start, vma->vm_end, &first, &pages))
+				bitmap_set(locks, first, pages);
+		}
+		count = bitmap_weight(locks, max_low_pfn - min_low_pfn);
+		if (!capable(CAP_IPC_LOCK) && count > (rlimit(RLIMIT_MEMLOCK) >> PAGE_SHIFT)) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		bitmap_free(mm->nommu_locks);
+		mm->nommu_locks = locks;
+		locks = NULL;
+		mm->locked_vm = count;
+	}
+	mm->def_flags &= ~VM_LOCKED_MASK;
+	if (flags & MCL_FUTURE)
+		mm->def_flags |= VM_LOCKED;
+out:
+	bitmap_free(locks);
+	mmap_write_unlock(mm);
+	return ret;
+}
+
+SYSCALL_DEFINE0(munlockall)
+{
+	struct mm_struct *mm = current->mm;
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+	nommu_munlock_all(mm);
+	mmap_write_unlock(mm);
+	return 0;
+}
