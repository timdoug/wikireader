From: WikiReader Linux port
Subject: [PATCH] binfmt_elf_fdpic: reserve space for the initial no-MMU stack image

PT_GNU_STACK specifies runtime stack space. The no-MMU loader also copies
argument strings, pointer arrays, load maps and auxiliary information into
that allocation without accounting for their size. Large arguments can
write below the mapping, corrupting other kernel or userspace allocations.
Reserve those bytes in addition to runtime stack space, and reject sizing
overflow before mapping. The maximum argument image and ELF segment count
bound the extra size; the untrusted PT_GNU_STACK size needs checked addition.

--- a/fs/binfmt_elf_fdpic.c
+++ b/fs/binfmt_elf_fdpic.c
@@ -36,6 +36,7 @@
 #include <linux/coredump.h>
 #include <linux/dax.h>
 #include <linux/regset.h>
+#include <linux/overflow.h>
 
 #include <linux/uaccess.h>
 #include <asm/param.h>
@@ -411,10 +412,39 @@
 		PAGE_ALIGN(current->mm->start_brk);
 
 #else
-	/* create a stack area and zero-size brk area */
-	stack_size = (stack_size + PAGE_SIZE - 1) & PAGE_MASK;
-	if (stack_size < PAGE_SIZE * 2)
-		stack_size = PAGE_SIZE * 2;
+	/* Reserve runtime stack space as well as the initial argument image.
+	 * On no-MMU, copy_to_user() cannot detect a write below this mapping.
+	 * A large exec argument must not overwrite neighbouring allocations.
+	 */
+	{
+		unsigned long extra;
+		const char *platform = ELF_PLATFORM;
+
+		stack_size = max(stack_size, PAGE_SIZE * 2UL);
+		extra = MAX_ARG_PAGES * PAGE_SIZE - bprm->p;
+		extra += (bprm->argc + bprm->envc + 3UL) * sizeof(elf_caddr_t);
+		extra += sizeof(current->mm->saved_auxv);
+		extra += sizeof(struct elf_fdpic_loadmap) +
+			 exec_params.loadmap->nsegs * sizeof(struct elf_fdpic_loadseg);
+		if (interp_params.loadmap)
+			extra += sizeof(struct elf_fdpic_loadmap) +
+				 interp_params.loadmap->nsegs * sizeof(struct elf_fdpic_loadseg);
+		if (platform)
+			extra += strlen(platform) + 1;
+#ifdef ELF_BASE_PLATFORM
+		platform = ELF_BASE_PLATFORM;
+		if (platform)
+			extra += strlen(platform) + 1;
+#endif
+		/* Alignment of strings, load maps, and the final stack pointer. */
+		extra += 64;
+		if (check_add_overflow(stack_size, extra, &stack_size) ||
+		    check_add_overflow(stack_size, PAGE_SIZE - 1, &stack_size)) {
+			retval = -E2BIG;
+			goto error;
+		}
+		stack_size &= PAGE_MASK;
+	}
 
 	stack_prot = PROT_READ | PROT_WRITE;
 	if (executable_stack == EXSTACK_ENABLE_X ||
