diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index c94ae4794..554fbc5bf 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -661,6 +661,16 @@ config MMC_DAVINCI
 	  If you have an DAVINCI board with a Multimedia Card slot,
 	  say Y or M here.  If unsure, say N.
 
+config MMC_S1C33_SD
+	tristate "Epson S1C33 SD card host (SPI mode)"
+	depends on C33
+	select CRC7
+	select CRC_ITU_T
+	help
+	  The SD card slot on the Epson S1C33's synchronous serial
+	  interface, driven directly as an MMC host in SPI mode.  Use it
+	  instead of MMC_SPI when the card is the interface's only device.
+
 config MMC_SPI
 	tristate "MMC/SD/SDIO over SPI"
 	depends on SPI_MASTER
diff --git a/drivers/mmc/host/Makefile b/drivers/mmc/host/Makefile
index 5057fea8a..9594e3129 100644
--- a/drivers/mmc/host/Makefile
+++ b/drivers/mmc/host/Makefile
@@ -34,6 +34,9 @@ obj-$(CONFIG_MMC_TIFM_SD)	+= tifm_sd.o
 obj-$(CONFIG_MMC_MVSDIO)	+= mvsdio.o
 obj-$(CONFIG_MMC_DAVINCI)       += davinci_mmc.o
 obj-$(CONFIG_MMC_SPI)		+= mmc_spi.o
+obj-$(CONFIG_MMC_S1C33_SD)	+= s1c33-sd.o
+# Its CRC and polling loops run from the C33's fetch buffer only when aligned.
+CFLAGS_s1c33-sd.o		+= -falign-loops=16
 obj-$(CONFIG_MMC_SPI)		+= of_mmc_spi.o
 obj-$(CONFIG_MMC_SDRICOH_CS)	+= sdricoh_cs.o
 obj-$(CONFIG_MMC_TMIO_CORE)	+= tmio_mmc_core.o
