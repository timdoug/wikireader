From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] binfmt_elf_fdpic: fit the initial NOMMU stack image into the
 stack

Without an MMU, load_elf_fdpic_binary() allocates the stack with the
size from PT_GNU_STACK (128 KiB when it is zero), and
create_elf_fdpic_tables() then copies the argument and environment
strings, the platform strings, the load maps, the auxiliary vector and
the argv/envp arrays to the top of the allocation. The size of that
image, up to MAX_ARG_PAGES pages of strings alone, is never compared
with the size of the allocation, and copy_to_user() cannot fault without
an MMU. For an exec whose arguments and environment are larger than the
stack, the kernel writes them below the allocation, over other user or
kernel memory. binfmt_flat adds the image to the stack size.

Count the image against the requested size, so that the size from
PT_GNU_STACK covers the whole stack. Grow the allocation only when the
image occupies more than a quarter of it, so that at least three
quarters remain for the program; for an ordinary exec the allocation
size is unchanged. Adding the image every time would push a power-of-two
stack into a power-of-two allocation of twice the size. PT_GNU_STACK
comes from the binary, so the sums are checked for overflow.

Reproduced with static PIEs, which this loader runs on NOMMU, on two
QEMU machines with CONFIG_BINFMT_ELF_FDPIC=y: riscv64 virt with
nommu_virt_defconfig, and ColdFire mcf5208evb with m5208evb_defconfig
(32-bit, 8 KiB pages). A program linked with -z stack-size=8192 prints
where its initial stack pointer lies:

  - riscv64, 12 KB environment: the stack pointer lies 4.4 KB below the
    8 KiB stack mapping;
  - riscv64, 112 KiB environment: the machine hangs during the exec;
  - ColdFire, 32 KB environment into the 16 KiB two-page minimum: the
    kernel jumps to 0x78787878, the environment's "xxxx", during softirq
    handling and panics.

With this patch, 60 execs on each machine all start with the whole image
inside the stack mapping and at least min(size - image, size - size / 4)
bytes below the stack pointer. They cover PT_GNU_STACK sizes of 8 KiB,
64 KiB and the default, environments up to the 128 KiB argument limit,
and up to 60000 argv or envp entries; on riscv64, three of them exceed
the argument limit and fail with E2BIG before anything is loaded.

Signed-off-by: Tim Douglas <me@timdoug.com>
---
 fs/binfmt_elf_fdpic.c | 63 ++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 60 insertions(+), 3 deletions(-)

diff --git a/fs/binfmt_elf_fdpic.c b/fs/binfmt_elf_fdpic.c
index d3872169f5..104d769628 100644
--- a/fs/binfmt_elf_fdpic.c
+++ b/fs/binfmt_elf_fdpic.c
@@ -36,6 +36,7 @@
 #include <linux/coredump.h>
 #include <linux/dax.h>
 #include <linux/regset.h>
+#include <linux/overflow.h>
 
 #include <linux/uaccess.h>
 #include <asm/param.h>
@@ -66,6 +67,9 @@ static int create_elf_fdpic_tables(struct linux_binprm *, struct mm_struct *,
 				   struct elf_fdpic_params *);
 
 #ifndef CONFIG_MMU
+static int elf_fdpic_stack_size(struct linux_binprm *,
+				struct elf_fdpic_params *,
+				struct elf_fdpic_params *, unsigned long *);
 static int elf_fdpic_map_file_constdisp_on_uclinux(struct elf_fdpic_params *,
 						   struct file *,
 						   struct mm_struct *);
@@ -416,9 +420,10 @@ static int load_elf_fdpic_binary(struct linux_binprm *bprm)
 
 #else
 	/* create a stack area and zero-size brk area */
-	stack_size = (stack_size + PAGE_SIZE - 1) & PAGE_MASK;
-	if (stack_size < PAGE_SIZE * 2)
-		stack_size = PAGE_SIZE * 2;
+	retval = elf_fdpic_stack_size(bprm, &exec_params, &interp_params,
+				      &stack_size);
+	if (retval < 0)
+		goto error;
 
 	stack_prot = PROT_READ | PROT_WRITE;
 	if (executable_stack == EXSTACK_ENABLE_X ||
@@ -497,6 +502,58 @@ static int load_elf_fdpic_binary(struct linux_binprm *bprm)
 #define ELF_BASE_PLATFORM NULL
 #endif
 
+#ifndef CONFIG_MMU
+/*
+ * Size the stack allocation of a NOMMU process. The size from
+ * PT_GNU_STACK covers the whole stack, including the initial image that
+ * create_elf_fdpic_tables() copies to the top of the allocation: the
+ * argument and environment strings, the platform strings, the load maps,
+ * the auxiliary vector and the pointer arrays. Without an MMU, copying
+ * an image larger than the allocation does not fault, and the memory
+ * below the allocation is overwritten.
+ *
+ * Grow the allocation only when the image occupies more than a quarter
+ * of the requested size, so that at least three quarters remain for the
+ * program. Adding the image every time would push a power-of-two stack
+ * into an allocation of twice the size.
+ */
+static int elf_fdpic_stack_size(struct linux_binprm *bprm,
+				struct elf_fdpic_params *exec_params,
+				struct elf_fdpic_params *interp_params,
+				unsigned long *stack_size)
+{
+	unsigned long size = max(*stack_size, PAGE_SIZE * 2UL);
+	const char *k_platform = ELF_PLATFORM;
+	const char *k_base_platform = ELF_BASE_PLATFORM;
+	unsigned long image;
+
+	image = MAX_ARG_PAGES * PAGE_SIZE - bprm->p;
+	if (k_platform)
+		image += strlen(k_platform) + 1;
+	if (k_base_platform)
+		image += strlen(k_base_platform) + 1;
+	image += sizeof(struct elf_fdpic_loadmap) +
+		 exec_params->loadmap->nsegs * sizeof(struct elf_fdpic_loadseg);
+	if (interp_params->loadmap)
+		image += sizeof(struct elf_fdpic_loadmap) +
+			 interp_params->loadmap->nsegs *
+			 sizeof(struct elf_fdpic_loadseg);
+	image += sizeof(current->mm->saved_auxv);
+	/* argc, argv[] and envp[] with their terminating NULLs */
+	image += (bprm->argc + bprm->envc + 3UL) * sizeof(elf_caddr_t);
+	/* the alignment steps of create_elf_fdpic_tables(), 51 bytes at most */
+	image += 64;
+
+	if (image > size / 4 &&
+	    check_add_overflow(image, size - size / 4, &size))
+		return -E2BIG;
+	if (check_add_overflow(size, PAGE_SIZE - 1, &size))
+		return -E2BIG;
+	*stack_size = size & PAGE_MASK;
+	return 0;
+}
+#endif
+
 /*
  * present useful information to the program by shovelling it onto the new
  * process's stack
