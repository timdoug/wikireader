+/*
+ * Follow a chain on through consecutive clusters within the FAT block
+ * @fatent holds.  If the entry @fatent points at holds the number of the
+ * cluster after it, step on to that cluster's entry while it does the same,
+ * at most @max times; return the number of steps, with @fatent pointing at
+ * the last entry stepped to.  A file written in one piece is mostly such
+ * runs, and a step here is a load and a compare where fat_ent_read() works
+ * out the block and calls through the operations: on a slow CPU, walking
+ * a large file's chain is most of the cost of reading far into it.
+ */
+int fat_ent_follow_contig(struct super_block *sb, struct fat_entry *fatent,
+			  int max)
+{
+	struct msdos_sb_info *sbi = MSDOS_SB(sb);
+	const struct buffer_head *bh = fatent->bhs[0];
+	int next = fatent->entry + 1, n = 0;
+
+	if (fatent->nr_bhs != 1 || !fatent->u.ent32_p)
+		return 0;
+	if (is_fat32(sbi)) {
+		const __le32 *p = fatent->u.ent32_p;
+		const __le32 *end = (__le32 *)(bh->b_data + bh->b_size);
+
+		if ((le32_to_cpu(*p) & 0x0fffffff) != next)
+			return 0;
+		while (n < max && p + 1 < end &&
+		       (le32_to_cpu(p[1]) & 0x0fffffff) == next + n + 1) {
+			p++;
+			n++;
+		}
+		fatent->u.ent32_p = (__le32 *)p;
+	} else if (is_fat16(sbi)) {
+		const __le16 *p = fatent->u.ent16_p;
+		const __le16 *end = (__le16 *)(bh->b_data + bh->b_size);
+
+		if (le16_to_cpu(*p) != next)
+			return 0;
+		while (n < max && p + 1 < end &&
+		       le16_to_cpu(p[1]) == next + n + 1) {
+			p++;
+			n++;
+		}
+		fatent->u.ent16_p = (__le16 *)p;
+	}
+	fatent->entry += n;
+	return n;
+}
