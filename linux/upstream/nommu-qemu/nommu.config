# Merged over arch/riscv/configs/nommu_virt_defconfig by run.sh.
# QEMU passes the command line as the device tree's bootargs.
CONFIG_CMDLINE=""
CONFIG_BINFMT_ELF_FDPIC=y
CONFIG_PROC_FS=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_KALLSYMS=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
