CONFIG_EXPERT=y
CONFIG_DEFAULT_HOSTNAME="wikireader"
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_FLAT=y
CONFIG_FLATMEM_MANUAL=y
CONFIG_FLATMEM=y
CONFIG_SLUB_TINY=y
CONFIG_SUSPEND=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_TIMER_S1C33=y
CONFIG_BLK_DEV_INITRD=y
# The initramfs is linked in uncompressed: Grifo loads the extra bytes faster
# than the kernel can inflate them, and there is no external initrd to decode.
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_MODULES=n
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_CROSS_MEMORY_ATTACH=n
CONFIG_COREDUMP=n
CONFIG_AIO=n
CONFIG_IO_URING=n
CONFIG_NET=n
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
# The card is driven directly, not as an SPI device under mmc_spi.
CONFIG_MMC_S1C33_SD=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# The system is an ext4 image in the card's FAT partition, which the boot
# initramfs attaches to a loop device.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=1
CONFIG_EXT4_FS=y
CONFIG_GPIOLIB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GPIO_S1C33=y
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
CONFIG_SERIAL_S1C33=y
CONFIG_SERIAL_S1C33_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_VT=n
CONFIG_UNIX98_PTYS=y
# Unix98 only: the 256 legacy BSD pairs cost 5.5 s of device registration
# at boot, and nothing opens them.
# CONFIG_LEGACY_PTYS is not set
CONFIG_DEVPTS_FS=y
CONFIG_INPUT=y
CONFIG_INPUT_VIVALDIFMAP=n
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_WIKIREADER=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_SERIO=n
CONFIG_HID=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_I2C=n
CONFIG_HWMON=n
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=y
CONFIG_FB_S1C33=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_LCD_WIKIREADER=y
CONFIG_PWM=y
CONFIG_PWM_S1C33=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_MONO=y
CONFIG_LOGO_LINUX_VGA16=n
CONFIG_LOGO_LINUX_CLUT224=n
CONFIG_HW_RANDOM=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FRAME_POINTER=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
# One SD card behind SPI: mq-deadline is plenty.
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set
# The whole boot logs about 4 KB.  The ring buffer's record tables are sized
# from this and are initialised data, so every doubling adds to what Grifo
# loads from the card.
CONFIG_LOG_BUF_SHIFT=15
# A stock unit is a touch panel with nothing on the serial port, and printk
# writes the console synchronously: at 115200 baud, plus the early LCD
# console, the boot log cost 0.4 s.  Warnings still show; loglevel=7 on the
# init.ini line brings the rest back, and a direct boot asks for it.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
