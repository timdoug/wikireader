CONFIG_EXPERT=y
CONFIG_DEFAULT_HOSTNAME="wikireader"
CONFIG_PRINTK=y
CONFIG_BUG=y
# No symbol table: about 185 KB of linux.app, 0.14 s of Grifo loading it at
# every boot.  Oopses print bare addresses; look them up in vmlinux.
# CONFIG_KALLSYMS is not set
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF_FDPIC=y
CONFIG_FLATMEM_MANUAL=y
CONFIG_FLATMEM=y
CONFIG_SLUB_TINY=y
CONFIG_SUSPEND=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_TIMER_S1C33=y
CONFIG_BLK_DEV_INITRD=y
# The initramfs is linked in uncompressed: Grifo loads the extra bytes faster
# than the kernel can inflate them, and there is no external initrd to decode.
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_MODULES=n
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_CROSS_MEMORY_ATTACH=n
CONFIG_COREDUMP=n
CONFIG_AIO=n
CONFIG_IO_URING=n
# Networking only for local sockets: X clients reach the server over AF_UNIX.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_AF_UNIX_OOB=n
CONFIG_WIRELESS=n
CONFIG_ETHTOOL_NETLINK=n
CONFIG_NET_RX_BUSY_POLL=n
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
# The card is driven directly, not as an SPI device under mmc_spi.
CONFIG_MMC_S1C33_SD=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# The system is an ext4 image in the card's FAT partition, which the boot
# initramfs attaches to a loop device.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=1
CONFIG_EXT4_FS=y
CONFIG_GPIOLIB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_S1C33=y
CONFIG_DMADEVICES=y
CONFIG_S1C33_HSDMA=y
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
CONFIG_SERIAL_S1C33=y
CONFIG_SERIAL_S1C33_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
# Virtual terminals only arbitrate the display between full-screen programs
# (wr-console, X); kernel messages stay on the serial console.
CONFIG_VT=y
CONFIG_VT_CONSOLE=n
CONFIG_CONSOLE_TRANSLATIONS=n
CONFIG_VT_HW_CONSOLE_BINDING=n
CONFIG_UNIX98_PTYS=y
# Unix98 only: the 256 legacy BSD pairs cost 5.5 s of device registration
# at boot, and nothing opens them.
# CONFIG_LEGACY_PTYS is not set
CONFIG_DEVPTS_FS=y
CONFIG_INPUT=y
CONFIG_INPUT_VIVALDIFMAP=n
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_WIKIREADER=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_SERIO=n
CONFIG_HID=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_I2C=n
# Battery voltage and board temperature: the converter, the battery's
# divider, and the stock battery and NTC thermistor drivers over them.
CONFIG_IIO=y
CONFIG_S1C33_ADC=y
CONFIG_IIO_RESCALE=y
CONFIG_POWER_SUPPLY=y
CONFIG_GENERIC_ADC_BATTERY=y
# The battery's voltage is in its power_supply node; no hwmon copy.
# CONFIG_POWER_SUPPLY_HWMON is not set
CONFIG_HWMON=y
CONFIG_SENSORS_NTC_THERMISTOR=y
CONFIG_WATCHDOG=y
CONFIG_S1C33_WATCHDOG=y
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=y
CONFIG_FB_S1C33=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_LCD_WIKIREADER=y
CONFIG_PWM=y
CONFIG_PWM_S1C33=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_MONO=y
CONFIG_LOGO_LINUX_VGA16=n
CONFIG_LOGO_LINUX_CLUT224=n
CONFIG_HW_RANDOM=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_FRAME_POINTER=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
# One SD card behind SPI: mq-deadline is plenty.
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set
# The whole boot logs about 4 KB.  The ring buffer's record tables are sized
# from this and are initialised data, so every doubling adds to what Grifo
# loads from the card.
CONFIG_LOG_BUF_SHIFT=15
# A stock unit is a touch panel with nothing on the serial port, and printk
# writes the console synchronously: at 115200 baud, plus the early LCD
# console, the boot log cost 0.4 s.  Warnings still show; loglevel=7 on the
# init.ini line brings the rest back, and a direct boot asks for it.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
# Kernel stack variables are not zeroed on entry: a hardening measure against
# leaking them, bought with a memset in every syscall's frame (select's is
# about a kilobyte); about 2% of an X drag frame here.
CONFIG_INIT_STACK_NONE=y
