#!/bin/sh

echo "C33 BusyBox init: PID 1 userspace started"

# One collector at a time, with /proc/PID kept alive until it exits.
# %c is the crashing process's RLIMIT_CORE, which the collector enforces.
printf '1\n' > /proc/sys/kernel/core_pipe_limit
printf '|/usr/libexec/wr-core %%P %%s %%t %%c\n' > /proc/sys/kernel/core_pattern
# A fragmenting allocation raises every watermark by a 4 MiB pageblock until
# kswapd catches up.  Without an MMU there is no compaction to benefit, and
# 1 MiB allocations failed with 5.6 MB free.
printf '0\n' > /proc/sys/vm/watermark_boost_factor

# init starts the consoles only once this script ends, so a normal boot does
# the setup and nothing else, and every exec counts: each is close to a
# tenth of a second on this machine, and a background job is one too, the
# shell having to re-execute itself without an MMU.  rootstart mounted
# /proc, /sys, /dev, /dev/pts, /tmp, /run, /dev/shm and /dev/mqueue;
# init starts seedrng and the watchdog
# daemon after the consoles (/etc/init.d/late).  The self-tests take several
# seconds and run only under wr.selftest.
read -r cmdline < /proc/cmdline
case " $cmdline " in
*" wr.selftest "*) /etc/init.d/selftest ;;
esac

if [ -c /dev/pts/ptmx ]; then
	echo "C33 PTY: mounted devpts for userspace console"
else
	echo "C33 PTY: devpts mount FAILED"
fi

echo "C33 BusyBox shell ready on ttyC0"
echo "C33 userspace framebuffer console scheduled by init"
