#!/bin/sh

echo "C33 BusyBox init: PID 1 userspace started"

if /diag-test; then
	echo "C33 BusyBox init: diagnostic child passed"
else
	echo "C33 BusyBox init: diagnostic child FAILED"
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

if /etc/init.d/busybox-test; then
	:
else
	echo "C33 BusyBox recovery suite FAILED"
fi

if mount -t vfat -o sync /dev/wrsd1 /mnt/sd; then
	if echo "C33 Linux wrote this boot status" > /mnt/sd/linux.ok; then
		sync
		echo "C33 SD/FAT: mounted /dev/wrsd1 and persisted linux.ok"
	else
		echo "C33 SD/FAT: status write FAILED"
	fi
else
	echo "C33 SD/FAT: mount FAILED"
fi

echo "*** HARDWARE PASS: BusyBox 1.38 is PID 1 on native C33 Linux ***"
echo "C33 BusyBox shell ready on ttyC330"
