#!/bin/sh

fail()
{
	echo "C33 BusyBox recovery suite FAILED: $1"
	exit 1
}

exercise_hush()
{
	local count=0
	local word

	for word in one two three; do
		count=$(expr "$count" + 1) || return 1
	done
	case "$count" in
		3) return 0 ;;
		*) return 1 ;;
	esac
}

work=/tmp/busybox-test
rm -rf "$work" || fail rm
mkdir "$work" || fail mkdir

exercise_hush || fail hush
[ "$((2147483647 + 1))" = 2147483648 ] || fail shell-arithmetic
printf 'alpha\nbeta\ngamma\n' >"$work/input" || fail printf
cp "$work/input" "$work/copy" || fail cp
cmp "$work/input" "$work/copy" || fail cmp
grep -qx beta "$work/copy" || fail grep
awk 'NR == 2 { print toupper($0) }' "$work/copy" >"$work/awk" || fail awk
sed -n '3s/gamma/GAMMA/p' "$work/copy" >"$work/sed" || fail sed
printf 'BETA\nGAMMA\n' >"$work/expected" || fail printf
cat "$work/awk" "$work/sed" | cmp - "$work/expected" || fail pipeline

tar -cf "$work/archive.tar" -C "$work" input copy || fail tar
gzip -c "$work/input" >"$work/input.gz" || fail gzip
gunzip -c "$work/input.gz" >"$work/roundtrip" || fail gunzip
cmp "$work/input" "$work/roundtrip" || fail gzip-roundtrip
sha256sum "$work/input" >"$work/input.sha256" || fail sha256sum
test -s "$work/input.sha256" || fail test
find "$work" -type f | sort >"$work/files" || fail find-sort
grep -q '/archive.tar$' "$work/files" || fail find-result

# Exercise the options used by ordinary scripts, including filenames with
# spaces, compressed tarballs, and a checksum check rather than just creation.
mkdir "$work/names" || fail mkdir-names
touch "$work/names/two words" || fail touch-spaces
find "$work/names" -maxdepth 1 -type f -print0 | xargs -0 -r \
	stat -c '%n' >"$work/names.out" || fail find-xargs-zero
grep -qx "$work/names/two words" "$work/names.out" || fail filename-spaces
ln -s input "$work/link" || fail symlink
[ "$(readlink "$work/link")" = input ] || fail readlink
temporary=$(mktemp "$work/temp.XXXXXX") || fail mktemp
test -f "$temporary" || fail mktemp-file
sha256sum -c "$work/input.sha256" >/dev/null || fail checksum-check
tar -czf "$work/archive.tar.gz" -C "$work" input || fail tar-gzip-create
mkdir "$work/unpacked" || fail mkdir-unpacked
tar -xf "$work/archive.tar.gz" -C "$work/unpacked" || fail tar-gzip-detect
cmp "$work/input" "$work/unpacked/input" || fail tar-gzip-roundtrip
printf 'alpha\nBETA\ngamma\n' >"$work/changed" || fail printf-changed
diff -u "$work/input" "$work/changed" >"$work/change.patch"
[ "$?" = 1 ] || fail diff-unified
patch "$work/copy" <"$work/change.patch" >/dev/null || fail patch
cmp "$work/copy" "$work/changed" || fail patch-result
printf 'hello' | base64 | base64 -d >"$work/base64" || fail base64
[ "$(cat "$work/base64")" = hello ] || fail base64-roundtrip
free >"$work/free" || fail free
grep -q '^Mem:' "$work/free" || fail free-memory
ps -l >"$work/ps" || fail ps-long
pidof init >/dev/null || fail pidof-init
sysctl kernel.hostname >"$work/hostname" || fail sysctl
grep -q wikireader "$work/hostname" || fail sysctl-hostname

rm -rf "$work" || fail cleanup
echo "C33 BusyBox recovery suite passed: hush + file/text/archive tools"
echo "C33 BusyBox conveniences passed: arithmetic + filenames + archives + patch + diagnostics"

# BusyBox and libc are FDPIC code, whose text holds no absolute address, so
# the kernel and ld.so map each read-only once and every process running
# them uses that copy.  PID 1 and this grep must name the same text
# mappings.
text=' r-x.* /(bin/busybox|lib/libuClibc-[0-9.]+\.so)$'
init_text=$(grep -E "$text" /proc/1/maps | cut -d' ' -f1) || fail "no text mappings in PID 1"
own_text=$(grep -E "$text" /proc/self/maps | cut -d' ' -f1) || fail "no text mappings in grep"
[ "$init_text" = "$own_text" ] || fail "private text: $init_text / $own_text"
set -- $init_text
[ $# = 2 ] || fail "expected BusyBox and libc text: $init_text"
echo "C33 BusyBox shared text: $1 and libc $2 mapped once for every process"
