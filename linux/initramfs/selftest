#!/bin/sh
# The boot's self-tests, which rcS runs when the command line carries
# wr.selftest: the tests put it on the launcher's init.ini line, and the
# kernel adds it itself on a direct boot.  A file of its own, so that a
# normal boot does not even parse it.

# Keep the kernel test lines: they go into the card report below, where a
# device without serial can show them.
if /usr/libexec/wr-selftest > /tmp/diag.txt; then
	cat /tmp/diag.txt
	echo "C33 BusyBox init: kernel self-test passed"
else
	cat /tmp/diag.txt
	echo "C33 BusyBox init: kernel self-test FAILED"
fi

echo "C33 IRQ: generic registrations"
cat /proc/interrupts
touch_event=
for n in /sys/class/input/event*; do
	if [ "$(cat $n/device/name)" = "WikiReader touchscreen" ]; then
		touch_event=/dev/input/${n##*/}
	fi
done
if [ -n "$touch_event" ] && [ -c "$touch_event" ]; then
	echo "C33 input: $touch_event absolute touchscreen registered"
else
	echo "C33 input: touchscreen registration FAILED"
fi
if [ "$(cat /sys/class/graphics/fb0/virtual_size)" = "240,208" ] &&
	[ "$(cat /sys/class/graphics/fb0/bits_per_pixel)" = "1" ] &&
	dd if=/dev/fb0 of=/tmp/fb.snapshot bs=6656 count=1 2>/dev/null &&
	[ "$(wc -c < /tmp/fb.snapshot)" = "6656" ] &&
	dd if=/tmp/fb.snapshot of=/dev/fb0 bs=6656 count=1 2>/dev/null; then
	rm -f /tmp/fb.snapshot
	echo "C33 framebuffer: /dev/fb0 240x208 mono read/write passed"
else
	echo "C33 framebuffer: registration FAILED"
fi

# The battery through its divider and the board's thermistor, both read
# by the stock drivers over the converter.
battery=/sys/class/power_supply/battery
read -r battery_uv < $battery/voltage_now
read -r battery_status < $battery/status
board_mc=
for n in /sys/class/hwmon/hwmon*; do
	[ "$(cat $n/name)" = ncp03wf104 ] && read -r board_mc < $n/temp1_input
done
if [ "$battery_uv" -gt 0 ] && [ "$battery_status" = Discharging ] &&
	[ -n "$board_mc" ]; then
	# Units to thousandths: this hush has no arithmetic.
	echo "C33 sensors: battery ${battery_uv%???} mV, board ${board_mc%???} C"
else
	echo "C33 sensors: battery or thermistor read FAILED"
fi

# Blanking is the only display power control the panel has; prove it works
# and leave the screen on.
blank=/sys/class/graphics/fb0/blank
if echo 4 > $blank && [ "$(cat $blank)" = "4" ] &&
	echo 0 > $blank && [ "$(cat $blank)" = "0" ]; then
	echo "C33 display: fbdev blank and unblank passed"
else
	echo "C33 display: blank FAILED"
fi

if /etc/init.d/busybox-test; then
	:
else
	echo "C33 BusyBox recovery suite FAILED"
fi

# A stock device has no serial, so what the kernel decided about memory and
# time has to leave on the card.  Every external command here is an exec of
# BusyBox, close to a tenth of a second on this machine, so the report reads
# files with the shell's own read and keeps its execs to a handful: uname,
# dmesg and grep, one grep over sysfs, date and sleep.
show_file() {
	while read -r line; do
		echo "$line"
	done < "$1"
}
show_value() {
	line=
	read -r line < "$2" 2>/dev/null
	echo "$1: $line"
}
timer_report() {
	uname -a
	dmesg | grep -E "C33 memory|C33 clock|s1c33-timer|clocksource|Delay loop|regulator|s1c33-spi|mmc_spi|mmc0|mmcblk0|C33 (process|signal|trace) test"
	grep -H . /sys/class/regulator/regulator.*/name \
		/sys/class/regulator/regulator.*/state \
		/sys/class/regulator/regulator.*/microvolts \
		/sys/class/regulator/regulator.*/num_users \
		/sys/class/lcd/*/contrast /sys/class/lcd/*/max_contrast \
		/sys/class/input/event*/device/name \
		/sys/class/power_supply/*/voltage_now \
		/sys/class/power_supply/*/status \
		/sys/class/hwmon/hwmon*/temp1_input \
		/sys/bus/iio/devices/iio:device0/in_voltage*_raw 2>/dev/null
	for device in /sys/bus/spi/devices/*; do
		echo "spi device: ${device##*/}"
	done
	show_file /tmp/diag.txt
	show_value cmdline /proc/cmdline
	echo "date: $(date)"
	while read -r line; do
		case "$line" in
		MemTotal*) echo "$line" ;;
		esac
	done < /proc/meminfo
	show_value current_clocksource \
		/sys/devices/system/clocksource/clocksource0/current_clocksource
	show_value "fb0 blank state" /sys/class/graphics/fb0/blank
	uart1=/sys/bus/platform/devices/300b10.serial
	show_value "uart1 wakeup" $uart1/power/wakeup
	show_value "uart1 wakeup_count" $uart1/power/wakeup_count
	echo "--- interrupts, then again after sleeping 5 ---"
	show_file /proc/interrupts
	read before rest < /proc/uptime
	sleep 5
	read after rest < /proc/uptime
	show_file /proc/interrupts
	echo "uptime $before -> $after"
	echo "expected: about 5 s plus one exec, and a timer count that grew by"
	echo "far less than 500, because the idle tick stops"
}

if echo "C33 Linux wrote this boot status" > /mnt/sd/linux.ok; then
	sync
	echo "C33 MMC/SPI: mounted /dev/mmcblk0p1 and persisted linux.ok"
else
	echo "C33 MMC/SPI: status write FAILED"
fi
# It sleeps to measure the tick, so it must not hold up init; the
# numbers are better taken against an otherwise idle system anyway.
# rootstart set the clock from the card before mounting the system.
# Twenty quiet seconds first: the report is the only background work
# on the machine, and its execs and sync card writes would otherwise
# land on whatever the user is typing.  The boot test measures the
# console's own latency inside that window.
report_to_card() {
	sleep 20
	if timer_report > /mnt/sd/linuxhw.txt 2>&1; then
		sync
		echo "C33 time: wrote linuxhw.txt"
	else
		echo "C33 time: report write FAILED"
	fi
}
report_to_card &

echo "*** HARDWARE PASS: BusyBox 1.38 is PID 1 on native C33 Linux ***"
