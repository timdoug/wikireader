Build wlroots, cage, foot and seatd for a no-MMU uClibc device.

wlroots renders with pixman and allocates DRM dumb buffers whatever else
it has, so EGL, OpenGL ES and GBM are used when present rather than
required, and it needs libudev, as libinput does, not a udev daemon.
seatd's built-in backend forks, like its daemon, so it is for MMU systems;
without either libseat has its noop backend and the client of a seatd
run elsewhere.  fcft and foot need ISO C11
threads, which uClibc-ng can provide: BR2_TOOLCHAIN_HAS_C11_THREADS says
so, set for glibc and musl and by a question for external uClibc ones.
cage builds the layer shell's protocol header with wayland-scanner, for
the external tree's layer shell patch.

--- a/package/wlroots/Config.in
+++ b/package/wlroots/Config.in
@@ -1,8 +1,5 @@
-comment "wlroots needs udev, EGL, OpenGL ES and GBM support"
-	depends on !BR2_PACKAGE_HAS_LIBEGL || \
-		!BR2_PACKAGE_HAS_LIBEGL || \
-		!BR2_PACKAGE_HAS_LIBGLES || \
-		!BR2_PACKAGE_HAS_UDEV
+comment "wlroots needs libudev"
+	depends on !BR2_PACKAGE_HAS_LIBUDEV
 
 comment "wlroots needs a toolchain w/ threads, dynamic library"
 	depends on !BR2_TOOLCHAIN_HAS_THREADS || \
@@ -12,10 +9,7 @@
 	bool "wlroots"
 	depends on !BR2_STATIC_LIBS # wayland
 	depends on BR2_TOOLCHAIN_HAS_THREADS # libdrm, wayland
-	depends on BR2_PACKAGE_HAS_UDEV # libinput
-	depends on BR2_PACKAGE_HAS_LIBEGL
-	depends on BR2_PACKAGE_HAS_LIBGLES
-	depends on BR2_PACKAGE_HAS_LIBGBM
+	depends on BR2_PACKAGE_HAS_LIBUDEV # libinput
 	select BR2_PACKAGE_HWDATA
 	select BR2_PACKAGE_HWDATA_PNP_IDS
 	select BR2_PACKAGE_LIBDISPLAY_INFO
@@ -30,6 +24,10 @@
 	  wlroots is a modular Wayland library for building compositors
 	  which implements many of their common features.
 
+	  It always renders with pixman, in software, into DRM dumb
+	  buffers; OpenGL ES rendering and GBM buffers are built when
+	  EGL, OpenGL ES and GBM are available.
+
 	  https://gitlab.freedesktop.org/wlroots/wlroots
 
 if BR2_PACKAGE_WLROOTS
--- a/package/wlroots/wlroots.mk
+++ b/package/wlroots/wlroots.mk
@@ -15,22 +15,29 @@
 	host-wayland \
 	hwdata \
 	libdisplay-info \
+	libdrm \
 	libinput \
 	libxkbcommon \
-	libegl \
-	libgles \
-	libgbm \
 	pixman \
 	seatd \
-	udev \
+	libudev \
 	wayland \
 	wayland-protocols
 
 WLROOTS_CONF_OPTS = -Dexamples=false -Dxcb-errors=disabled -Dlibliftoff=disabled
 
-WLROOTS_RENDERERS = gles2
 WLROOTS_BACKENDS = libinput drm
 
+ifeq ($(BR2_PACKAGE_HAS_LIBEGL)$(BR2_PACKAGE_HAS_LIBGLES),yy)
+WLROOTS_RENDERERS += gles2
+WLROOTS_DEPENDENCIES += libegl libgles
+endif
+
+ifeq ($(BR2_PACKAGE_HAS_LIBGBM),y)
+WLROOTS_ALLOCATORS += gbm
+WLROOTS_DEPENDENCIES += libgbm
+endif
+
 ifeq ($(BR2_PACKAGE_WLROOTS_X11),y)
 WLROOTS_BACKENDS += x11
 WLROOTS_DEPENDENCIES += libxcb xcb-util-wm xcb-util-renderutil xlib_libX11
@@ -50,6 +57,7 @@
 
 WLROOTS_CONF_OPTS += \
 	-Dbackends=$(subst $(space),$(comma),$(strip $(WLROOTS_BACKENDS))) \
-	-Drenderers=$(subst $(space),$(comma),$(strip $(WLROOTS_RENDERERS)))
+	-Drenderers=$(subst $(space),$(comma),$(strip $(WLROOTS_RENDERERS))) \
+	-Dallocators=$(subst $(space),$(comma),$(strip $(WLROOTS_ALLOCATORS)))
 
 $(eval $(meson-package))
