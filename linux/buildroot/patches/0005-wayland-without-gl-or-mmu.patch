--- a/package/seatd/Config.in
+++ b/package/seatd/Config.in
@@ -1,7 +1,8 @@
 menuconfig BR2_PACKAGE_SEATD
 	bool "seatd"
 	select BR2_PACKAGE_SEATD_BUILTIN \
-		if !BR2_PACKAGE_SYSTEMD_LOGIND && !BR2_PACKAGE_SEATD_DAEMON
+		if !BR2_PACKAGE_SYSTEMD_LOGIND && !BR2_PACKAGE_SEATD_DAEMON && \
+			BR2_USE_MMU
 	help
 	  Seat management daemon and support library.
 
@@ -11,9 +12,14 @@
 
 config BR2_PACKAGE_SEATD_BUILTIN
 	bool "builtin backend"
+	depends on BR2_USE_MMU # fork()
 	help
 	  Builtin in-process seatd implementation inside libseat.
 
+	  Without it, the daemon or logind, libseat has only its noop
+	  backend (LIBSEAT_BACKEND=noop), which opens devices directly
+	  and suits a compositor running as root on a single seat.
+
 config BR2_PACKAGE_SEATD_DAEMON
 	bool "seatd daemon"
 	depends on BR2_USE_MMU # fork()
--- a/package/seatd/seatd.mk
+++ b/package/seatd/seatd.mk
@@ -47,6 +47,10 @@
 		$(TARGET_DIR)/usr/lib/systemd/system/seatd.service
 endef
 
+else ifeq ($(BR2_PACKAGE_SEATD_BUILTIN)$(BR2_PACKAGE_SYSTEMD_LOGIND),)
+# libseat needs a backend besides noop: the client of a seatd running
+# elsewhere, which needs no fork(), as the daemon and builtin do.
+SEATD_CONF_OPTS += -Dlibseat-seatd=enabled -Dserver=disabled
 else
 SEATD_CONF_OPTS += -Dlibseat-seatd=disabled -Dserver=disabled
 endif
