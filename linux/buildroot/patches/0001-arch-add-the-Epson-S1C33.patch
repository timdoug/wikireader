diff --git a/arch/Config.in b/arch/Config.in
index 863a1eed..f941b6af 100644
--- a/arch/Config.in
+++ b/arch/Config.in
@@ -68,6 +68,16 @@ config BR2_aarch64_be
 	  http://www.arm.com/products/processors/instruction-set-architectures/armv8-architecture.php
 	  http://en.wikipedia.org/wiki/ARM
 
+config BR2_c33
+	bool "Epson S1C33"
+	depends on !BR2_HIDE_SECONDARY_TARGET_OPTIONS
+	select BR2_SOFT_FLOAT
+	# Only an external toolchain: GCC and binutils have no upstream port.
+	select BR2_ARCH_HAS_NO_TOOLCHAIN_BUILDROOT
+	help
+	  Seiko Epson S1C33 family, a 32-bit little-endian core with no
+	  MMU or FPU, as found in the WikiReader.
+
 config BR2_hppa
 	bool "HPPA"
 	depends on !BR2_HIDE_SECONDARY_TARGET_OPTIONS
@@ -416,6 +426,10 @@ if BR2_arm || BR2_armeb || BR2_aarch64 || BR2_aarch64_be
 source "arch/Config.in.arm"
 endif
 
+if BR2_c33
+source "arch/Config.in.c33"
+endif
+
 if BR2_hppa
 source "arch/Config.in.hppa"
 endif
diff --git a/arch/Config.in.c33 b/arch/Config.in.c33
new file mode 100644
index 00000000..077b7a8c
--- /dev/null
+++ b/arch/Config.in.c33
@@ -0,0 +1,14 @@
+config BR2_ARCH
+	default "c33"		if BR2_c33
+
+config BR2_NORMALIZED_ARCH
+	default "c33"
+
+config BR2_ENDIAN
+	default "LITTLE"
+
+config BR2_READELF_ARCH_NAME
+	default "S1C33 Family of Seiko Epson processors"
+
+# vim: ft=kconfig
+# -*- mode:kconfig; -*-
