diff --git a/layer_shell.c b/layer_shell.c
new file mode 100644
index 0000000..df85380
--- /dev/null
+++ b/layer_shell.c
@@ -0,0 +1,176 @@
+/*
+ * Cage: A Wayland kiosk.
+ *
+ * Layer shell surfaces: panels, docks and on-screen keyboards, drawn above
+ * or below the application, which gets the area their exclusive zones
+ * leave.  They take no keyboard focus.
+ *
+ * See the LICENSE file accompanying this file.
+ */
+
+#define _POSIX_C_SOURCE 200112L
+
+#include <stdlib.h>
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_layer_shell_v1.h>
+#include <wlr/types/wlr_output_layout.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/box.h>
+#include <wlr/util/log.h>
+
+#include "layer_shell.h"
+#include "output.h"
+#include "server.h"
+#include "view.h"
+
+void
+arrange_layers(struct cg_output *output)
+{
+	struct cg_server *server = output->server;
+	struct wlr_box full_area;
+	wlr_output_layout_get_box(server->output_layout, output->wlr_output, &full_area);
+	if (wlr_box_empty(&full_area)) {
+		return;
+	}
+
+	/* Exclusive zones are taken from the top layer down, as in other
+	   compositors. */
+	struct wlr_box usable_area = full_area;
+	for (int layer = ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY; layer >= ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND; layer--) {
+		struct cg_layer_surface *surface;
+		wl_list_for_each (surface, &server->layer_surfaces, link) {
+			if (surface->output != output || !surface->layer_surface->initialized ||
+			    surface->layer_surface->current.layer != (enum zwlr_layer_shell_v1_layer) layer) {
+				continue;
+			}
+			wlr_scene_layer_surface_v1_configure(surface->scene, &full_area, &usable_area);
+		}
+	}
+
+	if (!wlr_box_equal(&usable_area, &output->usable_area)) {
+		output->usable_area = usable_area;
+		view_position_all(server);
+	}
+}
+
+static void
+handle_layer_surface_map(struct wl_listener *listener, void *data)
+{
+	struct cg_layer_surface *surface = wl_container_of(listener, surface, map);
+	if (surface->output) {
+		arrange_layers(surface->output);
+	}
+}
+
+static void
+handle_layer_surface_unmap(struct wl_listener *listener, void *data)
+{
+	struct cg_layer_surface *surface = wl_container_of(listener, surface, unmap);
+	if (surface->output) {
+		arrange_layers(surface->output);
+	}
+}
+
+static void
+handle_layer_surface_commit(struct wl_listener *listener, void *data)
+{
+	struct cg_layer_surface *surface = wl_container_of(listener, surface, commit);
+	struct wlr_layer_surface_v1 *layer_surface = surface->layer_surface;
+
+	if (!layer_surface->initial_commit && layer_surface->current.committed == 0) {
+		return;
+	}
+	if (layer_surface->current.committed & WLR_LAYER_SURFACE_V1_STATE_LAYER) {
+		wlr_scene_node_reparent(&surface->scene->tree->node,
+					surface->server->layers[layer_surface->current.layer]);
+	}
+	/* The initial commit is answered with a configure, which this sends. */
+	if (surface->output) {
+		arrange_layers(surface->output);
+	}
+}
+
+static void
+handle_layer_surface_destroy(struct wl_listener *listener, void *data)
+{
+	struct cg_layer_surface *surface = wl_container_of(listener, surface, destroy);
+
+	wl_list_remove(&surface->map.link);
+	wl_list_remove(&surface->unmap.link);
+	wl_list_remove(&surface->commit.link);
+	wl_list_remove(&surface->destroy.link);
+	wl_list_remove(&surface->link);
+	if (surface->output) {
+		arrange_layers(surface->output);
+	}
+	free(surface);
+}
+
+void
+handle_new_layer_surface(struct wl_listener *listener, void *data)
+{
+	struct cg_server *server = wl_container_of(listener, server, new_layer_surface);
+	struct wlr_layer_surface_v1 *layer_surface = data;
+	struct cg_output *output = NULL;
+
+	if (layer_surface->output) {
+		output = layer_surface->output->data;
+	} else {
+		struct cg_output *candidate;
+		wl_list_for_each (candidate, &server->outputs, link) {
+			if (candidate->wlr_output->enabled) {
+				output = candidate;
+				break;
+			}
+		}
+	}
+	if (!output) {
+		wlr_log(WLR_ERROR, "No output for layer surface %s", layer_surface->namespace);
+		wlr_layer_surface_v1_destroy(layer_surface);
+		return;
+	}
+	layer_surface->output = output->wlr_output;
+
+	struct cg_layer_surface *surface = calloc(1, sizeof(struct cg_layer_surface));
+	if (!surface) {
+		wlr_log(WLR_ERROR, "Failed to allocate layer surface");
+		wlr_layer_surface_v1_destroy(layer_surface);
+		return;
+	}
+	surface->scene =
+		wlr_scene_layer_surface_v1_create(server->layers[layer_surface->pending.layer], layer_surface);
+	if (!surface->scene) {
+		wlr_log(WLR_ERROR, "Failed to allocate layer surface scene node");
+		free(surface);
+		wlr_layer_surface_v1_destroy(layer_surface);
+		return;
+	}
+	surface->server = server;
+	surface->output = output;
+	surface->layer_surface = layer_surface;
+	layer_surface->data = surface;
+
+	surface->map.notify = handle_layer_surface_map;
+	wl_signal_add(&layer_surface->surface->events.map, &surface->map);
+	surface->unmap.notify = handle_layer_surface_unmap;
+	wl_signal_add(&layer_surface->surface->events.unmap, &surface->unmap);
+	surface->commit.notify = handle_layer_surface_commit;
+	wl_signal_add(&layer_surface->surface->events.commit, &surface->commit);
+	surface->destroy.notify = handle_layer_surface_destroy;
+	wl_signal_add(&layer_surface->events.destroy, &surface->destroy);
+	wl_list_insert(&server->layer_surfaces, &surface->link);
+}
+
+/* An output going away takes its layer surfaces with it, as the protocol
+   says: their clients are told with closed. */
+void
+layer_shell_destroy_output(struct cg_output *output)
+{
+	struct cg_layer_surface *surface, *tmp;
+	wl_list_for_each_safe (surface, tmp, &output->server->layer_surfaces, link) {
+		if (surface->output == output) {
+			surface->output = NULL;
+			wlr_layer_surface_v1_destroy(surface->layer_surface);
+		}
+	}
+}
diff --git a/layer_shell.h b/layer_shell.h
new file mode 100644
index 0000000..4183565
--- /dev/null
+++ b/layer_shell.h
@@ -0,0 +1,28 @@
+#ifndef CG_LAYER_SHELL_H
+#define CG_LAYER_SHELL_H
+
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_layer_shell_v1.h>
+#include <wlr/types/wlr_scene.h>
+
+#include "output.h"
+
+struct cg_layer_surface {
+	struct cg_server *server;
+	struct cg_output *output;
+	struct wlr_layer_surface_v1 *layer_surface;
+	struct wlr_scene_layer_surface_v1 *scene;
+
+	struct wl_listener map;
+	struct wl_listener unmap;
+	struct wl_listener commit;
+	struct wl_listener destroy;
+
+	struct wl_list link; // cg_server::layer_surfaces
+};
+
+void handle_new_layer_surface(struct wl_listener *listener, void *data);
+void arrange_layers(struct cg_output *output);
+void layer_shell_destroy_output(struct cg_output *output);
+
+#endif
