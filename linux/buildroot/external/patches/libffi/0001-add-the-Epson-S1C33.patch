+   WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+   DEALINGS IN THE SOFTWARE.
+   ----------------------------------------------------------------------- */
+
+#define LIBFFI_ASM
+#include <fficonfig.h>
+#include <ffi.h>
+
+/* void ffi_call_SYSV (void *stack, unsigned bytes, unsigned *regs,
+			void (*fn) (void));
+
+   Copies BYTES (a multiple of 4) from STACK to a new stack top, loads
+   %r5-%r12 from REGS[0..7], calls FN and stores %r4 and %r5 as they come
+   back in REGS[8] and REGS[9].  Under FDPIC, FN is a function descriptor
+   and the call takes its data pointer, as GCC's own indirect calls do;
+   %r15 is put back before returning, since a caller in this module does
+   not restore it.  */
+
+	.text
+	.align	1
+	.global	ffi_call_SYSV
+	.hidden	ffi_call_SYSV
+	.type	ffi_call_SYSV, @function
+ffi_call_SYSV:
+	pushn	%r3		/* %r0-%r3 are ours to preserve */
+	ld.w	%r0,%sp		/* the frame, for the return */
+	ld.w	%r1,%r8		/* REGS */
+	ld.w	%r2,%r9		/* FN */
+	ld.w	%r3,%r15	/* this module's data pointer */
+
+	/* Room for the stack stream, rounded to 16 bytes.  */
+	ld.w	%r4,%r7
+	xadd	%r4,15
+	xand	%r4,-16
+	ld.w	%r10,%sp
+	sub	%r10,%r4
+	ld.w	%sp,%r10
+
+	/* Copy it, a word at a time.  */
+	ld.w	%r5,%sp
+1:	xcmp	%r7,0
+	jreq	2f
+	ld.w	%r4,[%r6]+
+	ld.w	[%r5]+,%r4
+	xsub	%r7,4
+	jp	1b
+
+2:	ld.w	%r5,[%r1]
+	xld.w	%r6,[%r1+4]
+	xld.w	%r7,[%r1+8]
+	xld.w	%r8,[%r1+12]
+	xld.w	%r9,[%r1+16]
+	xld.w	%r10,[%r1+20]
+	xld.w	%r11,[%r1+24]
+	xld.w	%r12,[%r1+28]
+#ifdef __FDPIC__
+	xld.w	%r15,[%r2+4]
+	ld.w	%r14,[%r2]
+	call	%r14
+#else
+	call	%r2
+#endif
+	ld.w	%r15,%r3
+	xld.w	[%r1+32],%r4
+	xld.w	[%r1+36],%r5
+	ld.w	%sp,%r0
+	popn	%r3
+	ret
+	.size	ffi_call_SYSV, .-ffi_call_SYSV
+
+#if defined __ELF__ && defined __linux__
+	.section	.note.GNU-stack,"",%progbits
+#endif
