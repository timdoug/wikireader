+   WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+   DEALINGS IN THE SOFTWARE.
+   ----------------------------------------------------------------------- */
+
+/* The calling convention, as the C33 port of GCC makes calls:
+
+   - Arguments take 4-byte slots in %r6-%r9, in order, each starting at the
+     next free word.  An 8-byte value may start in %r9 and run on into %r10
+     (and a 16-byte complex into %r12), except a double: one that would
+     start in %r9 goes on the stack and takes no slot, so a later word still
+     gets %r9.  What finds no slot goes on the stack, in order, each item
+     word-aligned and padded to a word.
+   - An aggregate GCC gives a scalar machine mode (size 1, 2, 4 or 8, and
+     aligned at least as that integer, to at most a word) travels as that
+     scalar; one with a lone double, nested or not, is a double.  Any other
+     aggregate is copied onto the stack and takes no slot.
+   - A call to a variadic function treats its last named argument as
+     unnamed too, and every unnamed argument goes on the stack, in order,
+     where va_arg finds it, and in no register.  That holds for a call
+     passing no unnamed argument at all: the last named one is still on
+     the stack.
+   - A value comes back in %r4, or %r4:%r5 for 8 bytes.  Anything larger,
+     and an aggregate without a scalar mode, is returned to memory whose
+     address is passed as a hidden first argument, in %r6.
+   - %r0-%r3 are the callee's to preserve; %r15 is FDPIC's data pointer,
+     which the caller restores.  */
+
+#include <ffi.h>
+#include <ffi_common.h>
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* regs[0] is %r5, regs[1..7] are %r6-%r12; ffi_call_SYSV leaves %r4 and
+   %r5 as they came back in regs[8] and regs[9].  No call passes anything
+   in %r5, which stays zero.  */
+extern void ffi_call_SYSV (void *stack, unsigned bytes, unsigned *regs,
+			   void (*fn) (void)) FFI_HIDDEN;
+
+enum
+{
+  C33_ARG_STACK,		/* an aggregate without a scalar mode */
+  C33_ARG_WORDS,		/* a scalar, or an aggregate passed as one */
+  C33_ARG_DOUBLE		/* a double, or an aggregate of one */
+};
+
+/* cif->flags: how the value comes back, and whether ffi_prep_cif_var made
+   the cif, which makes every call through it variadic, even one with no
+   unnamed argument.  */
+enum
+{
+  C33_RET_VOID,
+  C33_RET_REGS,
+  C33_RET_MEMORY,
+  C33_RET_MASK = 3,
+  C33_VARIADIC = 4
+};
+
+/* Whether an aggregate holds a single double, at any depth, which GCC
+   gives DFmode.  */
+static int
+c33_lone_double (const ffi_type *t)
+{
+  while (t->type == FFI_TYPE_STRUCT)
+    {
+      if (t->elements[0] == NULL || t->elements[1] != NULL)
+	return 0;
+      t = t->elements[0];
+    }
+  return t->type == FFI_TYPE_DOUBLE || t->type == FFI_TYPE_LONGDOUBLE;
+}
+
+static int
+c33_classify (const ffi_type *t)
+{
+  size_t need;
+
+  switch (t->type)
+    {
+    case FFI_TYPE_DOUBLE:
+#if FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE
+    case FFI_TYPE_LONGDOUBLE:
+#endif
+      return C33_ARG_DOUBLE;
+    case FFI_TYPE_STRUCT:
+      /* STRICT_ALIGNMENT: the mode's alignment, a word at most, must not
+	 exceed the aggregate's.  */
+      need = t->size < 4 ? t->size : 4;
+      if ((t->size != 1 && t->size != 2 && t->size != 4 && t->size != 8)
+	  || t->alignment < need)
+	return C33_ARG_STACK;
+      return c33_lone_double (t) ? C33_ARG_DOUBLE : C33_ARG_WORDS;
+    default:
+      return C33_ARG_WORDS;
+    }
+}
+
+static unsigned
+c33_round (size_t size)
+{
+  return (size + 3) & ~3u;
+}
+
+ffi_status FFI_HIDDEN
+ffi_prep_cif_machdep (ffi_cif *cif)
+{
+  const ffi_type *r = cif->rtype;
+  unsigned bytes = 0;
+  unsigned i;
+
+  if (r->type == FFI_TYPE_VOID)
+    cif->flags = C33_RET_VOID;
+  else if (r->size > 8
+	   || (r->type == FFI_TYPE_STRUCT
+	       && c33_classify (r) == C33_ARG_STACK))
+    cif->flags = C33_RET_MEMORY;
+  else
+    cif->flags = C33_RET_REGS;
+
+  /* At most every argument on the stack.  */
+  for (i = 0; i < cif->nargs; i++)
+    bytes += c33_round (cif->arg_types[i]->size);
+  cif->bytes = bytes;
+  cif->nfixedargs = cif->nargs;
+  return FFI_OK;
+}
+
+ffi_status FFI_HIDDEN
+ffi_prep_cif_machdep_var (ffi_cif *cif, unsigned nfixedargs,
+			  unsigned ntotalargs __attribute__ ((unused)))
+{
+  ffi_status status = ffi_prep_cif_machdep (cif);
+
+  cif->flags |= C33_VARIADIC;
+  cif->nfixedargs = nfixedargs;
+  return status;
+}
+
+/* A scalar's words, widened to a word if it is narrower.  */
+static void
+c33_words (const ffi_type *t, const void *value, unsigned *w)
+{
+  memset (w, 0, 4 * sizeof (*w));
+  switch (t->type)
+    {
+    case FFI_TYPE_SINT8:
+      w[0] = (unsigned) (int) *(const int8_t *) value;
+      break;
+    case FFI_TYPE_UINT8:
+      w[0] = *(const uint8_t *) value;
+      break;
+    case FFI_TYPE_SINT16:
+      w[0] = (unsigned) (int) *(const int16_t *) value;
+      break;
+    case FFI_TYPE_UINT16:
+      w[0] = *(const uint16_t *) value;
+      break;
+    default:
+      memcpy (w, value, t->size);
+      break;
+    }
+}
+
+void
+ffi_call (ffi_cif *cif, void (*fn) (void), void *rvalue, void **avalue)
+{
+  unsigned regs[10] = { 0 };
+  unsigned nbytes = 0, stack_bytes = 0;
+  int variadic = (cif->flags & C33_VARIADIC) != 0;
+  /* GCC treats a variadic call's last named argument as unnamed.  */
+  unsigned named = variadic && cif->nfixedargs > 0
+		   ? cif->nfixedargs - 1 : cif->nfixedargs;
+  char *stack = alloca (cif->bytes + 4);
+  void *result = rvalue;
+  unsigned i;
+
+  if ((cif->flags & C33_RET_MASK) == C33_RET_MEMORY)
+    {
+      if (result == NULL)
+	result = alloca (cif->rtype->size);
+      regs[1] = (unsigned) (uintptr_t) result;
+      nbytes = 4;
+    }
+
+  for (i = 0; i < cif->nargs; i++)
+    {
+      const ffi_type *t = cif->arg_types[i];
+      int kind = c33_classify (t);
+      unsigned words = c33_round (t->size) / 4;
+      int unnamed = i >= named;
+      int skips = kind == C33_ARG_DOUBLE && nbytes >= 12;
+      int reg = !unnamed && kind != C33_ARG_STACK && nbytes < 16 && !skips;
+      unsigned w[4];
+
+      if (kind == C33_ARG_STACK)
+	{
+	  memcpy (stack + stack_bytes, avalue[i], t->size);
+	  memset (stack + stack_bytes + t->size, 0,
+		  c33_round (t->size) - t->size);
+	  stack_bytes += c33_round (t->size);
+	}
+      else
+	{
+	  c33_words (t, avalue[i], w);
+	  if (reg)
+	    memcpy (&regs[1 + nbytes / 4], w, words * 4);
+	  else
+	    {
+	      memcpy (stack + stack_bytes, w, words * 4);
+	      stack_bytes += words * 4;
+	    }
+	}
+
+      if (kind == C33_ARG_STACK || skips)
+	continue;
+      nbytes += words * 4;
+    }
+
+  ffi_call_SYSV (stack, stack_bytes, regs, fn);
+
+  if ((cif->flags & C33_RET_MASK) != C33_RET_REGS || rvalue == NULL)
+    return;
+  switch (cif->rtype->type)
+    {
+    case FFI_TYPE_SINT8:
+      *(ffi_sarg *) rvalue = (int8_t) regs[8];
+      break;
+    case FFI_TYPE_UINT8:
+      *(ffi_arg *) rvalue = (uint8_t) regs[8];
+      break;
+    case FFI_TYPE_SINT16:
+      *(ffi_sarg *) rvalue = (int16_t) regs[8];
+      break;
+    case FFI_TYPE_UINT16:
+      *(ffi_arg *) rvalue = (uint16_t) regs[8];
+      break;
+    default:
+      memcpy (rvalue, &regs[8], cif->rtype->size);
+      break;
+    }
+}
