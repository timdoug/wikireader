diff --git a/src/linux/c33/raw_syscall.h b/src/linux/c33/raw_syscall.h
new file mode 100644
index 0000000..3fe902a
--- /dev/null
+++ b/src/linux/c33/raw_syscall.h
@@ -0,0 +1,25 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#ifndef STRACE_RAW_SYSCALL_H
+# define STRACE_RAW_SYSCALL_H
+
+# include "kernel_types.h"
+
+/* int 0 takes the number in r4 and returns the result there. */
+static inline kernel_ulong_t
+raw_syscall_0(const kernel_ulong_t nr, kernel_ulong_t *err)
+{
+	register kernel_ulong_t r4 __asm__("r4") = nr;
+	asm volatile("int 0" : "+r"(r4) : : "memory");
+
+	*err = 0;
+	return r4;
+}
+# define raw_syscall_0 raw_syscall_0
+
+#endif /* !STRACE_RAW_SYSCALL_H */
diff --git a/src/linux/c33/set_error.c b/src/linux/c33/set_error.c
new file mode 100644
index 0000000..114adb6
--- /dev/null
+++ b/src/linux/c33/set_error.c
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_set_error(struct tcb *tcp)
+{
+	c33_regs.r[4] = -tcp->u_error;
+	return set_regs(tcp->pid);
+}
+
+static int
+arch_set_success(struct tcb *tcp)
+{
+	c33_regs.r[4] = tcp->u_rval;
+	return set_regs(tcp->pid);
+}
diff --git a/src/linux/c33/set_scno.c b/src/linux/c33/set_scno.c
new file mode 100644
index 0000000..855d96a
--- /dev/null
+++ b/src/linux/c33/set_scno.c
@@ -0,0 +1,15 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_set_scno(struct tcb *tcp, kernel_ulong_t scno)
+{
+	if (ptrace_syscall_info_is_valid() && get_regs(tcp) < 0)
+		return -1;
+	c33_regs.orig_r4 = scno;
+	return set_regs(tcp->pid);
+}
