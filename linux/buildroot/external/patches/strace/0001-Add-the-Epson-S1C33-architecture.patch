diff --git a/src/strace.c b/src/strace.c
index fcd3aa8..f767f15 100644
--- a/src/strace.c
+++ b/src/strace.c
@@ -1934,7 +1934,7 @@ startup_child(char **argv, char **env)
 		}
 		tcp = alloctcb(pid);
 		after_successful_attach(tcp, TCB_SKIP_DETACH_ON_FIRST_EXEC
-					     | (NOMMU_SYSTEM ? 0
+					     | (NOMMU_SYSTEM ? post_attach_sigstop
 						: (TCB_HIDE_LOG
 						   | post_attach_sigstop)));
 	} else {
@@ -3159,7 +3159,13 @@ init(int argc, char *argv[])
 	}
 
 	debug_msg("ptrace_setoptions = %#x", ptrace_setoptions);
-	test_ptrace_seize();
+	/*
+	 * Without an MMU the tracee is started by vfork, and a seizing tracer
+	 * can attach only once its exec is under way, by which time it may
+	 * have run.  PTRACE_TRACEME before the exec stops it there instead.
+	 */
+	if (!NOMMU_SYSTEM)
+		test_ptrace_seize();
 	if (inject_set)
 		test_ptrace_set_syscall_info();
 	test_ptrace_get_syscall_info();
@@ -3930,7 +3936,12 @@ next_event(void)
 				 * than SIGSTOP if we happened to attach
 				 * just before the process takes a signal.
 				 */
-				if (sig == SIGSTOP &&
+				/*
+				 * Without an MMU, a PTRACE_TRACEME child
+				 * first stops with the SIGTRAP of its exec.
+				 */
+				if ((sig == SIGSTOP ||
+				     (NOMMU_SYSTEM && sig == SIGTRAP)) &&
 				    (tcp->flags & TCB_IGNORE_ONE_SIGSTOP)) {
 					debug_func_msg("ignored SIGSTOP on "
 						       "pid %d", tcp->pid);
