diff --git a/src/linux/c33/get_error.c b/src/linux/c33/get_error.c
new file mode 100644
index 0000000..6b7ff88
--- /dev/null
+++ b/src/linux/c33/get_error.c
@@ -0,0 +1,18 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include "negated_errno.h"
+
+static void
+arch_get_error(struct tcb *tcp, const bool check_errno)
+{
+	if (check_errno && is_negated_errno(c33_regs.r[4])) {
+		tcp->u_rval = -1;
+		tcp->u_error = -c33_regs.r[4];
+	} else {
+		tcp->u_rval = c33_regs.r[4];
+	}
+}
diff --git a/src/linux/c33/get_scno.c b/src/linux/c33/get_scno.c
new file mode 100644
index 0000000..8210067
--- /dev/null
+++ b/src/linux/c33/get_scno.c
@@ -0,0 +1,14 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Return codes: 1 - ok, 0 - ignore, other - error. */
+static int
+arch_get_scno(struct tcb *tcp)
+{
+	tcp->scno = c33_regs.orig_r4;
+	return 1;
+}
diff --git a/src/linux/c33/get_syscall_args.c b/src/linux/c33/get_syscall_args.c
new file mode 100644
index 0000000..be63923
--- /dev/null
+++ b/src/linux/c33/get_syscall_args.c
@@ -0,0 +1,15 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Return -1 on error or 1 on success (never 0!). */
+static int
+arch_get_syscall_args(struct tcb *tcp)
+{
+	for (unsigned int i = 0; i < 6; ++i)
+		tcp->u_arg[i] = c33_regs.r[6 + i];
+	return 1;
+}
