From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] xfree86: run modprobe through vfork() where there is no fork()

A uClibc system without an MMU has no fork(), so the server did not link.
The child only resets its IDs and execs modprobe, which vfork() allows,
given the environment as execle()'s argument rather than by setenv(),
which would change the parent's.

Signed-off-by: Tim Douglas <me@timdoug.com>
Upstream: N/A no-MMU uClibc
---
--- a/hw/xfree86/os-support/linux/lnx_kmod.c
+++ b/hw/xfree86/os-support/linux/lnx_kmod.c
@@ -66,20 +66,25 @@
      * to the log file.  modprobe errors currently are missing from the log
      * file.
      */
+#if defined(__UCLIBC__) && !defined(__ARCH_USE_MMU__)
+    /* No fork() without an MMU; the child below only execs, as vfork()'s
+       may, and leaves the parent's memory as it was. */
+    switch (pid = vfork()) {
+#else
     switch (pid = fork()) {
+#endif
     case 0:                    /* child */
+    {
+        static char *const env[] = { "PATH=/sbin", NULL };
+
         /* change real/effective user ID to 0/0 as we need to
          * preinstall agpgart module for some DRM modules
          */
-        if (setreuid(0, 0)) {
-            xf86Msg(X_WARNING, "LoadKernelModule: "
-                    "Setting of real/effective user Id to 0/0 failed");
-        }
-        setenv("PATH", "/sbin", 1);
-        execl(mpPath, "modprobe", modName, NULL);
-        xf86Msg(X_WARNING, "LoadKernelModule %s\n", strerror(errno));
-        exit(EXIT_FAILURE);     /* if we get here the child's exec failed */
+        setreuid(0, 0);
+        execle(mpPath, "modprobe", modName, (char *) NULL, env);
+        _exit(EXIT_FAILURE);    /* if we get here the child's exec failed */
         break;
+    }
     case -1:                   /* fork failed */
         return 0;
     default:                   /* fork worked */
