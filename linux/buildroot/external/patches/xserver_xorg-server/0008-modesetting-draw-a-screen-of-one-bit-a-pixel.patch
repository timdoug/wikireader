+/*
+ * A framebuffer of one bit a pixel keeps the leftmost pixel of a byte in its
+ * most significant bit, where X on a little-endian machine keeps it in the
+ * least, and DRM_FORMAT_D1 calls 1 dark where X's StaticGray calls it white.
+ * The shadow's damaged bytes are copied through a table that makes both
+ * right.
+ */
+static void
+msMonoTable(modesettingPtr ms)
+{
+    int i, j;
+
+    for (i = 0; i < 256; i++) {
+        CARD8 v = i;
+
+        if (BITMAP_BIT_ORDER == LSBFirst)
+            for (v = 0, j = 0; j < 8; j++)
+                if (i & (1 << j))
+                    v |= 0x80 >> j;
+        ms->mono[i] = ~v;
+    }
+}
+
+static void
+msUpdateMono(ScreenPtr pScreen, shadowBufPtr pBuf)
+{
+    ScrnInfoPtr pScrn = xf86ScreenToScrn(pScreen);
+    modesettingPtr ms = modesettingPTR(pScrn);
+    RegionPtr damage = DamageRegion(pBuf->pDamage);
+    PixmapPtr pShadow = pBuf->pPixmap;
+    int nbox = RegionNumRects(damage);
+    BoxPtr pbox = RegionRects(damage);
+    int pitch = drmmode_bo_get_pitch(&ms->drmmode.front_bo);
+    CARD8 *front = ms->drmmode.front_bo.dumb->ptr;
+    FbBits *shaBase;
+    FbStride shaStride;
+    int shaBpp;
+    _X_UNUSED int shaXoff, shaYoff;
+
+    fbGetDrawable(&pShadow->drawable, shaBase, shaStride, shaBpp, shaXoff,
+                  shaYoff);
+    for (; nbox--; pbox++) {
+        int first = pbox->x1 >> 3, end = (pbox->x2 + 7) >> 3, y, i;
+
+        for (y = pbox->y1; y < pbox->y2; y++) {
+            const CARD8 *sha = (const CARD8 *) (shaBase + y * shaStride) +
+                first;
+            CARD8 *scr = front + y * pitch + first;
+
+            for (i = first; i < end; i++)
+                *scr++ = ms->mono[*sha++];
+        }
+    }
+}
+
 static void
 msUpdatePacked(ScreenPtr pScreen, shadowBufPtr pBuf)
 {
@@ -1621,8 +1689,9 @@
