From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] Add the 5x8 built-in Unicode font

Add the public-domain X.Org 5x8 ISO10646-1 font alongside fixed
and cursor. The tiny font covers Latin, Greek, Cyrillic and symbols
through U+28FF, with a replacement bitmap as its default glyph.
This bounds the dense core-font metrics reply on a NOMMU system.
without font-file readers or FreeType. Regenerate its PCF with
linux/console/make-xfont.py and the pinned font-misc-misc archive.

Signed-off-by: Tim Douglas <me@timdoug.com>
Upstream: N/A a built-in font for the WikiReader

diff --git a/src/builtins/fonts.c b/src/builtins/fonts.c
--- a/src/builtins/fonts.c
+++ b/src/builtins/fonts.c
@@ -26,6 +26,7 @@
 #endif
 #include "libxfontint.h"
 #include "builtin.h"
+#include "font-5x8.h"
 
 static const char file_cursor[] = {
     '\037', '\213', '\010', '\010', '\143', '\117', '\054', '\100',
@@ -1225,8 +1226,10 @@
 
 static char name_6x13[] = "-misc-fixed-medium-r-semicondensed--13-120-75-75-c-60-iso8859-1";
 static char name_cursor[] = "cursor";
+static char name_5x8[] = "-misc-fixed-medium-r-normal--8-80-75-75-c-50-iso10646-1";
 
 const BuiltinFileRec builtin_files[] = {
+ { "5x8.builtin", sizeof file_5x8, file_5x8, },
  { "6x13.builtin", sizeof file_6x13, file_6x13, },
  { "cursor.builtin", sizeof file_cursor, file_cursor, }
 };
@@ -1234,17 +1237,23 @@
