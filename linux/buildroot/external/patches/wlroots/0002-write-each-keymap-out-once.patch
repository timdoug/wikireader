From: Tim Douglas <me@timdoug.com>
Subject: [PATCH] Write each keymap out once, and know it when it comes back

wlr_keyboard_set_keymap() writes the keymap out as text for clients, and
a compositor usually gives all its keyboards one keymap, and a keyboard
group the keymap of its devices, so the same text was written for each.
A virtual keyboard's client, which must send a keymap, may send back the
very text the compositor gave it, and that was compiled again.  On a slow
machine each takes a second or more.  The text of the last keymap written
is kept, with a reference to the keymap: it is copied for the next
keyboard given that keymap, and a virtual keyboard sent that text gets
that keymap.

Signed-off-by: Tim Douglas <me@timdoug.com>
Upstream: not submitted

--- a/types/wlr_keyboard.c
+++ b/types/wlr_keyboard.c
@@ -187,6 +187,44 @@
 	}
 }
 
+/*
+ * The last keymap written out as text, and the text, kept for the next
+ * keyboard given the same keymap: a compositor gives most of its keyboards
+ * one, keyboard groups take their devices', and a virtual keyboard's client
+ * may send back the text it was given.  Writing a keymap out or compiling
+ * one takes long on a slow machine.  The reference keeps the keymap from
+ * being freed and another taking its address.
+ */
+static struct {
+	struct xkb_keymap *keymap;
+	char *text;
+} last_keymap;
+
+static char *keymap_text(struct xkb_keymap *keymap) {
+	if (last_keymap.keymap != keymap) {
+		char *text = xkb_keymap_get_as_string(keymap, XKB_KEYMAP_FORMAT_TEXT_V1);
+		if (text == NULL) {
+			return NULL;
+		}
+		xkb_keymap_unref(last_keymap.keymap);
+		free(last_keymap.text);
+		last_keymap.keymap = xkb_keymap_ref(keymap);
+		last_keymap.text = text;
+	}
+	return strdup(last_keymap.text);
+}
+
+struct xkb_keymap *keyboard_keymap_from_text(struct xkb_context *context,
+		const char *text, size_t size) {
+	size_t len = strnlen(text, size);
+	if (last_keymap.text != NULL && len == strlen(last_keymap.text) &&
+			memcmp(text, last_keymap.text, len) == 0) {
+		return xkb_keymap_ref(last_keymap.keymap);
+	}
+	return xkb_keymap_new_from_buffer(context, text, len,
+		XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS);
+}
+
 bool wlr_keyboard_set_keymap(struct wlr_keyboard *kb, struct xkb_keymap *keymap) {
 	if (keymap == NULL) {
 		keyboard_unset_keymap(kb);
@@ -200,7 +238,7 @@
 		return false;
 	}
 
-	char *keymap_str = xkb_keymap_get_as_string(keymap, XKB_KEYMAP_FORMAT_TEXT_V1);
+	char *keymap_str = keymap_text(keymap);
 	if (keymap_str == NULL) {
 		wlr_log(WLR_ERROR, "Failed to get string version of keymap");
 		goto error_xkb_state;
--- a/include/types/wlr_keyboard.h
+++ b/include/types/wlr_keyboard.h
@@ -6,3 +6,8 @@
 bool keyboard_modifier_update(struct wlr_keyboard *keyboard);
 
 void keyboard_led_update(struct wlr_keyboard *keyboard);
+
+/* The keymap with this text: the last one written out, if this is its text,
+ * or else compiled from it.  A new reference. */
+struct xkb_keymap *keyboard_keymap_from_text(struct xkb_context *context,
+	const char *text, size_t size);
