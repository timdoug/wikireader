BR2_c33=y
BR2_OPTIMIZE_S=y
BR2_ENABLE_DEBUG=y
BR2_DEBUG_2=y
# Every program and library keeps only the functions and data it reaches,
# and loads from the card at about 1.4 MB/s.
BR2_TARGET_OPTIMIZATION="-ffunction-sections -fdata-sections"
BR2_TARGET_LDFLAGS="-Wl,--gc-sections"
# RELRO would link everything -z now: without an MMU there is nothing to
# protect, and ld.so would bind each .plt descriptor at every exec rather
# than at its first call.
BR2_RELRO_NONE=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_WIKIREADER_PATH)/patches"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(HOME)/wr-linux/toolchain/install"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="c33-linux-uclibc"
BR2_TOOLCHAIN_EXTERNAL_GCC_16=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_7_1=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS=y
# BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG is not set
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_NPTL=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y
BR2_BINFMT_FDPIC=y
BR2_SHARED_LIBS=y
# BR2_STRIP_strip is not set
BR2_TARGET_GENERIC_HOSTNAME="wikireader"
BR2_TARGET_GENERIC_ISSUE="WikiReader C33 Linux"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_GENERIC_GETTY is not set
# rcS is the WikiReader's own and runs no S* scripts.
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_WIKIREADER_PATH)/board/wikireader/busybox.config"
BR2_PACKAGE_WIKIREADER_SYSTEM=y
BR2_PACKAGE_WR_CONSOLE=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# The WikiReader's boot partition is only 64 MB.
BR2_TARGET_ROOTFS_EXT2_SIZE="16M"
BR2_TARGET_ROOTFS_EXT2_LABEL="wikireader"
# No metadata checksums: a software CRC32C over every metadata block is
# too dear on this CPU.  4 KB blocks, a page each, where the image's size
# alone would get 1 KB ones and four times the I/O requests.  No orphan
# file: mounting reads its 32 blocks one at a time, 0.3 s of every boot;
# orphans then go in the superblock's list, as before ext4 had the file.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-b 4096 -O ^64bit,^metadata_csum,^orphan_file"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_SL=y
# X11: the kdrive server on the framebuffer (startx starts it), twm and xeyes.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_KDRIVE=y
# The server shows only its built-in fonts: no FreeType or font-file readers.
BR2_PACKAGE_XLIB_LIBXFONT2_BUILTIN_FONTS_ONLY=y
BR2_PACKAGE_XAPP_XEYES=y
BR2_PACKAGE_XAPP_TWM=y
