#
# twm on the WikiReader's 240x208 one-bit panel, driven by touch: a touch is
# the first button.  Dragging on the background moves the pointer; holding
# still there for a moment opens the menu (patches/xapp_twm), and holding on
# a title bar moves the window.  The server has only its built-in fonts.
#

NoGrabServer
DecorateTransients
RandomPlacement
TitleFont "fixed"
ResizeFont "fixed"
MenuFont "fixed"
IconFont "fixed"
IconManagerFont "fixed"
BorderWidth 1

MoveDelta 3
Function "move-or-raise" { f.move f.deltastop f.raise }

Button1 = : root : f.menu "session"
Button1 = : title : f.function "move-or-raise"
Button1 = : icon : f.iconify

# No separators: the menu has to fit in 208 pixels.
menu "session"
{
"Twm"		f.title
"Xeyes"		f.exec "exec xeyes &"
"Move"		f.move
"Resize"	f.resize
"Raise"		f.raise
"Lower"		f.lower
"Iconify"	f.iconify
"Kill"		f.destroy
"Delete"	f.delete
"Exit"		f.quit
}
