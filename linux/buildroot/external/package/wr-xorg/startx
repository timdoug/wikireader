#!/bin/sh
# startx [CLIENT [ARGS...]] [-- SERVER-ARGS...]: start the X server on the
# panel, the touchscreen and the buttons, run CLIENT on it, and stop the
# server when CLIENT exits, which gives the panel back to the console.  With
# no CLIENT the session is twm, xeyes, and an interactive xterm with the
# on-screen keyboard below it, typing into it; twm's Exit ends it.

# Split at --: what follows goes to the server, what precedes is the client.
server=
found=
for arg; do
	shift
	if [ -z "$found" ] && [ "$arg" = "--" ]; then
		found=1
	elif [ -n "$found" ]; then
		server="$server $arg"
	else
		set -- "$@" "$arg"
	fi
done
[ $# -gt 0 ] ||
	set -- sh -c 'xeyes -geometry 64x48+172+0 &
		WR_XTERM_KEYBOARD=1 xterm -fn 5x8 -geometry 32x12+0+0 -T sh &
		exec twm -f /usr/share/X11/twm/wikireader.twmrc'
# Builtins only: every exec, and every $(...), costs a tenth of a second.
for n in 0 1 2 3 4 5 6 7; do
	# The error redirection goes first: hush applies them in order.
	read -r name 2>/dev/null < /sys/class/input/event$n/device/name || continue
	case $name in
	"WikiReader touchscreen") touch=/dev/input/event$n ;;
	"WikiReader buttons") buttons=/dev/input/event$n ;;
	esac
done
# /tmp is on the card, so a session the power switch ended leaves these.
rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock
# -noreset: the server lives exactly as long as this script wants it.
# -retro: the classic grey weave and X-shaped cursor.
# -dumbSched: no 20 ms SIGALRM timer to share the server between clients.
# -schedInterval/-schedMax: a client's requests run for up to 100 ms before
# the server turns to others.  The 5-15 ms default suits a fast machine;
# here one arc takes milliseconds, the slice ran out partway through a
# redraw, and the idle handler showed the half-drawn frame on the panel.
# Xorg, through the fbdev driver and evdev, configured here: there is
# no udev to find the devices.
{
	echo 'Section "ServerFlags"'
	echo '	Option "AutoAddDevices" "false"'
	echo '	Option "BlankTime" "0"'
	echo 'EndSection'
	echo 'Section "Device"'
	echo '	Identifier "panel"'
	echo '	Driver "fbdev"'
	echo '	Option "fbdev" "/dev/fb0"'
	echo 'EndSection'
	echo 'Section "Screen"'
	echo '	Identifier "screen"'
	echo '	Device "panel"'
	echo '	DefaultDepth 1'
	echo 'EndSection'
	for d in ${touch:+touch:$touch} ${buttons:+buttons:$buttons}; do
		echo 'Section "InputDevice"'
		echo "	Identifier \"${d%%:*}\""
		echo '	Driver "evdev"'
		echo "	Option \"Device\" \"${d#*:}\""
		echo 'EndSection'
	done
	echo 'Section "ServerLayout"'
	echo '	Identifier "layout"'
	echo '	Screen "screen"'
	[ -n "$touch" ] && echo '	InputDevice "touch" "CorePointer"'
	[ -n "$buttons" ] && echo '	InputDevice "buttons" "CoreKeyboard"'
	echo 'EndSection'
} > /tmp/xorg.conf
Xorg :0 -config /tmp/xorg.conf -logfile /tmp/Xorg.0.log -noreset -retro \
	-dumbSched -schedInterval 100 -schedMax 100 $server 2>/tmp/Xorg.log &
server=$!
while [ ! -S /tmp/.X11-unix/X0 ]; do
	if ! kill -0 $server 2>/dev/null; then
		echo "startx: the X server stopped; see /tmp/Xorg.log and /tmp/Xorg.0.log" >&2
		exit 1
	fi
	sleep 1
done
DISPLAY=:0 "$@"
status=$?
kill $server
wait $server
exit $status
