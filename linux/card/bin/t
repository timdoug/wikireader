#!/bin/sh
# Native TLS/threading checks and startup timings; keep the output on the card.
out=/mnt/sd/thread.txt
echo "Testing threads and startup..."
export LD_LIBRARY_PATH=/mnt/sd
# Run a strace check; when it fails, name it and keep its log.
strace_check() {
	name=$1 log=$2
	shift 2
	"$@" && return
	echo "STRACE FAIL: $name" >&2
	cat "$log" >&2
	return 1
}
{
	/mnt/sd/nptl.bin &&
	/mnt/sd/pthtest.bin &&
	/mnt/sd/pthstat.bin &&
	echo "STATIC PTHREAD PASS" &&
	/mnt/sd/atomtest.bin &&
	/mnt/sd/ipctest.bin &&
	/mnt/sd/cxxtest.bin &&
	/mnt/sd/bench.bin --single &&
	/mnt/sd/cxxtest.bin --bench &&
	# strace: a program traced from its first call, a call decoded, a
	# result injected, and the children of a pipeline followed.
	strace_check run /tmp/st.log strace -o /tmp/st.log cat /etc/hostname >/dev/null &&
	strace_check first-call /tmp/st.log sh -c "head -1 /tmp/st.log | grep -q '^c33_set_tls('" &&
	strace_check decode /tmp/st.log grep -qF 'openat(AT_FDCWD, "/etc/hostname", O_RDONLY|O_LARGEFILE) = 3' /tmp/st.log &&
	{ pid=$(strace -o /tmp/si.log -e trace=getpid -e inject=getpid:retval=4242 sh -c 'echo $$'); st=$?; } &&
	strace_check "inject (exit $st, got $pid)" /tmp/si.log test "$st:$pid" = 0:4242 &&
	strace_check follow-run /tmp/sf.log strace -f -o /tmp/sf.log -e trace=execve sh -c 'echo hi | cat' >/dev/null &&
	strace_check follow /tmp/sf.log test "$(grep -c 'execve(' /tmp/sf.log)" -ge 2 &&
	echo "STRACE PASS"
} > "$out" 2>&1
status=$?
sync
if [ "$status" -eq 0 ]; then
	echo "PASS (thread.txt)"
else
	echo "FAIL (thread.txt)"
fi
exit "$status"
