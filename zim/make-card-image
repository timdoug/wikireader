#!/bin/sh
# Build a dual-volume WikiReader disk image for the ZIM reader.

set -eu

usage()
{
	cat <<EOF
usage: $(basename "$0") OUTPUT.dmg [--wiki DIR]... [--sparrow FILE] [--nuttx] ZIM_FILE...
       $(basename "$0") ZIM_FILE OUTPUT.dmg

Create an MBR disk image with:
  partition 1: 64 MiB FAT32 boot volume with the stock card contents plus
               zim.app and its icon; init.ini lists zim.app and wiki.app,
               so the launcher offers both at power on
  partition 2: exFAT volume containing every ZIM_FILE under its own name

--wiki DIR copies a native WikiReader data set (a folder such as enpedia or
enquote holding wiki.idx, wiki.fnd, wiki*.dat, ...) onto the boot volume,
which grows to hold it, so the stock wiki.app in the launcher has something to
open.  The folder name must be one listed in ROOT_IMAGE/wiki.inf.

With several archives the reader offers a choice through the keyboard's globe
key and remembers the selection.

--sparrow FILE installs a generated question index as sparrow.dat on exFAT.

--nuttx adds nuttx.app to the launcher: NuttX with a shell, an editor and a C
compiler on the device itself.  Build it with "make nuttx" first.  It cannot
read the card, so it does not need one, and it keeps the machine until
"poweroff" or "reboot" stops it.

The current GCC 16 Grifo kernel, init application, and zim.app must already
be built. This command is for macOS and requires hdiutil and diskutil.
EOF
	exit "${1:-0}"
}

[ "$#" -ge 2 ] || usage 2

case "$1" in
	*.dmg) output=$1; shift ;;
	*) zim_first=$1; output=$2; shift 2; set -- "$zim_first" "$@" ;;
esac
# Separate --wiki DIR pairs from the archives (one directory per line).
native_dirs=
native_bytes=0
zim_files=
sparrow_data=
for arg in "$@"; do
	if [ -n "${want_sparrow:-}" ]; then
		[ -f "$arg" ] || { echo "error: Sparrow index not found: $arg" >&2; exit 2; }
		sparrow_data=$arg
		want_sparrow=
	elif [ "$arg" = "--sparrow" ] && [ -z "${want_dir:-}" ]; then
		[ -z "$sparrow_data" ] || { echo "error: duplicate --sparrow" >&2; exit 2; }
		want_sparrow=1
	elif [ -n "${want_dir:-}" ]; then
		[ -d "$arg" ] && [ -f "$arg/wiki.idx" ] || {
			echo "error: --wiki $arg is not a native data set directory" >&2
			exit 2
		}
		native_dirs="${native_dirs}${arg}
"
		native_bytes=$(( native_bytes + $(du -sk "$arg" | cut -f1) * 1024 ))
		want_dir=
	elif [ "$arg" = "--wiki" ]; then
		want_dir=1
	elif [ "$arg" = "--nuttx" ]; then
		want_nuttx=1
	else
		zim_files="${zim_files}${arg}
"
	fi
done
[ -z "${want_dir:-}" ] || usage 2
[ -z "${want_sparrow:-}" ] || usage 2
set --
old_ifs=$IFS
IFS='
'
for zim_file in $zim_files; do
	set -- "$@" "$zim_file"
done
IFS=$old_ifs
[ "$#" -ge 1 ] || usage 2
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root_dir=$(dirname -- "$script_dir")
kernel="$root_dir/samo-lib/grifo/grifo.elf"
init_app="$root_dir/samo-lib/grifo/applications/init/init.app"
zim_app="$root_dir/zim/zim.app"
zim_icon="$root_dir/zim/zim.ico"
nuttx_app="$root_dir/nuttx/nuttx.app"
nuttx_icon="$root_dir/nuttx/nuttx.ico"
nls="$root_dir/XML-Licenses/en/wiki.nls"

case "$output" in
	*.dmg) ;;
	*) echo "error: output name must end in .dmg" >&2; exit 2 ;;
esac

for zim_file in "$@"; do
	[ -f "$zim_file" ] || { echo "error: ZIM not found: $zim_file" >&2; exit 2; }
done
[ ! -e "$output" ] || { echo "error: output already exists: $output" >&2; exit 2; }
required_files="$kernel $init_app $zim_app $zim_icon $nls"
[ -z "${want_nuttx:-}" ] || required_files="$required_files $nuttx_app $nuttx_icon"
for required in $required_files; do
	[ -f "$required" ] || {
		echo "error: required build output not found: $required" >&2
		exit 2
	}
done

command -v hdiutil >/dev/null 2>&1 || {
	echo "error: hdiutil is required (macOS only)" >&2
	exit 2
}
command -v diskutil >/dev/null 2>&1 || {
	echo "error: diskutil is required (macOS only)" >&2
	exit 2
}

zim_bytes=0
[ -z "$sparrow_data" ] || zim_bytes=$(stat -f %z "$sparrow_data")
for zim_file in "$@"; do
	zim_bytes=$(( zim_bytes + $(stat -f %z "$zim_file") ))
done
# The boot partition holds the stock files, the apps, and any native data
# sets; the 64 MiB floor leaves room for history and settings.
boot_mib=$(( 64 + (native_bytes + native_bytes / 20 + 1024 * 1024 - 1) / (1024 * 1024) ))
# Add ample exFAT metadata and copy slack for the archives.
image_mib=$(( boot_mib + (zim_bytes + 192 * 1024 * 1024 + 1024 * 1024 - 1) / (1024 * 1024) ))
boot_label="WRBOOT$$"
content_label="WRZIM$$"
device=

detach_image()
{
	if [ -n "$device" ]; then
		hdiutil detach "$device" >/dev/null 2>&1 || true
		device=
	fi
}
trap detach_image 0
trap 'exit 1' HUP INT TERM

echo "Creating ${image_mib} MiB image..."
hdiutil create -size "${image_mib}m" -layout MBRSPUD -fs ExFAT \
	-volname "$content_label" -type UDIF -o "$output" >/dev/null

attach_output=$(hdiutil attach -nomount "$output")
device=$(printf '%s\n' "$attach_output" | awk 'NR == 1 { print $1 }')
case "$device" in
	/dev/disk[0-9]*) ;;
	*) echo "error: could not identify attached disk image" >&2; exit 1 ;;
esac

# Never pass an unverified host disk to partitionDisk.
disk_info=$(diskutil info "$device")
printf '%s\n' "$disk_info" | grep -Eq 'Device / Media Name: +Disk Image$' || {
	echo "error: attached device is not identified as a disk image: $device" >&2
	exit 1
}
printf '%s\n' "$disk_info" | grep -Eq 'Virtual: +Yes$' || {
	echo "error: attached device is not virtual: $device" >&2
	exit 1
}

echo "Partitioning $device..."
diskutil partitionDisk "$device" MBR \
	FAT32 "$boot_label" "${boot_mib}M" \
	ExFAT "$content_label" R >/dev/null

boot_mount=$(diskutil info "${device}s1" | sed -n 's/^ *Mount Point: *//p')
content_mount=$(diskutil info "${device}s2" | sed -n 's/^ *Mount Point: *//p')
[ -d "$boot_mount" ] || { echo "error: boot volume did not mount" >&2; exit 1; }
[ -d "$content_mount" ] || { echo "error: content volume did not mount" >&2; exit 1; }

echo "Installing firmware..."
cp -R "$root_dir/ROOT_IMAGE/." "$boot_mount/"
cp "$kernel" "$boot_mount/kernel.elf"
cp "$init_app" "$boot_mount/init.app"
# Prefer a wiki.app built from this tree, which matches the kernel; the
# ROOT_IMAGE copy is the 2019 release build.
[ ! -f "$root_dir/wiki/wiki.app" ] || cp "$root_dir/wiki/wiki.app" "$boot_mount/wiki.app"
cp "$zim_app" "$boot_mount/zim.app"
cp "$zim_icon" "$boot_mount/zim.ico"
mkdir -p "$boot_mount/zim"
cp "$nls" "$boot_mount/zim/wiki.nls"
# Two entries make init.app show its icon menu at power on; the stock
# wiki.app stays selectable for cards that also carry its data set.  Delete
# the wiki.app line for an unattended boot straight into the reader.
printf '%s\n' 'zim.ico : zim.app started-from-init' \
	'wiki.ico : wiki.app started-from-init' > "$boot_mount/init.ini"
if [ -n "${want_nuttx:-}" ]; then
	echo "Installing nuttx.app..."
	cp "$nuttx_app" "$boot_mount/nuttx.app"
	cp "$nuttx_icon" "$boot_mount/nuttx.ico"
	# Third, so that the reader stays in the menu position people know.
	echo 'nuttx.ico : nuttx.app started-from-init' >> "$boot_mount/init.ini"
fi

IFS='
'
for native_dir in $native_dirs; do
	echo "Copying $(basename "$native_dir") data set to the boot volume..."
	cp -R "$native_dir" "$boot_mount/$(basename "$native_dir")"
done
IFS=$old_ifs
# The stock app numbers data sets by their line in wiki.inf and starts on
# the one wiki.ini names; point it at the first data set installed.
first_native=$(printf '%s' "$native_dirs" | head -n 1)
if [ -n "$first_native" ]; then
	wiki_id=$(grep -n -m 1 "^ *[A-Z]*, *[a-z]*, *$(basename "$first_native") *," \
		"$boot_mount/wiki.inf" | cut -d: -f1)
	[ -z "$wiki_id" ] || echo "wiki_id=$wiki_id" > "$boot_mount/wiki.ini"
fi

for zim_file in "$@"; do
	echo "Copying $(basename "$zim_file") to exFAT content volume..."
	cp "$zim_file" "$content_mount/$(basename "$zim_file")"
done
[ -z "$sparrow_data" ] || cp "$sparrow_data" "$content_mount/sparrow.dat"
sync

detach_image
trap - 0 HUP INT TERM
echo "Created $output"
