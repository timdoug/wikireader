#!/usr/bin/env python3
"""Compare two bench.txt files from the ZIM reader's ZIM_BENCH build.

    zim/bench-compare device-bench.txt emulator-bench.txt

Prints every micro-benchmark and article line found in both, with the ratio
of the first file's time to the second's.  Article lines are matched by
article index; when several loads of the same article are present the
first non-cached one is used.  A ratio near 1.0 means the emulator's model
of that part of the hardware is right; the micro-benchmarks isolate the
CPU (cpu-loop), instruction fetch (fetch-1k), sequential and alternating
SDRAM access (read-, write-, pair-), copies, and the card (card-).
"""
import re
import sys


def parse(path):
    bench = {}
    articles = {}
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            m = re.match(r"bench (\S+)\s+(\d+) ops\s+([\d.]+) ms\s+([\d.]+) cyc/op", line)
            if m:
                bench[m.group(1)] = (int(m.group(2)), float(m.group(3)), float(m.group(4)))
                continue
            m = re.match(r"article (\d+) total ([\d.]+) blob ([\d.]+) \(card ([\d.]+) (\d+)K (\d+), "
                         r"zstd ([\d.]+) (\d+)\) html ([\d.]+) wrap ([\d.]+) paint ([\d.]+) ms", line)
            if m and m.group(1) not in articles:
                g = m.groups()
                articles[g[0]] = {
                    "total": float(g[1]), "blob": float(g[2]), "card": float(g[3]),
                    "card KB": int(g[4]), "card reads": int(g[5]),
                    "zstd": float(g[6]), "zstd calls": int(g[7]),
                    "html": float(g[8]), "wrap": float(g[9]), "paint": float(g[10]),
                }
    return bench, articles


def ratio(a, b):
    return f"{a / b:6.2f}" if b else "     -"


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    (bench_a, art_a), (bench_b, art_b) = parse(sys.argv[1]), parse(sys.argv[2])
    print(f"{'micro-benchmark':18} {'A ms':>9} {'B ms':>9} {'A/B':>6}   {'A cyc/op':>9} {'B cyc/op':>9}")
    for name, (ops, ms_a, cyc_a) in bench_a.items():
        if name in bench_b:
            _, ms_b, cyc_b = bench_b[name]
            print(f"{name:18} {ms_a:9.1f} {ms_b:9.1f} {ratio(ms_a, ms_b)}   {cyc_a:9.1f} {cyc_b:9.1f}")
    for index in art_a:
        if index not in art_b:
            continue
        a, b = art_a[index], art_b[index]
        print(f"\narticle {index}: {'phase':8} {'A ms':>9} {'B ms':>9} {'A/B':>6}")
        for phase in ("total", "blob", "card", "zstd", "html", "wrap", "paint"):
            print(f"{'':15} {phase:8} {a[phase]:9.1f} {b[phase]:9.1f} {ratio(a[phase], b[phase])}")
        print(f"{'':15} card {a['card KB']} KB in {a['card reads']} reads, "
              f"zstd {a['zstd calls']} calls (A); {b['card KB']} KB, {b['card reads']}, {b['zstd calls']} (B)")


if __name__ == "__main__":
    main()
