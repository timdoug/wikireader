+#ifdef __NuttX__
+// nuttx_bridge.c: spawn a NuttX builtin by name, with its stdin/stdout set.
+pid_t nuttx_spawn(const char *name, char **argv, int fd_in, int fd_out);
+
+// Resolve a command to something NuttX can spawn, and spawn it.
+//
+// An applet is not a builtin of its own: they all live behind the single
+// "toybox" one and are reached as "toybox <applet> <args>", which is the
+// form toybox_entry.c's main() dispatches. Anything else is looked up in
+// NuttX's own builtin table, so "find -exec nsh" and friends still work.
+//
+// A null argv means "run this program again", which upstream does by
+// re-execing /proc/self/exe; here the same thing is said by spawning the
+// multiplexer with the arguments we already have.
+pid_t nuttx_toy_spawn(char **argv, int fd_in, int fd_out)
+{
+  char **run, **multi = 0;
+  const char *name;
+  pid_t pid;
+  int n;
+
+  run = argv ? argv : toys.argv;
+  if (toy_find(*run)) {
+    for (n = 0; run[n]; n++);
+    multi = xmalloc((n+2)*sizeof(char *));
+    *multi = "toybox";
+    memcpy(multi+1, run, (n+1)*sizeof(char *));
+    run = multi;
+    name = "toybox";
+  } else name = *run;
+
+  pid = nuttx_spawn(name, run, fd_in, fd_out);
+  free(multi);
+
+  return pid;
+}
+#endif
+
 // Spawn child process, capturing stdin/stdout.
 // argv[]: command to exec. If null, child re-runs original program with
 //         toys.stacktop zeroed.
