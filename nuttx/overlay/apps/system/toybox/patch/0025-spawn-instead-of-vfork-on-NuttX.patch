--- a/nuttx_bridge.c
+++ b/nuttx_bridge.c
@@ -16,7 +16,10 @@
 #include <sys/wait.h>
 #include <stdio.h>
 
+#include <errno.h>
+
 #include "builtin/builtin.h"
+#include "nshlib/nshlib.h"
 
 int nuttx_builtin_exec(int argc, char *argv[])
