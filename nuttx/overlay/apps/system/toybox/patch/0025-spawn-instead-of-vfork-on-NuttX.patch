@@ -36,3 +39,37 @@
 
   return 0;
 }
+
+/* Spawning, for a system that cannot fork.
+ *
+ * NuttX creates a task at an entry point: there is one address space, no
+ * MMU, and nothing to copy, so a child never runs the parent's code. That
+ * removes the window a Unix program uses between fork() and exec() to set
+ * its file descriptors up, so the redirection has to travel with the spawn
+ * instead -- which is exactly what exec_builtin()'s nsh_param_s carries,
+ * and what NSH itself uses for its own pipes and redirections.
+ *
+ * fd_in/fd_out are the descriptors the new task should see as its stdin and
+ * stdout; 0 and 1 mean "leave alone". The caller keeps ownership of both.
+ */
+
+pid_t nuttx_spawn(const char *name, char **argv, int fd_in, int fd_out)
+{
+  struct nsh_param_s param =
+    {
+      .fd_in    = fd_in == 0 ? -1 : fd_in,
+      .fd_out   = fd_out == 1 ? -1 : fd_out,
+      .fd_err   = -1,
+      .file_in  = NULL,
+      .file_out = NULL,
+      .file_err = NULL,
+    };
+
+  if (builtin_isavail(name) < 0)
+    {
+      errno = ENOENT;
+      return -1;
+    }
+
+  return exec_builtin(name, argv, &param);
+}
