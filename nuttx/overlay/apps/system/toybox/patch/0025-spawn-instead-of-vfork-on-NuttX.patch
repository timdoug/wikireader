+#elif defined(__NuttX__)
+
+// NuttX has neither kqueue nor inotify, so watch the only thing "tail -f"
+// actually asks about: whether the file got longer. fds[2*i] holds the size
+// last seen, fds[2*i+1] the descriptor, which is the same layout the
+// inotify version below uses for its watch descriptors.
+
+struct xnotify *xnotify_init(int max)
+{
+  struct xnotify *not = xzalloc(sizeof(struct xnotify));
+
+  not->max = max;
+  not->kq = -1;
+  not->paths = xmalloc(max * sizeof(char *));
+  not->fds = xmalloc(max * 2 * sizeof(int));
+
+  return not;
+}
+
+int xnotify_add(struct xnotify *not, int fd, char *path)
+{
+  struct stat st;
+  int i = 2*not->count;
+
+  if (not->max == not->count) error_exit("xnotify_add overflow");
+  not->fds[i] = fstat(fd, &st) ? 0 : (int)st.st_size;
+  not->fds[i+1] = fd;
+  not->paths[not->count++] = path;
+
+  return 0;
+}
+
+int xnotify_wait(struct xnotify *not, char **path)
+{
+  struct stat st;
+  int i;
+
+  for (;;) {
+    for (i = 0; i<not->count; i++) {
+      if (fstat(not->fds[2*i+1], &st)) continue;
+      if ((int)st.st_size == not->fds[2*i]) continue;
+      not->fds[2*i] = st.st_size;
+      *path = not->paths[i];
+
+      return not->fds[2*i+1];
     }
+    // No file descriptor to block on; a tenth of a second is short enough
+    // to feel immediate and long enough not to spin the CPU on a battery.
+    usleep(100000);
   }
 }
 
