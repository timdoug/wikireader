choice
	prompt "C33 chip"
	default ARCH_CHIP_S1C33E07

config ARCH_CHIP_S1C33E07
	bool "S1C33E07 (C33 PE)"

endchoice

config ARCH_CHIP
	string
	default "s1c33e07"

config RAM_START
	default 0x10000000

config RAM_SIZE
	default 33554432

config S1C33E07_UART0
	bool
	default y
	select UART0_SERIALDRIVER

config S1C33E07_MCLK
	int "Main clock frequency"
	default 48000000
	---help---
		The first port retains the boot loader's 48 MHz clock.
		This value must match the loader's MCLK; it does not reprogram
		the PLL.

config S1C33E07_BAUDCLK
	int "Clock feeding the serial baud rate generators"
	default 60000000
	---help---
		Not the main clock.  The loader brings up the PLL -- 48 MHz
		divided by 8 into it, 60 MHz out -- and the serial interfaces
		take their baud rate from that, which is why the original
		firmware computes the touch panel's divisor from PLL_CLK and
		not from MCLK (samo-lib/drivers/src/ctp.c, and suspend.c, which
		reprograms both interfaces when it switches the clock over).
		Getting this wrong costs 25 per cent of every baud rate here,
		which no emulator will notice: wremu's serial model does not
		look at the divisor at all.
