choice
	prompt "C33 chip"
	default ARCH_CHIP_S1C33E07

config ARCH_CHIP_S1C33E07
	bool "S1C33E07 (C33 PE)"

endchoice

config ARCH_CHIP
	string
	default "s1c33e07"

config RAM_START
	default 0x10000000

config RAM_SIZE
	default 33554432

config S1C33E07_UART0
	bool
	default y
	select UART0_SERIALDRIVER

config S1C33E07_MCLK
	int "Main clock frequency"
	default 60000000
	---help---
		What the loader leaves running, not the crystal.  The 48 MHz
		crystal goes into the PLL divided by 8 and comes out at 60 MHz,
		and that is the system clock by the time an application is
		loaded -- grifo's own comment on the setup says so, the
		original firmware computes the touch panel's baud rate from it
		(samo-lib/drivers/src/ctp.c), and the emulator derives the same
		figure from the registers (emulator/tools/test_cmu.c, "system
		clock is 60 MHz").

		This port read 48 MHz here for a long time, which made the
		system tick a quarter fast, every udelay a quarter short, the
		SPI clock a quarter high and both serial ports unusable.
