+/****************************************************************************
+ * Name: nxterm_cellat
+ *
+ * Description:
+ *   Return the index of the character displayed at a position, or -1.  The
+ *   search runs backwards because the most recent entry is the interesting
+ *   one if positions were ever duplicated.
+ *
+ ****************************************************************************/
+
+int nxterm_cellat(FAR struct nxterm_state_s *priv,
+                  FAR const struct nxgl_point_s *pos)
+{
+  int i;
+
+  /* Nothing is stored at or past the frontier, so the common case -- a
+   * terminal that only appends -- answers without searching at all.
+   */
+
+  if (pos->y > priv->frontier.y ||
+      (pos->y == priv->frontier.y && pos->x >= priv->frontier.x))
+    {
+      return -1;
+    }
+
+  for (i = priv->nchars - 1; i >= 0; i--)
+    {
+      if (priv->bm[i].pos.x == pos->x && priv->bm[i].pos.y == pos->y)
+        {
+          return i;
+        }
+    }
+
+  return -1;
+}
+
+/****************************************************************************
+ * Name: nxterm_reversechar
+ *
+ * Description:
+ *   Draw one character in reverse video, by exchanging the foreground and
+ *   background colours of its rendered glyph.  A glyph is rendered over its
+ *   whole bounding box, background included, so drawing a cursor glyph on
+ *   top of a character hides it; showing the same character inverted marks
+ *   the position without costing the reader the character.
+ *
+ *   Returns OK if the character was drawn, or a negated errno if this
+ *   display's pixel depth is not one that can be inverted by exchanging
+ *   two values, in which case the caller should fall back to a cursor
+ *   glyph.
+ *
+ ****************************************************************************/
+
+int nxterm_reversechar(FAR struct nxterm_state_s *priv,
+                       FAR const struct nxterm_bitmap_s *bm)
+{
+  FAR const struct nxfonts_glyph_s *glyph;
+  struct nxgl_rect_s bounds;
+  nxgl_mxpixel_t fgcolor = priv->wndo.fcolor[0];
+  nxgl_mxpixel_t bgcolor = priv->wndo.wcolor[0];
+  FAR const void *src;
+  size_t bmsize;
+  size_t i;
+
+  if (priv->cursorbm == NULL || BM_ISSPACE(bm))
+    {
+      return -ENOSYS;
+    }
+
+  glyph = nxf_cache_getglyph(priv->fcache, bm->code);
+  if (glyph == NULL)
+    {
+      return -ENOENT;
+    }
+
+  bmsize = (size_t)glyph->stride * glyph->height;
+  if (bmsize > priv->cursorbmsize)
+    {
+      return -E2BIG;
+    }
+
+  /* A rendered glyph holds only two pixel values, so inverting it means
+   * exchanging those two.  At one bit per pixel that is the complement,
+   * whichever way round the two colours are.
+   */
+
+  if (CONFIG_NXTERM_BPP == 1)
+    {
+      for (i = 0; i < bmsize; i++)
+        {
+          priv->cursorbm[i] = ~glyph->bitmap[i];
+        }
+    }
+  else if (CONFIG_NXTERM_BPP == 8 || CONFIG_NXTERM_BPP == 16 ||
+           CONFIG_NXTERM_BPP == 32)
+    {
+      size_t pixelsize = CONFIG_NXTERM_BPP / 8;
+
+      for (i = 0; i + pixelsize <= bmsize; i += pixelsize)
+        {
+          nxgl_mxpixel_t pixel = 0;
+
+          memcpy(&pixel, &glyph->bitmap[i], pixelsize);
+          pixel = (pixel == fgcolor) ? bgcolor : fgcolor;
+          memcpy(&priv->cursorbm[i], &pixel, pixelsize);
+        }
+    }
+  else
+    {
+      /* Pixels smaller than a byte but wider than a bit, and the 24-bit
+       * packing, would each need their own unpacking here.
+       */
+
+      return -ENOSYS;
+    }
+
+  bounds.pt1.x = bm->pos.x;
+  bounds.pt1.y = bm->pos.y;
+  bounds.pt2.x = bm->pos.x + glyph->width - 1;
+  bounds.pt2.y = bm->pos.y + glyph->height - 1;
+
+  src = (FAR const void *)priv->cursorbm;
+  return priv->ops->bitmap(priv, &bounds, &src, &bm->pos,
+                           (unsigned int)glyph->stride);
+}
+
+/****************************************************************************
+ * Name: nxterm_gridsize
+ *
+ * Description:
+ *   Return the size of the window in whole character cells.  The last row
+ *   is the last one that nxterm_putc() will not scroll away.
+ *
+ ****************************************************************************/
+
+void nxterm_gridsize(FAR struct nxterm_state_s *priv,
+                     FAR uint16_t *rows, FAR uint16_t *cols)
+{
+  int cellh = priv->fheight + CONFIG_NXTERM_LINESEPARATION;
+  int cellw = priv->fwidth;
+  int nrows;
+  int ncols;
+
+  ncols = cellw > 0 ? (priv->wndo.wsize.w - priv->spwidth) / cellw : 0;
+  nrows = cellh > 0 ? (priv->wndo.wsize.h - CONFIG_NXTERM_LINESEPARATION) /
+                      cellh : 0;
+
+  /* Writing on the bottom row must not scroll the window out from under a
+   * full-screen application, so drop any row that would trip the scroll
+   * test in nxterm_putc().
+   */
+
+  while (nrows > 1 &&
+         CONFIG_NXTERM_LINESEPARATION + (nrows - 1) * cellh >=
+         priv->wndo.wsize.h - cellh)
+    {
+      nrows--;
+    }
+
+  *cols = ncols > 0 ? ncols : 1;
+  *rows = nrows > 0 ? nrows : 1;
+}
+
+/****************************************************************************
+ * Name: nxterm_gridpos
+ *
+ * Description:
+ *   Set the next display position from one-based row and column numbers,
+ *   clipped to the window.
+ *
+ ****************************************************************************/
+
+void nxterm_gridpos(FAR struct nxterm_state_s *priv, int row, int col)
+{
+  uint16_t rows;
+  uint16_t cols;
+
+  nxterm_gridsize(priv, &rows, &cols);
+
+  if (row < 1)
+    {
+      row = 1;
+    }
+  else if (row > rows)
+    {
+      row = rows;
+    }
+
+  if (col < 1)
+    {
+      col = 1;
+    }
+  else if (col > cols)
+    {
+      col = cols;
+    }
+
+  priv->fpos.x = priv->spwidth + (col - 1) * priv->fwidth;
+  priv->fpos.y = CONFIG_NXTERM_LINESEPARATION +
+                 (row - 1) * (priv->fheight + CONFIG_NXTERM_LINESEPARATION);
+}
+
+/****************************************************************************
+ * Name: nxterm_gridcell
+ *
+ * Description:
+ *   Return the one-based row and column containing the next display
+ *   position.  A proportional font can leave the position part way into a
+ *   cell; the containing cell is reported.
+ *
+ ****************************************************************************/
+
+void nxterm_gridcell(FAR struct nxterm_state_s *priv,
+                     FAR int *row, FAR int *col)
+{
+  int cellh = priv->fheight + CONFIG_NXTERM_LINESEPARATION;
+
+  *col = priv->fwidth > 0 ?
+         (priv->fpos.x - priv->spwidth) / priv->fwidth + 1 : 1;
+  *row = cellh > 0 ?
+         (priv->fpos.y - CONFIG_NXTERM_LINESEPARATION) / cellh + 1 : 1;
+
+  if (*col < 1)
+    {
+      *col = 1;
+    }
+
+  if (*row < 1)
+    {
+      *row = 1;
+    }
+}
+
+/****************************************************************************
+ * Name: nxterm_eraseregion
+ *
+ * Description:
+ *   Clear a rectangle of the window and discard every saved glyph whose
+ *   origin falls inside it, so that a later redraw does not bring the
+ *   erased text back.
+ *
+ ****************************************************************************/
+
+void nxterm_eraseregion(FAR struct nxterm_state_s *priv,
+                        FAR const struct nxgl_rect_s *rect)
+{
+  uint16_t dst;
+  uint16_t src;
+
+  priv->ops->fill(priv, rect, priv->wndo.wcolor);
+
+  for (src = 0, dst = 0; src < priv->nchars; src++)
+    {
+      if (priv->bm[src].pos.x >= rect->pt1.x &&
+          priv->bm[src].pos.x <= rect->pt2.x &&
+          priv->bm[src].pos.y >= rect->pt1.y &&
+          priv->bm[src].pos.y <= rect->pt2.y)
+        {
+          continue;
+        }
+
+      if (dst != src)
+        {
+          priv->bm[dst] = priv->bm[src];
+        }
