index 9ac148b..11443fb 100644
--- a/nshlib/nsh.h
+++ b/nshlib/nsh.h
@@ -848,6 +848,9 @@ int nsh_dropbearstart(void);
 /* Application interface */
 
 int nsh_command(FAR struct nsh_vtbl_s *vtbl, int argc, FAR char *argv[]);
+#ifdef CONFIG_NSH_MULTICALL
+bool nsh_iscmd(FAR const char *cmd);
+#endif
 
 #ifdef CONFIG_NSH_BUILTIN_APPS
 int nsh_builtin(FAR struct nsh_vtbl_s *vtbl, FAR const char *cmd,
diff --git a/nshlib/nsh_command.c b/nshlib/nsh_command.c
index 14a375e..b2a304d 100644
--- a/nshlib/nsh_command.c
+++ b/nshlib/nsh_command.c
@@ -1253,6 +1253,34 @@ static int cmd_expr(FAR struct nsh_vtbl_s *vtbl, int argc, FAR char **argv)
  *
  ****************************************************************************/
 
+#ifdef CONFIG_NSH_MULTICALL
+/****************************************************************************
+ * Name: nsh_iscmd
+ *
+ * Description:
+ *   Is this one of the shell's own commands?  nsh_command() answers that
+ *   only by running it, and reports "not an NSH command" and "an NSH command
+ *   that failed" the same way, so a caller wanting to try something else
+ *   first has to ask separately.
+ *
+ ****************************************************************************/
+
+bool nsh_iscmd(FAR const char *cmd)
+{
+  const struct cmdmap_s *cmdmap;
+
+  for (cmdmap = g_cmdmap; cmdmap->cmd; cmdmap++)
+    {
+      if (strcmp(cmdmap->cmd, cmd) == 0)
+        {
+          return true;
+        }
+    }
+
+  return false;
+}
+#endif
+
 int nsh_command(FAR struct nsh_vtbl_s *vtbl, int argc, FAR char *argv[])
 {
   const struct cmdmap_s  *cmdmap;
diff --git a/nshlib/nsh_parse.c b/nshlib/nsh_parse.c
index 9de45b8..b458daa 100644
--- a/nshlib/nsh_parse.c
+++ b/nshlib/nsh_parse.c
@@ -39,6 +39,10 @@
 #  include <sys/stat.h>
 #endif
 
+#ifdef CONFIG_NSH_MULTICALL
+#  include <nuttx/lib/builtin.h>
+#endif
+
 #include <nuttx/version.h>
 #include <nuttx/sched_note.h>
 
@@ -750,8 +754,49 @@ static int nsh_execute(FAR struct nsh_vtbl_s *vtbl,
        *  0 (OK)     if the command was successful
        */
 
+#ifdef CONFIG_NSH_MULTICALL
+      /* Not one of the shell's own commands, and not a registered builtin
+       * either or we would not be here: offer it to the multi-call binary
+       * before giving up.  Toybox and Busybox put a hundred-odd commands
+       * behind one entry point, reached as "<multicall> <command> <args>",
+       * which elsewhere a symlink per command hides; there is no file
+       * system here to hold those, and a multi-call binary by construction
+       * has no entry point symbol per command to register instead.
+       *
+       * This runs with the same redirection parameters as any other
+       * command, which is what makes it work in a pipeline rather than
+       * only on its own.
+       */
+
+      if (!nsh_iscmd(argv[0]) &&
+          strcmp(argv[0], CONFIG_NSH_MULTICALL_NAME) != 0 &&
+          builtin_isavail(CONFIG_NSH_MULTICALL_NAME) >= 0)
+        {
+          FAR char *newargv[CONFIG_NSH_MAXARGUMENTS + 3];
+          int i;
+
+          newargv[0] = (FAR char *)CONFIG_NSH_MULTICALL_NAME;
+          for (i = 0; i < argc && i < CONFIG_NSH_MAXARGUMENTS + 1; i++)
+            {
+              newargv[i + 1] = argv[i];
+            }
+
+          newargv[i + 1] = NULL;
+
+          ret = nsh_builtin(vtbl, CONFIG_NSH_MULTICALL_NAME, newargv, param);
+          if (ret >= 0)
+            {
+              goto multicall_done;
+            }
+        }
+#endif
+
       ret = nsh_command(vtbl, argc, argv);
 
+#ifdef CONFIG_NSH_MULTICALL
+multicall_done:
+#endif
+
       /* Restore the original output.  Undirect will close the redirection
        * file descriptor.
        */
