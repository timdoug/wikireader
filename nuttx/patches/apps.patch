diff --git a/nshlib/Kconfig b/nshlib/Kconfig
index 8f1740a..3416eab 100644
--- a/nshlib/Kconfig
+++ b/nshlib/Kconfig
@@ -225,6 +225,29 @@ config NSH_DISABLEBG
 		where a minimal footprint is a necessity and background command
 		execution is not.
 
+config NSH_MULTICALL
+	bool "Fall back to a multi-call binary"
+	default n
+	depends on NSH_BUILTIN_APPS
+	---help---
+		When a command is neither an NSH command nor a registered builtin,
+		try it again as "<multicall> <command> <args>" before reporting it
+		as not found.
+
+		Toybox and Busybox put a hundred-odd commands behind a single entry
+		point. Elsewhere a symlink per command makes them reachable by their
+		own names; with no file system to hold those, and no entry point
+		symbol per command to register as builtins, this is what gets them
+		under their plain names -- with redirection, pipes and the rest,
+		since those are already in place by the time a command is dispatched.
+
+config NSH_MULTICALL_NAME
+	string "Multi-call binary name"
+	default "toybox"
+	depends on NSH_MULTICALL
+	---help---
+		The registered builtin to hand unrecognized commands to.
+
 config NSH_ALIAS
 	bool "Enable alias support"
 	default !DEFAULT_SMALL
