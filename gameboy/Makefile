# A Game Boy for the WikiReader: Peanut-GB at a pinned revision.
# SPDX-License-Identifier: MIT

ROOT_DIR := $(abspath ..)
HERE := $(abspath .)
PEANUT := $(HERE)/work/Peanut-GB
MK_DIR := $(ROOT_DIR)/samo-lib/Mk
TOOLCHAIN_BIN ?= $(ROOT_DIR)/host-tools/toolchain-c33/work/install/bin
include $(MK_DIR)/definitions.mk
include $(GRIFO_APPLICATION_PRE)

PROGRAM = gameboy
ICON = YES
SOURCES = gameboy.c gb.c
INCLUDES += -I$(HERE)/compat -I$(PEANUT)
CFLAGS += -std=gnu11 -fwrapv -fno-strict-aliasing
LDFLAGS += -T memory.lds
# memory.lds links code over the kernel's framebuffer reservation (.lcd),
# which the loader clears before it loads the code; ld's overlap check
# cannot know that.
LDFLAGS += --no-check-sections

# HOT=1 runs the common instructions in hot.s, generated by gen-hot.py.
# CHECK=1 has it count them for a lockstep build.
HOT ?= 1
CHECK ?= 0
ifeq (1,$(strip $(HOT)))
CFLAGS += -DGBW_HOT
HOT_OBJECT = build/hot.o
endif
HOT_FLAGS = $(if $(filter 1,$(strip $(CHECK))),--check)
# Peanut-GB is upstream code; keep its warnings from failing the build.
build/gb.o: CFLAGS += -Wno-error

include $(GRIFO_APPLICATION_POST)

BUILD_OBJECTS += $(HOT_OBJECT)
lib/libapplication.a: $(HOT_OBJECT)
gameboy.app: memory.lds

build/hot.s: gen-hot.py opcode-weights.txt Makefile | build
	python3 gen-hot.py $(HOT_FLAGS) > $@
build/hot.o: build/hot.s
	$(AS) -o $@ $(ASFLAGS) $<

$(BUILD_OBJECTS): $(PEANUT)/peanut_gb.h | build
$(PEANUT)/peanut_gb.h: revision fetch.sh $(wildcard patches/*.patch)
	./fetch.sh
	touch $@

HOST_CC ?= cc

.PHONY: test
test: $(PEANUT)/peanut_gb.h | build
	$(HOST_CC) -std=gnu11 -O2 -Wall -Wextra -Werror -fsanitize=address,undefined \
		-I. -Icompat -I$(PEANUT) tests/host.c gb.c -o build/host
	$(HOST_CC) -std=gnu11 -O2 -Wall -Wextra -Werror -fsanitize=address,undefined \
		-DGBW_CHECK_RENDER -I. -Icompat -I$(PEANUT) tests/host.c gb.c -o build/host-check
	$(HOST_CC) -std=gnu11 -O2 -Wall -Wextra -Werror -Wno-unused-function -fsanitize=address,undefined \
		-DGBW_LOCKSTEP -I. -Icompat -I$(PEANUT) tests/host.c gb.c tests/reference.c -o build/host-lockstep

# Opcode counts for opcode-weights.txt: build/host-hist GAME FRAMES [SCRIPT]
# prints one "opcode count" line each to stderr.
.PHONY: histogram
histogram: $(PEANUT)/peanut_gb.h | build
	$(HOST_CC) -std=gnu11 -O2 -DGBW_HISTOGRAM -I. -Icompat -I$(PEANUT) \
		tests/host.c gb.c -o build/host-hist

.PHONY: realclean
realclean: clean
	rm -rf work
