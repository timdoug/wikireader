+/* Timing: PEANUT_GB_BATCH(gb, cycles) is given each instruction's cycles
+ * and returns the cycles to run the timers, serial port and LCD for now,
+ * or 0 to defer them; PEANUT_GB_TICKED(gb) follows each run.  A front-end
+ * deferring must run __gb_tick itself before anything can observe the
+ * deferred state. */
+#ifndef PEANUT_GB_BATCH
+# define PEANUT_GB_BATCH(gb, cycles) (cycles)
+#endif
+#ifndef PEANUT_GB_TICKED
+# define PEANUT_GB_TICKED(gb) ((void)0)
+#endif
+#ifndef PEANUT_GB_HALT
+# define PEANUT_GB_HALT(gb) ((void)0)
+#endif
+/* The timing a step runs: __gb_tick, and while halted again until an
+ * interrupt is pending, unless a front-end does it its own way. */
+#ifndef PEANUT_GB_TICKS
+# define PEANUT_GB_TICKS(gb, cycles) do {				\
+	uint32_t c_ = (cycles);						\
+	do								\
+		c_ = __gb_tick((gb), c_);				\
+	while(c_ && (gb)->gb_halt					\
+		&& ((gb)->hram_io[IO_IF] & (gb)->hram_io[IO_IE]) == 0);	\
+} while (0)
+#endif
