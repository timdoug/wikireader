HeaderInclude
config/c33/c33-opts.h

Variable
int small_memory_max[(int)SMALL_MEMORY_max] = { 0, 0, 0 }

; Core variants.  The names are dictated by the existing toolchain: samo-lib
; builds with -mc33pe, and mini-libc adds -medda32.  These are the three real
; C33 cores; the e1/e2/e3v5 spellings this file was forked from were V850's.

Enum
Name(c33_core) Type(enum c33_core) UnknownError(unknown C33 core %qs)

EnumValue
Enum(c33_core) String(c33) Value(C33_CORE_STD)

EnumValue
Enum(c33_core) String(c33adv) Value(C33_CORE_ADV)

EnumValue
Enum(c33_core) String(c33pe) Value(C33_CORE_PE)

mc33
Target RejectNegative Alias(mcore=, c33)
Generate code for the standard C33 core.

mc33adv
Target RejectNegative Alias(mcore=, c33adv)
Generate code for the C33 ADV core.

mc33pe
Target RejectNegative Alias(mcore=, c33pe)
Generate code for the C33 PE core.

mcore=
Target RejectNegative Joined Enum(c33_core) Var(c33_selected_core) Init(C33_CORE_STD)
Select the C33 core variant.

mlong-calls
Target Mask(LONG_CALLS)
Use xcall rather than scall, so callees may be anywhere in the 32-bit address space.

medda32
Target Mask(EXT_32)
Do not use the %r15-relative default data area; address globals absolutely.

memcpy
Target Mask(MEMCPY)
Call memcpy for block moves rather than expanding them inline.

mbig-switch
Target Mask(BIG_SWITCH)
Use 4 byte entries in switch tables.

mjump-tables-in-data-section
Target Mask(JUMP_TABLES_IN_DATA_SECTION)
Put jump tables in .data rather than .text.

mdebug
Target Undocumented Mask(DEBUG)
Enable backend debugging.

; Data area sizes.  The C33 has one data area, addressed through %r15;
; msda= is what selects it, and the tda/zda spellings are accepted and
; ignored so existing makefiles keep working.

msda=
Target RejectNegative Joined UInteger
Set the max size of data eligible for the default data area.

msda-
Target RejectNegative Joined Undocumented Alias(msda=)

mtda=
Target RejectNegative Joined UInteger Undocumented
Accepted and ignored; the C33 has no separate tiny data area.

mtda-
Target RejectNegative Joined Undocumented Alias(mtda=)

mzda=
Target RejectNegative Joined UInteger Undocumented
Accepted and ignored; the C33 has no separate zero data area.

mzda-
Target RejectNegative Joined Undocumented Alias(mzda=)
