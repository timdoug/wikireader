# One multilib per core.  The cores are not link-compatible: the assembler
# stamps the variant into the top byte of e_flags and the linker refuses to
# mix them, so a PE program needs a PE libgcc.  The WikiReader is a PE.
#
# The V850 variants this was forked from (mgcc-abi, msoft-float, mc33e3v5)
# are gone: those were NEC's, and floating point here is always soft.
#
# Selection is on the canonical -mcore=, which is what -mc33adv and -mc33pe
# expand to.

MULTILIB_OPTIONS  = mcore=c33adv/mcore=c33pe
MULTILIB_DIRNAMES = c33adv c33pe

# TCFLAGS is gone too: it carried -mno-app-regs -msmall-sld and two
# -Wa,-mwarn-* options, none of which this compiler or assembler accepts.

c33-c.o: $(srcdir)/config/c33/c33-c.cc $(CONFIG_H) $(SYSTEM_H) coretypes.h \
  $(TM_H) $(CPPLIB_H) $(TREE_H) $(C_PRAGMA_H) $(GGC_H) $(TM_P_H)
	$(COMPILER) -c $(ALL_COMPILERFLAGS) $(ALL_CPPFLAGS) $(INCLUDES) \
		$(srcdir)/config/c33/c33-c.cc

