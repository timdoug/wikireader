# The Linux target has a single multilib, selected by DRIVER_SELF_SPECS in
# c33/linux.h: PE core, FDPIC, short calls.

c33-c.o: $(srcdir)/config/c33/c33-c.cc $(CONFIG_H) $(SYSTEM_H) coretypes.h \
  $(TM_H) $(CPPLIB_H) $(TREE_H) $(C_PRAGMA_H) $(GGC_H) $(TM_P_H)
	$(COMPILER) -c $(ALL_COMPILERFLAGS) $(ALL_CPPFLAGS) $(INCLUDES) \
		$(srcdir)/config/c33/c33-c.cc

# Local Variables:
# mode: Makefile
# End:
# The TLS slot is copied from the kernel UAPI by gcc-glue.py.
c33.o: $(srcdir)/config/c33/c33-linux-tls.h
