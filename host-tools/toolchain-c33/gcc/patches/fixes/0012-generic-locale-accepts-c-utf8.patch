+
+// 22.1.1.2 locale constructors and destructors [lib.locale.cons]
+
+#include <locale>
+#include <testsuite_hooks.h>
+
+// A C library that has C.UTF-8 makes a locale of it, whatever the model.
+void test01()
+{
+  std::locale loc("C.UTF-8");
+  VERIFY( loc.name() == "C.UTF-8" );
+}
+
+int main()
+{
+  test01();
+  return 0;
+}
