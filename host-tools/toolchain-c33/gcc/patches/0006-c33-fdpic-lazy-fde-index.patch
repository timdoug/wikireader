+/* C33's FDPIC text and data mappings cannot share a data-relative linker
+   search table.  Build the ordinary libgcc index lazily instead.  All cache
+   access, including lookup, stays inside uClibc's serialized phdr callback.
+   The loader's adds/subs generation invalidates pointers before reuse. */
+#if defined(__c33__) && defined(__FDPIC__) && defined(__UCLIBC__)
+#define C33_FDPIC_FDE_CACHE 1
+#define C33_FDE_CACHE_ENTRIES 4
+#define C33_FDE_CACHE_BYTES (32 * 1024)
+#define C33_FDE_INDEX_BYTES (16 * 1024)
+
+static struct c33_fde_cache_entry
+{
+  const fde *eh_frame;
+  void *dbase;
+  struct object ob;
+  size_t bytes;
+  unsigned long used;
+} c33_fde_cache[C33_FDE_CACHE_ENTRIES];
+static size_t c33_fde_cache_bytes;
+static unsigned long c33_fde_cache_clock;
+
+static void
+c33_fde_cache_release (struct c33_fde_cache_entry *entry)
+{
+  if (entry->ob.s.b.sorted)
+    free (entry->ob.u.sort);
+  c33_fde_cache_bytes -= entry->bytes;
+  memset (entry, 0, sizeof (*entry));
+}
+
+static void
+#ifdef SHARED
+__attribute__((destructor))
+#endif
+c33_fde_cache_clear (void)
+{
+  unsigned int i;
+  for (i = 0; i < C33_FDE_CACHE_ENTRIES; i++)
+    c33_fde_cache_release (&c33_fde_cache[i]);
+  c33_fde_cache_clock = 0;
+}
+
+static struct object *
+c33_fde_index (const fde *eh_frame, _Unwind_Ptr dbase)
+{
+  struct c33_fde_cache_entry *entry = NULL;
+  size_t count, bytes;
+  unsigned int i;
+
+  /* Keep relative ages valid even after the counter wraps. */
+  if (++c33_fde_cache_clock == 0)
+    {
+      c33_fde_cache_clear ();
+      c33_fde_cache_clock = 1;
+    }
+  for (i = 0; i < C33_FDE_CACHE_ENTRIES; i++)
+    {
+      struct c33_fde_cache_entry *candidate = &c33_fde_cache[i];
+      if (candidate->eh_frame == eh_frame
+          && candidate->dbase == (void *) dbase)
+        {
+          candidate->used = c33_fde_cache_clock;
+          /* Remember allocation failure / oversized tables: do not try
+             allocating again on every frame of this unwind. */
+          return candidate->ob.s.b.sorted ? &candidate->ob : NULL;
+        }
+      if (!entry || candidate->used < entry->used)
+        entry = candidate;
+    }
+
+  c33_fde_cache_release (entry);
+  entry->eh_frame = eh_frame;
+  entry->dbase = (void *) dbase;
+  entry->used = c33_fde_cache_clock;
+  entry->ob.pc_begin = (void *) -1;
+  entry->ob.dbase = (void *) dbase;
+  entry->ob.u.single = eh_frame;
+  entry->ob.s.b.encoding = DW_EH_PE_omit;
+  count = classify_object_over_fdes (&entry->ob, eh_frame, NULL);
+  if (count == 0 || count == (size_t) -1
+      || count > (C33_FDE_INDEX_BYTES - sizeof (struct fde_vector))
+                 / sizeof (const fde *))
+    return NULL;
+  bytes = sizeof (struct fde_vector) + count * sizeof (const fde *);
+
+  while (c33_fde_cache_bytes + bytes > C33_FDE_CACHE_BYTES)
+    {
+      struct c33_fde_cache_entry *oldest = NULL;
+      for (i = 0; i < C33_FDE_CACHE_ENTRIES; i++)
+        if (c33_fde_cache[i].bytes
+            && (!oldest || c33_fde_cache[i].used < oldest->used))
+          oldest = &c33_fde_cache[i];
+      c33_fde_cache_release (oldest);
+    }
+
+  entry->ob.s.b.count = count;
+  init_object (&entry->ob);
+  if (!entry->ob.s.b.sorted)
+    return NULL;  /* malloc failed: retain the existing linear fallback. */
+  entry->bytes = bytes;
+  c33_fde_cache_bytes += bytes;
+  /* init_object's temporary sort vector is freed before it returns: at
+     most 32 KiB retained plus 16 KiB scratch, allocated only on demand. */
+  return &entry->ob;
+}
