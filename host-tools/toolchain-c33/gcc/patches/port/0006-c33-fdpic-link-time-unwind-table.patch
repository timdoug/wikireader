+#ifdef C33_FDPIC_EH_TABLE
+/* Convert a runtime PC to a module VMA once per frame lookup. */
+static int
+c33_unrelocate_pc (const struct elf32_fdpic_loadmap *map,
+                   _Unwind_Ptr pc, _Unwind_Ptr *vaddr)
+{
+  unsigned int i;
+  for (i = 0; i < map->nsegs; i++)
+    if (pc >= map->segs[i].addr
+        && pc - map->segs[i].addr < map->segs[i].p_memsz)
+      {
+        *vaddr = map->segs[i].p_vaddr + pc - map->segs[i].addr;
+        return 1;
+      }
+  return 0;
+}
+
+static const fde *
+c33_relocate_fde (const struct elf32_fdpic_loadmap *map, _Unwind_Ptr vaddr)
+{
+  unsigned int i;
+  for (i = 0; i < map->nsegs; i++)
+    if (vaddr >= map->segs[i].p_vaddr
+        && vaddr - map->segs[i].p_vaddr < map->segs[i].p_memsz)
+      return (const fde *) (map->segs[i].addr
+                           + vaddr - map->segs[i].p_vaddr);
+  return NULL;
+}
+
+static const fde *
+c33_find_fde_table (_Unwind_Ptr pc, _Unwind_Ptr dbase,
+                    struct dwarf_eh_bases *bases,
+                    const struct unw_eh_callback_data *data)
+{
+  struct fde_table {
+    signed initial_loc __attribute__ ((mode (SI)));
+    signed fde __attribute__ ((mode (SI)));
+  };
+  const unsigned char *p = (const unsigned char *) data->hdr;
+  unsigned count __attribute__ ((mode (SI)));
+  _Unwind_Ptr vaddr, func, range;
+  unsigned encoding;
+  size_t lo = 0, hi, mid;
+  const fde *entry;
+
+  if (data->hdr_size < 12 || !c33_unrelocate_pc (data->map, pc, &vaddr))
+    return NULL;
+  memcpy (&count, p + 8, sizeof (count));
+  if (!count || count > (data->hdr_size - 12) / sizeof (struct fde_table))
+    return NULL;
+  const struct fde_table *table = (const struct fde_table *) (p + 12);
+
+  /* The normal datarel values are differences from the header's link-time
+     VMA. They stay unmodified at load time, including the code addresses. */
+  hi = count;
+  while (lo < hi)
+    {
+      mid = lo + (hi - lo) / 2;
+      if (vaddr < data->hdr_vaddr + table[mid].initial_loc)
+        hi = mid;
+      else
+        lo = mid + 1;
+    }
+  if (!lo)
+    return NULL;
+  entry = c33_relocate_fde (data->map,
+                            data->hdr_vaddr + table[lo - 1].fde);
+  if (!entry)
+    return NULL;
+
+  /* The frame itself retains ordinary runtime relocations. Verify its
+     range and return a runtime function address to the rest of libgcc. */
+  encoding = get_fde_encoding (entry);
+  p = read_encoded_value_with_base (encoding,
+                                    base_from_cb_data (encoding, dbase),
+                                    entry->pc_begin, &func);
+  read_encoded_value_with_base (encoding & 0x0f, 0, p, &range);
+  if (pc < func || pc - func >= range)
+    return NULL;
+  bases->tbase = NULL;
+  bases->dbase = (void *) dbase;
+  bases->func = (void *) func;
+  return entry;
+}
