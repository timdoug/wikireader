# C33 PE architecture tests.

if [istarget c33-*-*] {
    gas_test_error "pe-div0s.s" "-mc33pe" "C33 PE rejects removed div0s"
    gas_test_error "pe-div0u.s" "-mc33pe" "C33 PE rejects removed div0u"
    gas_test_error "pe-div1.s" "-mc33pe" "C33 PE rejects removed div1"
    gas_test_error "pe-div2s.s" "-mc33pe" "C33 PE rejects removed div2s"
    gas_test_error "pe-div3s.s" "-mc33pe" "C33 PE rejects removed div3s"
    gas_test_error "pe-mac.s" "-mc33pe" "C33 PE rejects removed mac"
    gas_test_error "pe-mirror.s" "-mc33pe" "C33 PE rejects removed mirror"
    gas_test_error "pe-scan0.s" "-mc33pe" "C33 PE rejects removed scan0"
    gas_test_error "pe-scan1.s" "-mc33pe" "C33 PE rejects removed scan1"
    gas_test_error "sjp-range.s" "-mc33pe" "C33 rejects out-of-range sign22 jumps"
    gas_test_error "sp-align-h.s" "-mc33pe" "C33 rejects misaligned xld.h stack displacement"
    gas_test_error "sp-align-w.s" "-mc33pe" "C33 rejects misaligned xld.w stack displacement"
    run_dump_test "pe-added"
}
