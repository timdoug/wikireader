# C33 PE architecture tests.

if [istarget c33-*-*] {
    gas_test_error "pe-mac.s" "-mc33pe" "C33 PE rejects removed mac"
    gas_test_error "pe-mirror.s" "-mc33pe" "C33 PE rejects removed mirror"
    gas_test_error "pe-scan0.s" "-mc33pe" "C33 PE rejects removed scan0"
    gas_test_error "pe-scan1.s" "-mc33pe" "C33 PE rejects removed scan1"
    run_dump_test "pe-added"
}
