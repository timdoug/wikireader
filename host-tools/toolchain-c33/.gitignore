# This port keeps its own sources under directories named gcc/ and binutils/,
# and a script named gcc-glue.py.  The patterns in ../.gitignore and
# ../../.gitignore ("gcc", "gcc-*", "binutils", "binutils-*") exist for
# extracted upstream trees like host-tools/gcc-3.3.2, but they match at any
# depth, so re-include ours here.  A .gitignore closer to the file wins, which
# is why this has to live in this directory rather than at the root.
!gcc/
!binutils/
!gcc/files/gcc/
!gcc/tools/gcc-glue.py

# What genuinely is disposable: build.sh downloads a tarball into work/ and
# builds in place.  Everything here is regenerable from files/ plus tools/.
work/
