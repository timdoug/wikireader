diff --git a/emulator/tools/test_c33_blocks.c b/emulator/tools/test_c33_blocks.c
new file mode 100644
--- /dev/null
+++ b/emulator/tools/test_c33_blocks.c
@@ -0,0 +1,160 @@
+/* Execute cached and ordinary decoding against independently mapped buses. */
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../src/c33.h"
+#include "../src/model.h"
+
+#define SIZE 4096
+struct bus {
+    uint8_t ram[SIZE];
+    unsigned reads, writes, waits, fetches, epoch;
+    bool replace;
+    unsigned offset;
+};
+static uint32_t read_bus(void *ctx, uint32_t a, unsigned size)
+{
+    struct bus *b = ctx;
+    uint32_t v = 0;
+    b->reads++;
+    for (unsigned i = 0; i < size; i++)
+        v |= (uint32_t)b->ram[(a + i + b->offset) & (SIZE - 1)] << (8 * i);
+    return v;
+}
+static void write_bus(void *ctx, uint32_t a, unsigned size, uint32_t v)
+{
+    struct bus *b = ctx;
+    b->writes++;
+    for (unsigned i = 0; i < size; i++)
+        b->ram[(a + i + b->offset) & (SIZE - 1)] = v >> (8 * i);
+}
+static uint8_t *region(void *ctx, uint32_t a, uint32_t *base, uint32_t *len)
+{
+    struct bus *b = ctx;
+    if (a >= SIZE || b->offset) return NULL;
+    *base = 0; *len = SIZE;
+    return b->ram;
+}
+static uint64_t wait_bus(void *ctx, enum mem_access access, uint32_t a,
+                         unsigned size, uint64_t now)
+{
+    struct bus *b = ctx;
+    b->waits++;
+    return (a ^ size ^ access ^ now) & 3;
+}
+static uint64_t fetch_wait(void *ctx, uint32_t a, uint64_t now)
+{
+    struct bus *b = ctx;
+    b->fetches++;
+    if (b->replace) {
+        /* A DMA-like store performed by the timing callback before fetch. */
+        write_bus(b, a, 2, 0x6010); /* add r0,1 */
+        b->replace = false;
+    }
+    return (now ^ a) & 3;
+}
+static void setup(struct c33 *c, struct bus *b, struct c33_blocks *cache)
+{
+    memset(c, 0, sizeof *c);
+    c->blocks = cache;
+    c->bus = (struct c33_bus){.read=read_bus, .write=write_bus,
+        .region=region, .wait=wait_bus, .fetch_wait=fetch_wait,
+        .fetch_wait_ctx=b, .ctx=b};
+    c->region_epoch = &b->epoch;
+    c33_reset(c, 0x100);
+    c->sr[SR_SP] = 0xe00;
+    c->sr[SR_TTBR] = 0x400;
+    c->sr[SR_DBBR] = 0x500;
+    c->sp_initialized = true;
+}
+static unsigned checks;
+static void step_pair(struct c33 *a, struct c33 *b,
+                      struct bus *ab, struct bus *bb)
+{
+    bool restart = wremu_fetch_restart;
+    c33_step(a);
+    bool a_restart = wremu_fetch_restart;
+    wremu_fetch_restart = restart;
+    c33_step(b);
+    if (a_restart != wremu_fetch_restart) abort();
+    struct c33 ac = *a, bc = *b;
+    ac.fetch_ptr = bc.fetch_ptr = NULL;
+    ac.data_ptr = bc.data_ptr = NULL;
+    if (memcmp(&ac, &bc, offsetof(struct c33, reset_barrier__)) ||
+        memcmp(ab, bb, sizeof *ab)) {
+        fprintf(stderr, "block differential check %u failed at %08x/%08x\n",
+                checks, a->cur_pc, b->cur_pc);
+        exit(1);
+    }
+    checks++;
+}
+int main(void)
+{
+    struct c33 a, b;
+    struct bus ab = {0}, bb = {0};
+    struct c33_blocks *cache = calloc(1, sizeof *cache);
+    if (!cache) return 1;
+    /* Every word, with no prefix, one/two prefixes, and a delay slot.
+     * Keep the cache populated between words to exercise replacement. */
+    for (unsigned mode = 0; mode < 4; mode++) {
+        memset(cache, 0, sizeof *cache);
+        for (unsigned word = 0; word < 65536; word++) {
+            memset(&ab, 0, sizeof ab);
+            for (unsigned i = 0; i < 64; i++)
+                write_bus(&ab, 0x400 + i * 4, 4, 0x180);
+            write_bus(&ab, 0x100, 2, word);
+            bb = ab;
+            setup(&a, &ab, NULL);
+            /* Preserve decode state instead of resetting it here. */
+            setup(&b, &bb, NULL); b.blocks = cache;
+            for (unsigned i = 0; i < 16; i++)
+                a.r[i] = b.r[i] = 0x600 + i * 4;
+            a.sr[SR_PSR] = b.sr[SR_PSR] = word & 15;
+            a.profile = b.profile = true;
+            model.call_extra = (word / 257) & 7;
+            model.branch_taken = 3 + ((word / 127) & 3);
+            model.branch_taken_iram = 2 + ((word / 63) & 3);
+            a.n_ext = b.n_ext = mode < 3 ? mode : 0;
+            a.ext[0] = b.ext[0] = 0x123;
+            a.ext[1] = b.ext[1] = 0x456;
+            a.delay_pending = b.delay_pending = mode == 3;
+            a.delay_target = b.delay_target = 0x200;
+            wremu_fetch_restart = false;
+            step_pair(&a, &b, &ab, &bb);
+        }
+    }
+    /* Run actual sequences through cached blocks, including code replacement,
+     * mapping changes, prefix IRQ deferral, and delayed branches. */
+    memset(&ab, 0, sizeof ab);
+    const uint16_t code[] = {0xc001,0x6010,0x2210,0x1902,0x6011,0x0000,0x18fa};
+    for (unsigned i = 0; i < sizeof code / sizeof *code; i++)
+        write_bus(&ab, 0x100 + i * 2, 2, code[i]);
+    for (unsigned i = 0; i < 64; i++) write_bus(&ab, 0x400+i*4, 4, 0x100);
+    bb = ab;
+    setup(&a, &ab, NULL); setup(&b, &bb, cache);
+    for (unsigned i = 0; i < 32768; i++) {
+        if (!(i & 63)) {
+            a.pc = b.pc = 0x100;
+            a.sleeping = b.sleeping = false;
+            a.halted = b.halted = false;
+            a.n_ext = b.n_ext = 0;
+            a.delay_pending = b.delay_pending = false;
+        }
+        if (!(i & 127)) ab.replace = bb.replace = true;
+        if (!(i & 255)) {
+            ab.offset = bb.offset = ab.offset ? 0 : 32;
+            ab.epoch++; bb.epoch++;
+        }
+        if (!(i & 511)) {
+            c33_raise_irq(&a, 19, 7); c33_raise_irq(&b, 19, 7);
+            a.sr[SR_PSR] |= PSR_IE; b.sr[SR_PSR] |= PSR_IE;
+        }
+        step_pair(&a, &b, &ab, &bb);
+    }
+    c33_reset(&b, 0x100);
+    if (b.blocks != cache || cache->current || cache->slot[0].count) abort();
+    free(cache);
+    printf("C33 decoded blocks: %u differential instruction checks passed\n", checks);
+    return 0;
+}
