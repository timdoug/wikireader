+static struct c33_decoded decode_word(uint16_t insn)
+{
+	unsigned form = c33_form_of[insn];
+	const struct c33_form *f = &c33_forms[form];
+	return (struct c33_decoded){
+		.a = f->nfields > 0 ? fld(insn, &f->f[0]) : 0,
+		.b = f->nfields > 1 ? fld(insn, &f->f[1]) : 0,
+		.insn = insn, .form = form,
+		.op = pe_encoding_valid(insn) ? f->op : OP_INVALID,
+	};
+}
+
+static bool block_end(const struct c33_decoded *d)
+{
+	switch (d->op) {
+	case OP_EXT: case OP_NOP: case OP_ADD: case OP_SUB: case OP_CMP:
+	case OP_ADC: case OP_SBC: case OP_AND: case OP_OR: case OP_XOR:
+	case OP_NOT: case OP_SLL: case OP_SRL: case OP_SRA:
+	case OP_MLT_H: case OP_MLTU_H: case OP_MLT_W: case OP_MLTU_W:
+	case OP_LD_B: case OP_LD_UB: case OP_LD_H: case OP_LD_UH:
+		return false;
+	case OP_LD_W:
+		return c33_forms[d->form].sreg != 0;
+	default:
+		/* Conservative: control transfers and uncommon forms end a block. */
+		return true;
+	}
+}
+
+static __attribute__((noinline)) struct c33_block *fill_block(struct c33 *c,
+							    uint32_t at)
+{
+	struct c33_block *b = &c->blocks->slot[(at >> 1) & (C33_BLOCK_SLOTS - 1)];
+	if (b->count && b->pc == at)
+		return b;
+	b->pc = at;
+	b->count = 0;
+	/* Decode only directly mapped RAM. No speculative MMIO or bus timing. */
+	for (unsigned i = 0; i < C33_BLOCK_INSNS; i++) {
+		uint32_t pc = at + i * 2;
+		if (pc < at || pc < c->fetch_lo || pc >= c->fetch_hi ||
+		    c->fetch_hi - pc < 2)
+			break;
+		uint16_t word;
+		memcpy(&word, c->fetch_ptr + (pc - c->fetch_lo), 2);
+		b->insn[i] = decode_word(word);
+		b->count++;
+		if (block_end(&b->insn[i]))
+			break;
+	}
+	return b;
+}
+
+static const struct c33_decoded *block_decode(struct c33 *c, uint32_t at,
+					    uint16_t insn)
+{
+	struct c33_blocks *cache = c->blocks;
+	struct c33_block *b = cache->current;
+	unsigned i = cache->next_index;
+	if (!b || at != cache->next_pc || i >= b->count) {
+		b = fill_block(c, at);
+		cache->current = b;
+		i = 0;
+	}
+	if (!b->count)
+		return NULL;
+	/* Validate the fetched word, even mid-block: DMA and guest stores may
+	 * replace code at any boundary. Re-decode this word without skipping
+	 * its timing; later words receive the same check before execution. */
+	if (b->insn[i].insn != insn)
+		b->insn[i] = decode_word(insn);
+	cache->next_pc = at + 2;
+	cache->next_index = i + 1;
+	return &b->insn[i];
+}
