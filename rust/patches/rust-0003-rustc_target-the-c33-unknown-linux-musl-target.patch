+++ b/compiler/rustc_target/src/spec/targets/c33_unknown_linux_musl.rs
@@ -0,0 +1,47 @@
+use crate::spec::{
+    Arch, Cc, Env, LinkerFlavor, Lld, RelocModel, RelroLevel, Target, TargetMetadata,
+    TargetOptions, base, cvs,
+};
+
+/// The Seiko Epson C33 (the WikiReader's S1C33E07) under no-MMU Linux with musl.  Programs are
+/// FDPIC ELF with a shared text segment (`-msep-data`), statically linked unless
+/// `-Ctarget-feature=-crt-static`.  LLVM has no C33 back end: code is generated by
+/// rustc_codegen_gcc, and this target selects it.
+pub(crate) fn target() -> Target {
+    let mut base = base::linux::opts();
+    base.env = Env::Musl;
+    base.cpu = "generic".into();
+    base.default_codegen_backend = Some("gcc".into());
+    // The C33 GCC's Linux driver defaults (DRIVER_SELF_SPECS): libgccjit compiles in process
+    // and sees only the options it is given.
+    base.llvm_args = cvs!["-mcore=c33pe", "-mfdpic", "-msep-data"];
+    base.linker = Some("c33-linux-musl-gcc".into());
+    base.linker_flavor = LinkerFlavor::Gnu(Cc::Yes, Lld::No);
+    // Last: GCC calls libgcc helpers, such as `__ucmpdi2`, that compiler_builtins does not have.
+    base.late_link_args = TargetOptions::link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-lgcc"]);
+    base.dynamic_linking = false;
+    base.crt_static_default = true;
+    base.position_independent_executables = false;
+    base.static_position_independent_executables = false;
+    base.relro_level = RelroLevel::None;
+    base.has_rpath = false;
+    base.relocation_model = RelocModel::Static;
+    base.disable_redzone = true;
+    base.max_atomic_width = Some(32);
+    base.has_thread_local = false;
+    base.emit_debug_gdb_scripts = false;
+
+    Target {
+        llvm_target: "c33-linux-musl".into(),
+        metadata: TargetMetadata {
+            description: Some("Seiko Epson C33 no-MMU Linux with musl".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 32,
+        data_layout: "e-m:e-p:32:32-i64:32-f64:32-i128:32-n32-S128".into(),
+        arch: Arch::C33,
+        options: base,
+    }
+}
