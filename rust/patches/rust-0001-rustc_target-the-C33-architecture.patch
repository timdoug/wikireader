diff --git a/compiler/rustc_target/src/callconv/c33.rs b/compiler/rustc_target/src/callconv/c33.rs
new file mode 100644
index 000000000..0643ada69
--- /dev/null
+++ b/compiler/rustc_target/src/callconv/c33.rs
@@ -0,0 +1,80 @@
+// Reference: the Seiko Epson C33 GCC port's calling convention, which follows
+// Epson's original C33 compiler (gcc 3.3.2): c33_function_arg,
+// c33_function_arg_advance and c33_return_in_memory in config/c33/c33.cc.
+//
+// An aggregate is in registers exactly when GCC gives it a scalar mode: its
+// size is 1, 2, 4 or 8 bytes and, the target being STRICT_ALIGNMENT, its
+// alignment is at least that mode's (BIGGEST_ALIGNMENT is 32 bits, so 8-byte
+// records need only 4).  Any other aggregate is BLKmode: returned through a
+// hidden pointer in %r6, and passed by value on the stack without taking an
+// argument register.
+
+use rustc_abi::{HasDataLayout, Size, TyAbiInterface};
+
+use crate::callconv::{ArgAbi, FnAbi, Reg, Uniform};
+
+/// The registers an aggregate of this layout travels in, if GCC gives it a
+/// scalar mode.
+fn scalar_mode_unit<Ty>(arg: &ArgAbi<'_, Ty>) -> Option<Uniform> {
+    let size = arg.layout.size;
+    let align = arg.layout.align.abi.bytes();
+    match size.bytes() {
+        1 => Some(Uniform::new(Reg::i8(), size)),
+        2 if align >= 2 => Some(Uniform::new(Reg::i16(), size)),
+        4 if align >= 4 => Some(Uniform::new(Reg::i32(), size)),
+        8 if align >= 4 => Some(Uniform::new(Reg::i32(), Size::from_bytes(8))),
+        _ => None,
+    }
+}
+
+fn classify_ret<Ty>(ret: &mut ArgAbi<'_, Ty>) {
+    if !ret.layout.is_sized() {
+        return;
+    }
+    if ret.layout.is_aggregate() {
+        match scalar_mode_unit(ret) {
+            Some(unit) => ret.cast_to(unit),
+            None => ret.make_indirect(),
+        }
+    } else {
+        ret.extend_integer_width_to(32);
+    }
+}
+
+fn classify_arg<'a, Ty, C>(cx: &C, arg: &mut ArgAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout,
+{
+    if !arg.layout.is_sized() {
+        return;
+    }
+    if arg.layout.pass_indirectly_in_non_rustic_abis(cx) {
+        arg.make_indirect();
+        return;
+    }
+    if arg.layout.is_aggregate() {
+        match scalar_mode_unit(arg) {
+            Some(unit) => arg.cast_to(unit),
+            None => arg.pass_by_stack_offset(None),
+        }
+    } else {
+        arg.extend_integer_width_to(32);
+    }
+}
+
+pub(crate) fn compute_abi_info<'a, Ty, C>(cx: &C, fn_abi: &mut FnAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout,
+{
+    if !fn_abi.ret.is_ignore() {
+        classify_ret(&mut fn_abi.ret);
+    }
+    for arg in fn_abi.args.iter_mut() {
+        if arg.is_ignore() {
+            continue;
+        }
+        classify_arg(cx, arg);
+    }
+}
