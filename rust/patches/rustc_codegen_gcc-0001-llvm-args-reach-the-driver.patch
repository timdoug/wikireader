diff --git a/src/gcc_util.rs b/src/gcc_util.rs
index b0442cdf..8ab902bc 100644
--- a/src/gcc_util.rs
+++ b/src/gcc_util.rs
@@ -278,8 +278,11 @@ pub fn new_context<'gcc>(sess: &Session) -> Context<'gcc> {
 
     add_feature_options(&context, &sess.target.arch, &sess.global_backend_features);
 
+    // NOTE: the driver gets them as well, so that a flag selecting a core variant
